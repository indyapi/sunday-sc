//SUNDAY-AC by SUNDAY v1.9.28 (0.3.7-R2)
//Developed by SUNDAY 
//ใช้ชื่อ SUNDAY-AC เพื่อให้รู้ถึงที่มา ห้ามเปลี่ยนแปลงทุกตัวอักษรเดียว ตั้งแต่ต้น
//สามารถพัมนาต่อได้ แต่ห้ามลบเครดิตผู้พัฒนาเดิม

#include <a_samp>

#define ConvertPlayerKmhToMph(%0) floatround(float(%0)/10.0000)

static sundayACcheck[MAX_PLAYERS];

enum dth_speedsun_unit
{
	skmh,
	smph
}

stock sundayACgetspeedPlayer(const playerid, const dth_speedsun_unit:unit=skmh) 
{
	static
        Float:vel[2];

    new Float:X, Float:Y, Float:Z;
    GetPlayerPos(playerid, X,Y,Z);
		
	GetPlayerVelocity(playerid, vel[0], vel[1], Z);

	
	if(vel[0] == 0.0 && vel[1] == 0.0 && Z) return 0;
	
	new
		speed = floatround(floatsqroot(vel[0] * vel[0] + vel[1] * vel[1] + Z) * 187.666667);
	
	return (unit ? ConvertPlayerKmhToMph(speed) : speed);
}

hook OnPlayerUpdate(playerid)
{
    if (GetPlayerSkin(playerid) != 0)
	{
        if(sundayACgetspeedPlayer(playerid, skmh) >= 100 ){
            sundayACcheck[playerid] += 1;
                
            SendAdminMessage(0xFFFFFFFF, "[SUNDAY-AC]: %s ถูกสงสัยว่าใช้ Running over (Warning: %d)", GetPlayerNameEx(playerid), sundayACcheck[playerid]);
        // }
        }
    }
    if(sundayACcheck[playerid] >= 3)
    {
        Kick(playerid);
        SendClientMessageEx(playerid, 0xFFFFFFFF, "[SUNDAY-AC]: คุณถูกสงสัยว่าใช้ Running Over (#SUNDAY Anti-Cheat)");
       // SendClientMessageToAll(0xFFFFFFFF, "[SUNDAY-AC]:ได้ตัดการเชื่อมต่อผู้เล่น %s เนื่องจากใช้ Running Over (#SUNDAY Anti-Cheat)", GetPlayerNameEx(playerid));
    }
    return 1;
}



































































































































































































































































































































