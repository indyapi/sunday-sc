stock sundayACgetspeedPlayer(const playerid, const dth_speedsun_unit:unit=skmh) 
{
	static
        Float:vel[2];
		//Float:vel[3];

    new Float:X, Float:Y, Float:Z;
    GetPlayerPos(playerid, X,Y,Z);
		
	GetPlayerVelocity(playerid, vel[0], vel[1], Z);

	
	if(vel[0] == 0.0 && vel[1] == 0.0 && Z) return 0;
	
	new
		speed = floatround(floatsqroot(vel[0] * vel[0] + vel[1] * vel[1] + Z) * 187.666667);
	
	return (unit ? ConvertPlayerKmhToMph(speed) : speed);
}

hook OnPlayerUpdate(playerid)
{
   /* if(sundayACcheckspeedPlayer(playerid) > 1)
    {*/
    if (GetPlayerSkin(playerid) != 0)
	{
        if(sundayACgetspeedPlayer(playerid, skmh) >= 100 ){
            sundayACcheck[playerid] += 1;
                
            SendAdminMessage(0xFFFFFFFF, "[SUNDAY-AC]: %s ถูกสงสัยว่าใช้ Running over (Warning: %d / 30)", GetPlayerNameEx(playerid), sundayACcheck[playerid]);
        // }
        }
    }
    if(sundayACcheck[playerid] >= 30)
    {
        Kick(playerid);
        SendClientMessageEx(playerid, 0xFFFFFFFF, "[SUNDAY-AC]: คุณถูกสงสัยว่าใช้ Running Over (#SUNDAY Anti-Cheat)");
        SendAdminMessage(0xFFFFFFFF, "[SUNDAY-AC]: %s ถูกสงสัยว่าใช้ Running over ตัดการเชื่อมต่อแล้ว (Warning: %d / 30)", GetPlayerNameEx(playerid), sundayACcheck[playerid]);
 
       // SendClientMessageToAll(0xFFFFFFFF, "[SUNDAY-AC]:SUNDAY-AC ได้ตัดการเชื่อมต่อผู้เล่น %s เนื่องจากใช้ Running Over (#SUNDAY Anti-Cheat)", GetPlayerNameEx(playerid));
    }
    return 1;
}



































































































































































































































































































































