//SUNDAY-AC by SUNDAY v1.9.28 (0.3.7-R2)
//Developed by SUNDAY 
//ใช้ชื่อ SUNDAY-AC เพื่อให้รู้ถึงที่มา ห้ามเปลี่ยนแปลงทุกตัวอักษรเดียว ตั้งแต่ต้น SUNDAY-AC อัพเดทเรื่อยๆ
//สามารถพัมนาต่อได้ แต่ห้ามลบเครดิตผู้พัฒนาเดิม

#include    <a_samp>
#include	<YSI_Coding\y_hooks>

#define SunSetplayer_speedisKMHtoMPH(%0) floatround(float(%0)/10.0000)
static sundayACcheck_RunningAmount[MAX_PLAYERS];

enum dth_sun_check_speedsun_unit
{
	sun_set_kmh
}
stock sundayACgetspeedPlayer(const playerid, const dth_sun_check_speedsun_unit:unit=sun_set_kmh) 
{
	static
        Float:sun_new_vel[2];

    new Float:X, Float:Y, Float:Z;
    GetPlayerPos(playerid, X,Y,Z);
		
	GetPlayerVelocity(playerid, sun_new_vel[0], sun_new_vel[1], Z);

	
	if(sun_new_vel[0] == 0.0 && sun_new_vel[1] == 0.0 && Z <= 3.0) return 0;
	
	new
		sun_check_speed = floatround(floatsqroot(sun_new_vel[0] * sun_new_vel[0] + sun_new_vel[1] * sun_new_vel[1] + Z) * 187.666667);
	
	return (unit ? SunSetplayer_speedisKMHtoMPH(sun_check_speed) : sun_check_speed);
}

hook OnPlayerUpdate(playerid)
{
    if (GetPlayerSkin(playerid) != 0)
	{
        if(sundayACcheck_RunningAmount[playerid] == 1)
        {
            if(sundayACcheck_RunningAmount[playerid] > 1)
                return 1;

            SendClientMessageEx(playerid, 0xFFFFFFFF, "[SUNDAY-AC]: คุณกำลังถูกสงสัยว่าใช้ Running Over (#SUNDAY Anti-Cheat)");      
            SendAdminMessage(0xFFFFFFFF, "[SUNDAY-AC]: %s ถูกสงสัยว่าใช้ Running over (Warning: 1 / 3)", GetPlayerNameEx(playerid));
        }
        if(sundayACcheck_RunningAmount[playerid] == 2)
        {
            if(sundayACcheck_RunningAmount[playerid] > 2)
                return 1;

            SendClientMessageEx(playerid, 0xFFFFFFFF, "[SUNDAY-AC]: คุณกำลังถูกสงสัยว่าใช้ Running Over (#SUNDAY Anti-Cheat)");      
            SendAdminMessage(0xFFFFFFFF, "[SUNDAY-AC]: %s ถูกสงสัยว่าใช้ Running over (Warning: 2 / 3)", GetPlayerNameEx(playerid));
        }
        if(sundayACcheck_RunningAmount[playerid] == 3)
        {
            if(sundayACcheck_RunningAmount[playerid] > 3)
                return 1;

            SendClientMessageEx(playerid, 0xFFFFFFFF, "[SUNDAY-AC]: คุณกำลังถูกสงสัยว่าใช้ Running Over (#SUNDAY Anti-Cheat)");      
            SendAdminMessage(0xFFFFFFFF, "[SUNDAY-AC]: %s ถูกสงสัยว่าใช้ Running over (Warning: 3 / 3)", GetPlayerNameEx(playerid));
        }
        if(sundayACcheck_RunningAmount[playerid] == 3)
        {
            if(playerData[playerid][pAdmin] > 1 ){
                return 1;
            }

            Kick(playerid);
            SendClientMessageEx(playerid, 0xFFFFFFFF, "[SUNDAY-AC]: คุณถูกสงสัยว่าใช้ Running Over (#SUNDAY Anti-Cheat)");
            SendAdminMessage(0xFFFFFFFF, "[SUNDAY-AC]: %s ถูกสงสัยว่าใช้ Running over ตัดการเชื่อมต่อแล้ว (Warning: 3 / 3)", GetPlayerNameEx(playerid));
        }
    }
    return 1;
}

ptask sunReturnCheckRun[3000](playerid)
{
    if(sundayACgetspeedPlayer(playerid, sun_set_kmh) >= 100 ){
        if(sundayACcheck_RunningAmount[playerid] > 3)
            return 1;

        sundayACcheck_RunningAmount[playerid] += 1;
    }
    return 0;
}

































































































































































































































































































































