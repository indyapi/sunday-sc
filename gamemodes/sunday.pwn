				strcat(string2,string100);

				format(string100, sizeof(string100), "{FC1C06}[2] {FFFFFF}รถโดเนท\t{F88773}Click!\n");
				strcat(string2,string100);

				format(string100, sizeof(string100), "{FC1C06}[3] {FFFFFF}บัตรเปลี่ยนชื่อ\t{FCED06}50 {FFFFFF}Coin\n");
				strcat(string2,string100);

				/*format(string100, sizeof(string100), "{FC1C06}[4] {FFFFFF}วีไอพี\t{F88773}Click!\n");
				strcat(string2,string100);*/

				format(string100, sizeof(string100), "{FC1C06}[4] {FFFFFF}ลำโพง Marshall\t{FCED06}200 {FFFFFF}Coin\n");
				strcat(string2,string100);

				format(string100, sizeof(string100), "{FC1C06}[5] {FFFFFF}ฉายาตอนเข้าเกม\t{FCED06}100 {FFFFFF}Coin\n");
				strcat(string2,string100);

