CMD:int(playerid, params[])
{
	if (playerData[playerid][pDevMode] < 1)
	    return SendClientMessage(playerid, COLOR_GREY, "คุณไม่ใช่ผู้ดูแลระบบ");

	new typeint;

	if (sscanf(params, "d", typeint))
		return SendClientMessageEx(playerid, COLOR_GREY, "การใช้งาน : {FFFFFF}/int [1-%d]", sizeof(arrHouseInteriors));

	if (typeint < 1 || typeint > sizeof(arrHouseInteriors))
		return SendClientMessageEx(playerid, COLOR_GREY, "ประเภทที่ระบุต้องไม่ต่ำกว่า 1 ถึง %d", sizeof(arrHouseInteriors));

	typeint--;

	SetPlayerPos(playerid, arrHouseInteriors[typeint][eHouseX], arrHouseInteriors[typeint][eHouseY], arrHouseInteriors[typeint][eHouseZ]);
	SetPlayerFacingAngle(playerid, arrHouseInteriors[typeint][eHouseAngle]);

	SetPlayerInterior(playerid, arrHouseInteriors[typeint][eHouseInterior]);

	return 1;
}


alias:jetpack("เจต")
CMD:jetpack(playerid, params[])
{
	if (playerData[playerid][pAdmin] < 1)
	    return SendClientMessage(playerid, COLOR_LIGHTRED, "คุณไม่ได้รับอนุญาตให้ใช้คำสั่งนี้");

	SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USEJETPACK);
	SendClientMessage(playerid, COLOR_YELLOW, "คุณได้เสก Jetpack ออกมาใช้งาน");

	return 1;
}
