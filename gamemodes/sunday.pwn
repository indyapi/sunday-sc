	mysql_tquery(g_SQL, gString);
	return 1;
}


public OnPlayerStateChange(playerid, newstate, oldstate)
{
	new vehicleid = GetPlayerVehicleID(playerid);

	pvehicleid[playerid] = GetPlayerVehicleID(playerid);
	pmodelid[playerid] = GetVehicleModel(pvehicleid[playerid]);
	
    if (newstate == PLAYER_STATE_WASTED)
    {
		if (OpenWarSF == 1)
		{
		    if (playerData[playerid][pFaction] == -1)
		    {
				playerData[playerid][pInjured] = 0;
				playerData[playerid][pInjuredTime] = 0;

		        playerData[playerid][pSpawnPoint] = 0;
		        SpawnPlayer(playerid);
		    }
		    else
		    {
				playerData[playerid][pInjured] = 0;
				playerData[playerid][pInjuredTime] = 0;

		        playerData[playerid][pSpawnPoint] = 1;
		        SpawnPlayer(playerid);
		    }
		    SendClientMessage(playerid, COLOR_YELLOW, "[ เนื่องจากการวอร์ SF เปิดอยู่ทำให้ตายแล้วจะถูกส่งกลับจุดเกิด! ]");
			return 1;
		}
