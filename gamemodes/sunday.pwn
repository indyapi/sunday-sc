alias:Private("pv")
CMD:Private(playerid, params[])
{
	if (playerData[playerid][pPrisoned] > 0)
		return SendClientMessageEx(playerid, COLOR_RED, "[ ERROR! ] {FFFFFF} ติดคุกอยู่...");

	if (playerData[playerid][pInjured] > 0)
		return SendClientMessageEx(playerid, COLOR_RED, "[ ERROR! ] {FFFFFF} บาดเจ็บอยู่...");

	if (playerData[playerid][pOOCSpam] > 0)
		return SendClientMessageEx(playerid, COLOR_RED, "[ ! ] {FFFFFF}ป้องกันการ Spam ข้อความ คุณเหลือเวลาอีก %d วินาที ในการใช้คำสั่งใหม่อีกครั้ง", playerData[playerid][pOOCSpam]);


	SendClientMessageToAllEx(COLOR_ORANGE , "{1E90FF}[PRIVATE]{FFFFFF} - {1E90FF}User รายหนึ่ง:{FFFFFF} %s ", params);

	playerData[playerid][pOOCSpam] = 10;
	return 1;
}

alias:gangchat("gc")
CMD:gangchat(playerid, params[])
{
	if (playerData[playerid][pPrisoned] > 0)
		return SendClientMessageEx(playerid, COLOR_RED, "[ ERROR! ] {FFFFFF} ติดคุกอยู่...");

	if (playerData[playerid][pInjured] > 0)
		return SendClientMessageEx(playerid, COLOR_RED, "[ ERROR! ] {FFFFFF} บาดเจ็บอยู่...");

	if (playerData[playerid][pOOCSpam] > 0)
		return SendClientMessageEx(playerid, COLOR_RED, "[ ! ] {FFFFFF}ป้องกันการ Spam ข้อความ คุณเหลือเวลาอีก %d วินาที ในการใช้คำสั่งใหม่อีกครั้ง", playerData[playerid][pOOCSpam]);


	SendClientMessageToAllEx(COLOR_ORANGE , "{1E90FF}[GROUP - %s]{FFFFFF}%s{1E90FF}:{FFFFFF} %s ", playerData[playerid][pFaction], GetPlayerNameEx(playerid),params);

	playerData[playerid][pOOCSpam] = 10;
	return 1;
}

