alias:siren("ไซเรน")
CMD:siren(playerid, params[])
{
	if (GetFactionType(playerid) != FACTION_POLICE && GetFactionType(playerid) != FACTION_MEDIC && GetFactionType(playerid) != FACTION_CHEF && GetFactionType(playerid) != FACTION_MEC)
	    return SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}ช่องทางนี้สำหรับรัฐบาลเท่านั้น!");

	new vehicleid = GetPlayerVehicleID(playerid);

	if (!IsPlayerInAnyVehicle(playerid))
	    return SendClientMessage(playerid, COLOR_RED, "คุณต้องอยู่ในยานพาหนะ");

	switch (vehSirenOn[vehicleid])
	{
	    case 0:
	    {
			new
        		Float:fSize[3],
        		Float:fSeat[3];

		    GetVehicleModelInfo(GetVehicleModel(vehicleid), VEHICLE_MODEL_INFO_SIZE, fSize[0], fSize[1], fSize[2]); // need height (z)
    		GetVehicleModelInfo(GetVehicleModel(vehicleid), VEHICLE_MODEL_INFO_FRONTSEAT, fSeat[0], fSeat[1], fSeat[2]); // need pos (x, y)

            vehSirenOn[vehicleid] = 1;
			vehicleSiren[vehicleid] = CreateDynamicObject(19620, 0.0, 0.0, 1000.0, 0.0, 0.0, 0.0);

			StopAudioStreamForPlayer(playerid);
			PlayAudioStreamForPlayer(playerid, "https://sll.ijjiii.is/dcc881fc2fff707f23fecf79e1d1dafa/qDQnFYo8eug/muzeiazciczcns");

		    AttachDynamicObjectToVehicle(vehicleSiren[vehicleid], vehicleid, -fSeat[0]+0.5, fSeat[1]-0.4, fSize[2] / 2.0, 0.0, 0.0, 0.0);
			SendNearbyMessage(playerid, 30.0, COLOR_PURPLE, "** %s ติดไซเรนแบบพกพาให้กับยานพาหนะ", GetPlayerNameEx(playerid));
		}
		case 1:
		{
		    vehSirenOn[vehicleid] = 0;
		    StopAudioStreamForPlayer(playerid);

			DestroyDynamicObject(vehicleSiren[vehicleid]);
			SendNearbyMessage(playerid, 30.0, COLOR_PURPLE, "** %s ถอดไซเรนแบบพกพาจากยานพาหนะ", GetPlayerNameEx(playerid));
		}
	}
	return 1;
}

alias:tod("ปรับเวลา")
CMD:tod(playerid, params[])
{
	new time, msg[256];
	if(playerData[playerid][pAdmin] < 3) return SendClientMessage(playerid, COLOR_GREY, "   คุณไม่ได้รับอนุญาตให้ใช้คำสั่งนี้");
	if(sscanf(params, "d", time)) return SendClientMessage(playerid, COLOR_GREY, "การใช้งาน : /ปรับเวลา [time] (0-23)");
	SetWorldTime(time);
	format(msg, sizeof(msg), "เวลา : นาฬิกาเซิร์ฟเวอร์ถูกเปลี่ยนเป็น %d:00", time);
	SendClientMessageToAll(COLOR_ORANGE, msg);
	return 1;
}

alias:weatherall("ปรับอากาศ", "weather")
CMD:weatherall(playerid, params[])
{
	new weather;
	if(playerData[playerid][pAdmin] < 3) return SendClientMessage(playerid, COLOR_GREY, "   คุณไม่ได้รับอนุญาตให้ใช้คำสั่งนี้");
	if(sscanf(params, "d", weather)) return SendClientMessage(playerid, COLOR_GREY, "การใช้งาน : /ปรับอากาศ [weatherid]");
	if(weather < 0||weather > 45) { SendClientMessage(playerid, COLOR_GREY, "   Weather ID can't be below 0 or above 45!"); return 1; }
	SetWeather(weather);
	SendClientMessage(playerid, COLOR_GREY, "สภาพอากาศถูกเปลี่ยนให้กับทุกคน!");
	return 1;
}

task SyncUpTimer[60000]() {

	if(settime2 == 0)
	{
        new tmphour, tmpminute, tmpsecond;
	    gettime(tmphour, tmpminute, tmpsecond);
	    FixHour(tmphour);
	    tmphour = shifthour;

	    if ((tmphour > ghour) || (tmphour == 0 && ghour == 23))
	    {
	    	new server_time[256];
	        format(server_time, sizeof(server_time), "เวลา : นาฬิกาเซิร์ฟเวอร์ถูกเปลี่ยนเป็น %d.00",tmphour);
	    	SendClientMessageToAll(COLOR_ORANGE, server_time);

	    	ghour = tmphour;
    		SetWorldTime(tmphour);
		}
	}
}

forward FixHour(hour);
public FixHour(hour)
{
	hour = timeshift+hour;
	if (hour < 0) hour = hour+24;
	else if (hour > 23) hour = hour-24;
	shifthour = hour;
	return 1;
}

