stock CopOnline()
{
	new cop;
	foreach(new x: Player)
	{
		if(IsPlayerConnected(x) && GetFactionType(x) == FACTION_POLICE && playerData[x][pOnDuty] == true)
		{
			if(incase[x] == 1){
				cop++;
			}
		}
	}
	return cop;
}

