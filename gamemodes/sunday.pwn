public OnPlayerVehicleDamage(playerid,vehicleid,Float:Damage)
{
	new Float:fX, Float:fY, Float:fZ, Float:healthVehicle;

	if(IsPlayerNPC(playerid)) return 1;

	GetVehiclePos(vehicleid, fX, fY, fZ);
	GetVehicleHealth(vehicleid, healthVehicle);

	if (healthVehicle < 350.0)
	{
		/*foreach (new x : Player)
		{
			if(GetFactionType(x) == FACTION_MEC)
			{
				SendClientMessage(x, COLOR_ORANGE, "Dispatch : มีรถเสียหายหนักและต้องการช่างซ่อมรถด่วน!");
				SendClientMessage(x, COLOR_ORANGE, "Dispatch : ตำแหน่ง Checkpoint ถูกแสดงขึ้นบนแผนที่แล้ว");

				SetPlayerCheckpoint(x, fX, fY, fZ, 7.0);
				MechanicCP[x] = 1;
			}
			else
			{
				MechanicCP[x] = 0;
				DisablePlayerCheckpoint(x);
			}
		}*/
		SetVehicleHealth(vehicleid, 350.0);
		SetEngineStatus(vehicleid, false);
  	}
    return 1;
}

