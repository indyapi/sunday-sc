forward SpeedoTimer(playerid, vehicleid);
public SpeedoTimer(playerid, vehicleid)
{
	if(vehicleid != GetPlayerVehicleID(playerid))
	{
		KillTimer(playerData[playerid][pSpeedoTimer]);
		return 0;
	}
	new Float:returnspeed = GetVehicleSpeed(vehicleid), Float:carhealth;
	new speed = floatround(returnspeed);
	new str[64];
	new Float:fuelveh = vehicleFuel[vehicleid];
	GetVehicleHealth(vehicleid, carhealth);

	/*switch(carhealth)
	{
		case 0..350: PlayerTextDrawSetString(playerid, sun_gearBAR[playerid], "~g~III");
		case 351..500: PlayerTextDrawSetString(playerid, sun_gearBAR[playerid], "~w~~h~IIII");
		case 501..550: PlayerTextDrawSetString(playerid, sun_gearBAR[playerid], "~w~~h~IIIII");
		case 551..600: PlayerTextDrawSetString(playerid, sun_gearBAR[playerid], "~w~~h~IIIIIII");
		case 601..650: PlayerTextDrawSetString(playerid, sun_gearBAR[playerid], "~w~~h~IIIIIIII");
		case 651..700: PlayerTextDrawSetString(playerid, sun_gearBAR[playerid], "~w~~h~IIIIIIIII");
		case 701..750: PlayerTextDrawSetString(playerid, sun_gearBAR[playerid], "~w~~h~IIIIIIIIII");
		case 751..800: PlayerTextDrawSetString(playerid, sun_gearBAR[playerid], "~w~~h~IIIIIIIIIII");
		case 801..850: PlayerTextDrawSetString(playerid, sun_gearBAR[playerid], "~w~~h~IIIIIIIIIIII");
		case 851..900: PlayerTextDrawSetString(playerid, sun_gearBAR[playerid], "~w~~h~IIIIIIIIIIIII");
		case 901..950: PlayerTextDrawSetString(playerid, sun_gearBAR[playerid], "~w~~h~IIIIIIIIIIIIII");
		case 951..1000: PlayerTextDrawSetString(playerid, sun_gearBAR[playerid], "~w~~h~IIIIIIIIIIIIII");
		default: PlayerTextDrawSetString(playerid, sun_gearBAR[playerid], "~r~~h~~h~IIIIIIIIIIIIII");
	}*/

 	format(str, sizeof(str), "%d", speed);
	PlayerTextDrawSetString(playerid, sun_speedTD[playerid], str);

	format(str, sizeof(str), "%.2f", fuelveh);
	PlayerTextDrawSetString(playerid, sun_fuelVEH[playerid], str);

	//SetPlayerProgressBarMaxValue(playerid, Speed_SUN_Bar[playerid][0], 300);
    //SetPlayerProgressBarValue(playerid, Speed_SUN_Bar[playerid][0], GetVehicleSpeed(vehicleid));

//	format(str, sizeof(str), "%d", vehicleFuel[vehicleid]);
//	PlayerTextDrawSetString(playerid, Speed_SUN[playerid][4], str);

    /*SetPlayerProgressBarMaxValue(playerid, sun_fuelVEH[playerid], 100);
    SetPlayerProgressBarValue(playerid, sun_fuelVEH[playerid], vehicleFuel[vehicleid]);*/

	if(carData[vehicleid][carLevel] == 0)
	{
		SetPlayerProgressBarMaxValue(playerid, sun_loadhpveh[playerid], 2000.0);
    	SetPlayerProgressBarValue(playerid, sun_loadhpveh[playerid], carhealth);
	}
	if(carData[vehicleid][carLevel] == 1)
	{
		SetPlayerProgressBarMaxValue(playerid, sun_loadhpveh[playerid], 3000.0);
    	SetPlayerProgressBarValue(playerid, sun_loadhpveh[playerid], carhealth);
	}
	if(carData[vehicleid][carLevel] == 2)
	{
		SetPlayerProgressBarMaxValue(playerid, sun_loadhpveh[playerid], 4000.0);
    	SetPlayerProgressBarValue(playerid, sun_loadhpveh[playerid], carhealth);
	}
	if(carData[vehicleid][carLevel] == 3)
	{
		SetPlayerProgressBarMaxValue(playerid, sun_loadhpveh[playerid], 5000.0);
    	SetPlayerProgressBarValue(playerid, sun_loadhpveh[playerid], carhealth);
	}

    new modelid = GetVehicleModel(vehicleid);
    
 	format(str, sizeof(str), "%s", ReturnVehicleModelName(modelid));
	PlayerTextDrawSetString(playerid, sun_nameVEH[playerid], str);

	new ModelVeh = GetVehicleModel(vehicleid);
 	PlayerTextDrawSetPreviewModel(playerid, sun_modelVEH[playerid], ModelVeh);

	switch(SpeedVehicle(playerid))
	{
		case 0..9: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~w~~h~I");
		case 10..14: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~w~~h~II");
		case 15..19: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~g~III");
		case 20..24: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~g~IIII");
		case 25..29: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~g~~h~IIIII");
		case 30..34: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~g~~h~IIIIII");
		case 35..39: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~g~~h~IIIIIII");
		case 40..44: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~g~~h~IIIIIIII");
		case 45..49: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~g~~h~~h~IIIIIIIII");
		case 50..59: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~g~~h~~h~IIIIIIIIII");
		case 60..64: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~g~~h~~h~IIIIIIIIIII");
		case 65..69: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~g~~h~~h~IIIIIIIIIIII");
		case 70..79: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~y~IIIIIIIIIIIII");
		case 80..89: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~y~IIIIIIIIIIIIII");
		case 90..99: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~y~~h~IIIIIIIIIIIIIII");
		case 100..109: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~y~~h~IIIIIIIIIIIIIIII");
		case 110..119: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~y~~h~IIIIIIIIIIIIIIIII");
		case 120..129: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~y~~h~IIIIIIIIIIIIIIIIII");
		case 130..139: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~y~~h~IIIIIIIIIIIIIIIIIII");
		case 140..149: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~y~~h~IIIIIIIIIIIIIIIIIIII");
		case 150..164: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~y~~h~IIIIIIIIIIIIIIIIIIIII");
		case 165..174: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~y~~h~IIIIIIIIIIIIIIIIIIIIII");
		case 175..189: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~r~IIIIIIIIIIIIIIIIIIIIIII");
		case 190..199: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~r~IIIIIIIIIIIIIIIIIIIIIIII");
		case 200..209: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~r~~h~IIIIIIIIIIIIIIIIIIIIIIIII");
		case 210..219: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~r~~h~IIIIIIIIIIIIIIIIIIIIIIIIII");
		case 220..229: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~r~~h~IIIIIIIIIIIIIIIIIIIIIIIIIII");
		case 230..239: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~r~~h~~h~IIIIIIIIIIIIIIIIIIIIIIIIIIII");
		case 240..249: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~r~~h~~h~IIIIIIIIIIIIIIIIIIIIIIIIIIIII");
		default: PlayerTextDrawSetString(playerid, sun_speedBAR[playerid], "~r~~h~~h~IIIIIIIIIIIIIIIIIIIIIIIIIIIII");
	}

    if(GetVehicleSpeed(vehicleid) == 0)
	{
		PlayerTextDrawSetString(playerid, sun_gearTD[playerid], "N");
	}
	if(GetVehicleSpeed(vehicleid) >= 1 && GetVehicleSpeed(vehicleid) <= 20)
	{
		PlayerTextDrawSetString(playerid, sun_gearTD[playerid], "1");
	}

	if(GetVehicleSpeed(vehicleid) >= 20 && GetVehicleSpeed(vehicleid) <= 50)
	{
		PlayerTextDrawSetString(playerid, sun_gearTD[playerid], "2");
	}

	if(GetVehicleSpeed(vehicleid) >= 50 && GetVehicleSpeed(vehicleid) <= 70)
	{
		PlayerTextDrawSetString(playerid, sun_gearTD[playerid], "3");
	}

	if(GetVehicleSpeed(vehicleid) >= 70 && GetVehicleSpeed(vehicleid) <= 120)
	{
		PlayerTextDrawSetString(playerid, sun_gearTD[playerid], "4");
	}

	if(GetVehicleSpeed(vehicleid) >= 120 && GetVehicleSpeed(vehicleid) <= 190)
	{
		PlayerTextDrawSetString(playerid, sun_gearTD[playerid], "5");
	}

	if(GetVehicleSpeed(vehicleid) >= 190 && GetVehicleSpeed(vehicleid) <= 240)
	{
		PlayerTextDrawSetString(playerid, sun_gearTD[playerid], "6");
	}
	if(GetVehicleSpeed(vehicleid) >= 240 && GetVehicleSpeed(vehicleid) <= 300)
	{
		PlayerTextDrawSetString(playerid, sun_gearTD[playerid], "7");
	}
	if(GetVehicleSpeed(vehicleid) > 300)
	{
		PlayerTextDrawSetString(playerid, sun_gearTD[playerid], "ER!");
		SendClientMessage(playerid, COLOR_RED, "ไอ่สวะ มึงแฮกความเร็วหรอ");
		DelayedKick(playerid);
	}

	return 1;
}

stock SpeedVehicle(playerid)
{
    new Float:ST[4];
    if(IsPlayerInAnyVehicle(playerid))
	GetVehicleVelocity(GetPlayerVehicleID(playerid),ST[0],ST[1],ST[2]);
	else GetPlayerVelocity(playerid,ST[0],ST[1],ST[2]);
    ST[3] = floatsqroot(floatpower(floatabs(ST[0]), 2.0) + floatpower(floatabs(ST[1]), 2.0) + floatpower(floatabs(ST[2]), 2.0)) * 253.3;
    return floatround(ST[3]);
}

ptask HungryTimerSecond[1000*20](playerid)
{
	new Float:hp;
	GetPlayerHealth(playerid, hp);

    if (playerData[playerid][pHungry] <= 0.0)
	{
	    SetPlayerHealth(playerid, hp-5.0);
	}
	
    if (playerData[playerid][pHungry] <= 0.0)
	{
        SetPlayerHealth(playerid, hp-5.0);
	}

	return 1;
}

ptask PlayerTimerPayday[60*1000](playerid)
{
	if (!playerData[playerid][IsLoggedIn]) return 0;

	playerData[playerid][pMinutes]++;
	if (playerData[playerid][pMinutes] >= 60)
	{
	    new morereward;
	    switch(playerData[playerid][pVip])
	    {
	        case 1: morereward = 350;
	        case 2: morereward = 500;
	        case 3: morereward = 750;
			case 4: morereward = 1000;
	    }
	    
	    new reward = playerData[playerid][pLevel]*150+morereward;
	    playerData[playerid][pHours]++;
	    playerData[playerid][pMinutes] = 0;
	    playerData[playerid][pDaily] = 0;
	    GivePlayerMoneyEx(playerid, reward);
	    SendClientMessageEx(playerid, COLOR_YELLOW, "** {FFFFFF}คุณได้เล่นครบ {00FF00}%d {FFFFFF}ชั่วโมงแล้ว", playerData[playerid][pHours]);
	    SendClientMessageEx(playerid, COLOR_YELLOW, "** {FFFFFF}คุณได้รับเงินจำนวน {00FF00}%s", FormatMoney(reward));

	    if (GetFactionType(playerid) == FACTION_POLICE)
	    {
	       // playerData[playerid][pBankMoney] += 2000;
	        SendClientMessage(playerid, COLOR_LIGHTBLUE, "[POLICE STATION DM] เงินเพย์เดย์ออกแล้ว ไปรับที่ผู้บัญชาการตำรวจเลย");
	    }

	    /*if (GetFactionType(playerid) == FACTION_MEDIC)
	    {
	      //  playerData[playerid][pBankMoney] += 2000;
	        SendClientMessage(playerid, COLOR_LIGHTRED, "[HOSPITAL DM] เงินเพย์เดย์ออกแล้ว ไปรับที่เลย");
	    }*/

	    if (GetFactionType(playerid) == FACTION_MEC)
	    {
	       // playerData[playerid][pBankMoney] += 2000;
	        SendClientMessage(playerid, COLOR_ORANGE, "[MECHANICLE DM] เงินเพย์เดย์ออกแล้ว ไปรับที่ผู้อำนวยการโรงพยาบาลเลย");
	    }
		if (GetFactionType(playerid) == FACTION_GOV)
	    {
			new govid;
			if (govid == playerid) return 1;
			
	        govData[govid][govMoney] += 100000;
			SendClientMessage(playerid, COLOR_RED, "*[คำเตือน]: หากสภาไม่แจกจ่ายเงินเดือน จะมีโทษหนักหลายสถาน แอดทีมจ้องจะเล่นคุณอยู่ *");
			SendClientMessage(playerid, COLOR_RED, "");
	        SendClientMessage(playerid, COLOR_ORANGE, "[SUNDAY] การตลาดดีมาก สภาได้ภาษี $100,000 เข้าระบบเรียบร้อย");
			SendClientMessage(playerid, COLOR_ORANGE, "[SUNDAY] ประธานสภาและรองประธาน นำไปแจกจ่ายเงินเพย์เดย์ให้หน่วยงานได้เลย");
			SendClientMessage(playerid, COLOR_RED, "");
			SendClientMessage(playerid, COLOR_RED, "*[คำเตือน]: หากสภาไม่แจกจ่ายเงินเพย์เดย์ จะมีโทษหนักหลายสถาน แอดทีมจ้องจะเล่นคุณอยู่ *");
			GOVgroup_Save(govid);
	    }
	}
    return 1;
}

