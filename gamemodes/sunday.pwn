Vehicle_Nearest(playerid)
{
	new
	    Float:fDistance = FLOAT_INFINITY,
	    Float:fX,
	    Float:fY,
	    Float:fZ,
	    iIndex = -1
	;
	for(new i=0;i!=MAX_VEHICLES;i++) {

	    GetVehiclePos(i, fX, fY, fZ);

		new
        	Float:temp = GetPlayerDistanceFromPoint(playerid, fX, fY, fZ);

		if (temp < fDistance && temp < 6.0)
		{
		    fDistance = temp;
		    iIndex = i;
		}
	}
	return iIndex;
}

