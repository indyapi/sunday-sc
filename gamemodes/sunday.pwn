// --> ระบบ Safe
stock Safe_Place(playerid)
{
	new
	    Float:angle, string[256];

	GetPlayerFacingAngle(playerid, angle);

	GetPlayerPos(playerid, SafeData[playerid][safePos][0], SafeData[playerid][safePos][1], SafeData[playerid][safePos][2]);

	SafeData[playerid][safePlaced] = true;
	SafeData[playerid][safeInterior] = GetPlayerInterior(playerid);
	SafeData[playerid][safeWorld] = GetPlayerVirtualWorld(playerid);

    SafeData[playerid][safeObject] = CreateDynamicObject(2332, SafeData[playerid][safePos][0], SafeData[playerid][safePos][1], SafeData[playerid][safePos][2] - 0.6, 0.0, 0.0, angle, SafeData[playerid][safeWorld], SafeData[playerid][safeInterior]);

    format(string, sizeof(string), "{6A6C6C}(Safe)\n{FFFFFF}เจ้าของ Safe : %s", GetPlayerNameEx(playerid));
	SafeData[playerid][safeText3D] = CreateDynamic3DTextLabel(string, COLOR_RED, SafeData[playerid][safePos][0], SafeData[playerid][safePos][1], SafeData[playerid][safePos][2] - 0.7, 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, SafeData[playerid][safeWorld], SafeData[playerid][safeInterior]);

	return 1;
}

stock Safe_Nearest(playerid)
{
	foreach (new i : Player) if (SafeData[i][safePlaced] && GetPlayerInterior(playerid) == SafeData[i][safeInterior] && GetPlayerVirtualWorld(playerid) == SafeData[i][safeWorld] && IsPlayerInRangeOfPoint(playerid, 30.0, SafeData[i][safePos][0], SafeData[i][safePos][1], SafeData[i][safePos][2])) {
     	return i;
	}
	return INVALID_PLAYER_ID;
}

stock Safe_Destroy(playerid)
{
	if (SafeData[playerid][safePlaced])
	{
		if (IsValidDynamicObject(SafeData[playerid][safeObject]))
		    DestroyDynamicObject(SafeData[playerid][safeObject]);

		if (IsValidDynamic3DTextLabel(SafeData[playerid][safeText3D]))
		    DestroyDynamic3DTextLabel(SafeData[playerid][safeText3D]);

        SafeData[playerid][safePlaced] = false;
        SafeData[playerid][safeInterior] = 0;
        SafeData[playerid][safeWorld] = 0;
	}
	return 1;
}

CMD:safe(playerid, params[])
{
	new
	    type[24],
	    string[512];

	if (playerData[playerid][pSafe] == 0)
	    return SendClientMessage(playerid, COLOR_GREY, "คุณไม่มี Safe อยู่ในตัว");

	if (sscanf(params, "s[24]S()[128]", type, string))
	{
	    SendClientMessage(playerid, COLOR_GREY, "การใช้งาน : {FFFFFF}/safe (รายการ)");
	    SendClientMessage(playerid, COLOR_YELLOW, "(รายการ) :{FFFFFF} วาง, เก็บ, เปิด");
	    return 1;
	}

	if (!strcmp(type, "วาง", true))
	{
	    if (SafeData[playerid][safePlaced])
	        return SendClientMessage(playerid, COLOR_GREY, "คุณได้วาง Safe แล้ว");

		if (Safe_Nearest(playerid) != INVALID_PLAYER_ID)
		    return SendClientMessage(playerid, COLOR_GREY, "คุณอยู่ในขอบเขตของ Safe ผู้เล่นอื่น");

		if (IsPlayerInAnyVehicle(playerid))
		    return SendClientMessage(playerid, COLOR_GREY, "คุณต้องออกจากยานพาหนะก่อน");

		Safe_Place(playerid);

		SendNearbyMessage(playerid, 30.0, COLOR_PURPLE, "** %s ได้วาง Safe ลง", GetPlayerNameEx(playerid));
		SendClientMessage(playerid, COLOR_YELLOW, "คุณได้วาง Safe แล้ว");
	}

	else if (!strcmp(type, "เก็บ", true))
	{
	    if (!SafeData[playerid][safePlaced])
	        return SendClientMessage(playerid, COLOR_GREY, "คุณยังไม่ได้วาง Safe");

		if (!IsPlayerInRangeOfPoint(playerid, 3.0, SafeData[playerid][safePos][0], SafeData[playerid][safePos][1], SafeData[playerid][safePos][2]))
		    return SendClientMessage(playerid, COLOR_GREY, "คุณไม่ได้อยู่ในขอบเขต Safe ของคุณ");

		Safe_Destroy(playerid);
		SendClientMessage(playerid, -1, "คุณได้เก็บ Safe ของคุณแล้ว");
	}

	else if (!strcmp(type, "เปิด", true))
	{
	    if (!SafeData[playerid][safePlaced])
	        return SendClientMessage(playerid, COLOR_GREY, "คุณยังไม่ได้วาง Safe");

		if (!IsPlayerInRangeOfPoint(playerid, 3.0, SafeData[playerid][safePos][0], SafeData[playerid][safePos][1], SafeData[playerid][safePos][2]))
		    return SendClientMessage(playerid, COLOR_GREY, "คุณไม่ได้อยู่ในขอบเขต Safe ของคุณ");

		if (playerData[playerid][pSafePassword] == 0)
		{
		    Dialog_Show(playerid, DIALOG_SAFE_PASS, DIALOG_STYLE_INPUT, "{FC4040}(การตั้งรหัส Safe)", "{FFFFFF}เนื่องจากคุณใช้งาน Safe ครั้งแรก กรุณาระบุรหัสในการเข้า Safe คุณ {FC4040}(4 หลัก)\n{FC4040}แนะนำ : {FFFFFF}ต้องเป็นตัวเลขเท่านั้น เช่น : {FC4040}2540", "ตกลง", "ยกเลิก");
		}
		else Dialog_Show(playerid, DIALOG_SAFE1, DIALOG_STYLE_INPUT, "{FC4040}(การรักษาความปลอดภัย Safe)", "{FFFFFF}กรุณาระบุรหัสผ่านของ Safe คุณ :", "ตกลง", "ยกเลิก");
	}
	return 1;
}

// --> ตั้งรหัส Safe
Dialog:DIALOG_SAFE_PASS(playerid, response, listitem, inputtext[])
{
	new pass = strval(inputtext);

    if(!response)
        return 1;

	if(response)
	{
		if (pass < 1000)
			return Dialog_Show(playerid, DIALOG_SAFE_PASS, DIALOG_STYLE_INPUT, "{FC4040}ผิดพลาด : รหัสต้อง 4 หลักเท่านั้น", "{FFFFFF}เนื่องจากคุณใช้งาน Safe ครั้งแรก กรุณาระบุรหัสในการเข้า Safe คุณ {FC4040}(4 หลัก)\n{FC4040}แนะนำ : {FFFFFF}ต้องเป็นตัวเลขเท่านั้น เช่น : {FC4040}2540", "ตกลง", "ยกเลิก");

		else if (pass > 9999)
			return Dialog_Show(playerid, DIALOG_SAFE_PASS, DIALOG_STYLE_INPUT, "{FC4040}ผิดพลาด : รหัสต้อง 4 หลักเท่านั้น", "{FFFFFF}เนื่องจากคุณใช้งาน Safe ครั้งแรก กรุณาระบุรหัสในการเข้า Safe คุณ {FC4040}(4 หลัก)\n{FC4040}แนะนำ : {FFFFFF}ต้องเป็นตัวเลขเท่านั้น เช่น : {FC4040}2540", "ตกลง", "ยกเลิก");

		playerData[playerid][pSafePassword] = pass;
		SendClientMessageEx(playerid, COLOR_LIGHTRED, "การตั้งรหัส Safe : {FFFFFF}คุณได้ตั้งรหัส Safe คือ : %d", pass);

		return 1;
	}
	return 1;
}

// --> ฝากของเข้า Safe [1]
Dialog:DIALOG_SAFE1(playerid, response, listitem, inputtext[])
{
	new pass = strval(inputtext);

    if(!response)
