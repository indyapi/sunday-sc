alias:onwarsf("เปิดวอsf")
CMD:onwarsf(playerid)
{
    if (playerData[playerid][pAdmin] < 1)
        return SendClientMessage(playerid, COLOR_RED, "[!] คุณไม่ได้รับอนุญาติ");

    if (OpenWarSF == 0)
    {
        OpenWarSF = 1;
        SendClientMessageToAll(COLOR_YELLOW, "[ประกาศ] : {FFFFFF}ผู้ดูแลได้ทำการเปิดการวอร์เมือง San Fierro แล้ว /warsf 1-4 เพื่อเข้าร่วมการวอร์!");
    }
    else
    {
        OpenWarSF = 0;
        foreach(new i : Player){
            if(InWarSF[i] == 1){
                InWarSF[i] = 0;
                SpawnPlayer(i);
            }
        }
        SendClientMessageToAll(COLOR_LIGHTRED, "[ประกาศ] : {FFFFFF}ผู้ดูแลได้ปิดวอเมือง San Fierro แล้ว, ขอบคุณที่มาร่วมสนุกกัน!");
    }
    return 1;
}

CMD:warsf(playerid, params[])
{
    new type;
    if (sscanf(params, "d", type))
        return SendClientMessage(playerid, COLOR_GREY, "การใช้งาน : {FFFFFF}/warsf [1-4]");

    if (OpenWarSF == 0)
        return SendClientMessage(playerid, COLOR_LIGHTRED, "วอยังไม่เปิด");

	if (GetFactionType(playerid) != FACTION_GANG)
		return SendClientMessage(playerid, COLOR_RED, "สำหรับแก๊งเท่านั้น!");

    if (playerData[playerid][pFaction] == -1)
        return SendClientMessage(playerid, COLOR_LIGHTRED, "คุณไม่มีกลุ่ม/แก๊ง");

    if (InWarSF[playerid] == 1)
        return SendClientMessage(playerid, COLOR_LIGHTRED, "คุณอยู่ในวอ SF อยู่แล้ว");

    if (factionData[playerData[playerid][pFaction]][factionGangWarCount] >= 10)
        return SendClientMessage(playerid, COLOR_LIGHTRED, "แก๊งของคุณได้เข้าร่วมครบ 10 แล้ว");

    if (playerData[playerid][pJailTime] != 0)
        return SendClientMessage(playerid, COLOR_LIGHTRED, "คุณติดคุกอยู่");

    if(type == 1)
    {
        SetPlayerPos(playerid, -2038.3583,-763.5511,31.2142);
        SetPlayerFacingAngle(playerid, 3.5665);
        SetPlayerInterior(playerid, 0);
        SetPlayerVirtualWorld(playerid, 0);
        InWarSF[playerid] = 1;
    }
    if(type == 2)
    {
        SetPlayerPos(playerid, -2007.3967,-765.2784,30.8955);
        SetPlayerFacingAngle(playerid, 181.4456);
        SetPlayerInterior(playerid, 0);
        SetPlayerVirtualWorld(playerid, 0);
        InWarSF[playerid] = 1;
    }
    if(type == 3)
    {
        SetPlayerPos(playerid, -2008.2063,-852.3330,30.5607);
        SetPlayerFacingAngle(playerid, 333.0770);
        SetPlayerInterior(playerid, 0);
        SetPlayerVirtualWorld(playerid, 0);
        InWarSF[playerid] = 1;
    }
    if(type == 4)
    {
        SetPlayerPos(playerid, -2037.6055,-851.8555,30.3946);
        SetPlayerFacingAngle(playerid, 349.9972);
        SetPlayerInterior(playerid, 0);
        SetPlayerVirtualWorld(playerid, 0);
        InWarSF[playerid] = 1;
    }

    new factionid = playerData[playerid][pFaction];

    factionData[factionid][factionGangWarCount]++;
    SendFactionMessage(factionid, COLOR_FACTION, "(( แก๊งของคุณได้เข้าสู่ WARSF %d/10 ))", factionData[factionid][factionGangWarCount]);

    return 1;
}

alias:givehealdrug("เสกกล่องยา")
CMD:givehealdrug(playerid, params[])
{
    if(playerData[playerid][pDevMode] >= 7)
    {
    	new userid, amount;

		if(sscanf(params, "ud", userid, amount))
			return SendClientMessage(playerid, COLOR_WHITE, "/เสกกล่องยา [ไอดี/ชื่อ] [จำนวน]");

        if(userid == INVALID_PLAYER_ID)
			return SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}ผู้เล่นไอดีนี้ไม่ได้อยู่ในเกม");

        Inventory_Add(userid, "กล่องยา", amount);
		SendClientMessageEx(userid, COLOR_YELLOW, "[ คุณได้รับกล่องยา จำนวน %d ขวด จากผู้ดูแล %s ]", amount, GetPlayerNameEx(playerid));
        SendAdminMessage(COLOR_ADMIN, "AdmLog: %s ได้ให้ กล่องยา กับ %s(%d) จำนวน %s ขวด", GetPlayerNameEx(playerid), GetPlayerNameEx(userid), userid, FormatMoney(amount));
	}
    return 1;
}

