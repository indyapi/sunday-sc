CMD:hood(playerid, params[])
{
	for (new i = 1; i != MAX_VEHICLES; i ++) if (IsValidVehicle(i) && IsPlayerNearHood(playerid, i))
	{
	    if (!IsDoorVehicle(i))
	        return SendClientMessage(playerid, COLOR_GREY, "....");

		new FrontLeft, FrontRight, RearLeft, RearRight, WindShield, FrontBumper, RearBumper;
	    GetVehiclePanelsDamageStatus(i, FrontLeft, FrontRight, RearLeft, RearRight, WindShield, FrontBumper, RearBumper);

	    if (WindShield >= 1)
	        return SendClientMessage(playerid, COLOR_GREY, "....");


	    if (!GetHoodStatus(i))
		{
	        SetHoodStatus(i, true);
	        SendNearbyMessage(playerid, 30.0, COLOR_PURPLE, "** %s Open Hood", GetPlayerNameEx(playerid));
		}
		else
		{
			SetHoodStatus(i, false);
	        SendNearbyMessage(playerid, 30.0, COLOR_PURPLE, "** %s Close Hood", GetPlayerNameEx(playerid));
		}
	    return 1;
	}
	SendClientMessage(playerid, COLOR_GREY, "d...d");
	return 1;
}

stock SetHoodStatus(vehicleid, bool:status)
{
	new
	    engine,
	    lights,
	    alarm,
	    doors,
	    bonnet,
	    boot,
	    objective;

	GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
	return SetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, status, boot, objective);
}

stock GetVehiclePanelsDamageStatus(vehicleid, &FrontLeft, &FrontRight, &RearLeft, &RearRight, &WindShield, &FrontBumper, &RearBumper)
{
	new Panels, Doors, Lights, Tires;
	GetVehicleDamageStatus(vehicleid, Panels, Doors, Lights, Tires);
	FrontLeft = Panels & 15;
	FrontRight = Panels >> 4 & 15;
	RearLeft = Panels >> 8 & 15;
	RearRight = Panels >> 12 & 15;
	WindShield = Panels >> 16 & 15;
	FrontBumper = Panels >> 20 & 15;
	RearBumper = Panels >> 24 & 15;
	return true;
}

stock GetHoodStatus(vehicleid)
{
	new
	    engine,
	    lights,
	    alarm,
	    doors,
	    bonnet,
	    boot,
	    objective;

	GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);

	if (bonnet != 1)
		return 0;

	return 1;
}

alias:lock("ล็อค")
CMD:lock(playerid, params[])
{
	new
	    id = GetNearbyVehicle(playerid);

    if(IsVehicleOwner(playerid, id) || playerData[playerid][pVehicleKeys] == id || (carData[id][carFaction] >= 0 && carData[id][carFaction] == playerData[playerid][pFaction]))
	{
	    if(!carData[id][carLocked])
	    {
			carData[id][carLocked] = 1;

			GameTextForPlayer(playerid, "~r~Vehicle locked", 3000, 6);
			SendNearbyMessage(playerid, 20.0, COLOR_PURPLE, "** %s ได้ล็อครถ %s", GetPlayerNameEx(playerid), ReturnVehicleName(id));
		}
		else
		{
			carData[id][carLocked] = 0;

			GameTextForPlayer(playerid, "~g~Vehicle unlocked", 3000, 6);
			SendNearbyMessage(playerid, 20.0, COLOR_PURPLE, "** %s ได้ปลดล็อครถ %s", GetPlayerNameEx(playerid), ReturnVehicleName(id));
		}

		SetVehicleParams(id, VEHICLE_DOORS, carData[id][carLocked]);
        PlayerPlaySound(playerid, 1145, 0.0, 0.0, 0.0);
		new query[128];
		mysql_format(g_SQL, query, sizeof(query), "UPDATE vehicles SET carLocked = %d WHERE carID = %d", carData[id][carLocked], carData[id][carID]);
		mysql_tquery(g_SQL, query);
		return 1;
	}

	new vehicleid = Vehicle_Nearest(playerid);

    for (new j = 0; j < 11; j ++)
    {
		if (CallVehicle[playerid][j] == vehicleid)
		{
		    if(LockVehicle[vehicleid] == 0)
		    {
		        LockVehicle[vehicleid] = 1;

				GameTextForPlayer(playerid, "~r~Vehicle locked", 3000, 6);
				SendNearbyMessage(playerid, 20.0, COLOR_PURPLE, "** %s ได้ล็อครถ %s", GetPlayerNameEx(playerid), ReturnVehicleName(vehicleid));

		    }
		    else
		    {
		        LockVehicle[vehicleid] = 0;

				GameTextForPlayer(playerid, "~g~Vehicle unlocked", 3000, 6);
				SendNearbyMessage(playerid, 20.0, COLOR_PURPLE, "** %s ได้ปลดล็อครถ %s", GetPlayerNameEx(playerid), ReturnVehicleName(vehicleid));

		    }

		    SetVehicleParams(vehicleid, VEHICLE_DOORS, LockVehicle[vehicleid]);
	     	PlayerPlaySound(playerid, 1145, 0.0, 0.0, 0.0);
			return 1;
		}
	}

	new idhouse;
	if (!IsPlayerInAnyVehicle(playerid) && (idhouse = (House_Inside(playerid) == -1) ? (House_Nearest(playerid)) : (House_Inside(playerid))) != -1 && House_IsOwner(playerid, idhouse))
	{
		if (!HouseData[idhouse][houseLocked])
		{
			HouseData[idhouse][houseLocked] = true;
			House_Save(idhouse);

			//ShowPlayerFooter(playerid, "You have ~r~locked~w~ your house!");
			PlayerPlaySound(playerid, 1145, 0.0, 0.0, 0.0);
			SendClientMessage(playerid, COLOR_WHITE, "คุณได้ {FF0000}ล็อค {FFFFFF}บ้านของคุณ!");

			//canlock = 1;
		}
		else
		{
			HouseData[idhouse][houseLocked] = false;
			House_Save(idhouse);

			//ShowPlayerFooter(playerid, "You have ~g~unlocked~w~ your house!");
			SendClientMessage(playerid, COLOR_WHITE, "คุณได้ {00FF00}ปลดล็อค {FFFFFF}บ้านของคุณ!");
			PlayerPlaySound(playerid, 1145, 0.0, 0.0, 0.0);

			//canlock = 1;
		}
	}


	return 1;
}

Dialog:DIALOG_DONATE(playerid, response, listitem, inputtext[])
{
	if(response)
	{
		switch(listitem)
  		{
			case 0:
			{
				new
				    count,
				    var[32],
					string[4096],
					string2[4096];

				for (new i = 0; i != MAX_CARSHOP; i ++) if (carshopData[i][carshopExists])
				{
				    if(carshopData[i][carshopType] == 3)
				    {
						format(string, sizeof(string), "{F35748}%s\t{F9C205}%d {FFFFFF}Coin\n", ReturnVehicleModelName(carshopData[i][carshopModel]), carshopData[i][carshopPrice]);
						strcat(string2, string);
						format(var, sizeof(var), "CARSHOP%d", count);
						SetPVarInt(playerid, var, i);
						count++;
					}
				}
				if (!count)
				{
					SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}เซิร์ฟเวอร์ยังไม่ได้เพิ่มยานพาหนะลงร้าน");
					return 1;
				}
				format(string, sizeof(string), "{F35748}[ชื่อรุ่น]\t{F9C205}[Coin]\n%s", string2);
				Dialog_Show(playerid, DIALOG_BUYCAR_DONATE, DIALOG_STYLE_TABLIST_HEADERS, "{F90905}ร้านขายรถโดเนท", string, "ซื้อ", "ปิด");
			}
			case 1: // กาชาปอง
			{
				if (playerData[playerid][pCoin] < 100)
				    return SendClientMessage(playerid, COLOR_RED, "คุณมี Coin ไม่เพียงพอ (100 Coin)");

                playerData[playerid][pCoin] -= 100;
				Inventory_Add(playerid, "กาชาปอง", 1);

                SendClientMessage(playerid, COLOR_GREEN, "|===============================|");
                SendClientMessage(playerid, COLOR_YELLOW, "Coin {FFFFFF} - 100");
                SendClientMessage(playerid, COLOR_YELLOW, "กาชาปอง {16D603} + 1");
                SendClientMessage(playerid, COLOR_GREEN, "|===============================|");
			}
			case 2:
			{
				new string100[512];
				new string2[512];

				format(string100, sizeof(string100), "{FFFFFF}ระดับ VIP\t{F9C205}ราคา\n");
				strcat(string2,string100);

				format(string100, sizeof(string100), "{FFFFFF}VIP-1\t{F9C205}100 {FFFFFF}Coin\n");
				strcat(string2,string100);

				format(string100, sizeof(string100), "{FFFFFF}VIP-2\t{F9C205}200 {FFFFFF}Coin\n");
				strcat(string2,string100);

				format(string100, sizeof(string100), "{FFFFFF}VIP-3\t{F9C205}300 {FFFFFF}Coin\n");
				strcat(string2,string100);

                format(string100, sizeof(string100), "{FFFFFF}VIP-4\t{F9C205}700 {FFFFFF}Coin\n");
				strcat(string2,string100);

				Dialog_Show(playerid,DIALOG_VIP,DIALOG_STYLE_TABLIST_HEADERS,"{FFFFFF}[{F9C205}โดเนท > VIP{FFFFFF}]",string2,"ตกลง","ยกเลิก");
			}
			case 3:
			{
				if (playerData[playerid][pCoin] == 0)
				    return SendClientMessage(playerid, COLOR_RED, "คุณไม่มี Coin");

                playerData[playerid][pCoin] -= 1;
                GivePlayerMoneyEx(playerid, 10);

                SendClientMessage(playerid, COLOR_GREEN, "|===============================|");
                SendClientMessage(playerid, COLOR_YELLOW, "Coin {FFFFFF} - 1");
                SendClientMessage(playerid, COLOR_YELLOW, "เงินเขียว {16D603} + $10");
                SendClientMessage(playerid, COLOR_GREEN, "|===============================|");
			}
			case 4: // อาวุธแฟชั่น
			{
				new string100[512];
				new string2[512];

				format(string100, sizeof(string100), "{FFFFFF}ระดับ VIP\t{F9C205}ราคา\n");
				strcat(string2,string100);

				format(string100, sizeof(string100), "{FFFFFF}ดาบมณี\t{F9C205}250 {FFFFFF}Coin\n");
				strcat(string2,string100);

				format(string100, sizeof(string100), "{FFFFFF}มีดสั้นติดไฟ\t{F9C205}250 {FFFFFF}Coin\n");
				strcat(string2,string100);

				Dialog_Show(playerid,DIALOG_FASHION,DIALOG_STYLE_TABLIST_HEADERS,"{FFFFFF}[{F9C205}โดเนท > อาวุธแฟชั่น{FFFFFF}]",string2,"ตกลง","ยกเลิก");
			}
			case 5:
			{
				if (playerData[playerid][pCoin] < 100)
				    return SendClientMessage(playerid, COLOR_RED, "คุณมี Coin ไม่เพียงพอ");

                playerData[playerid][pCoin] -= 100;
                Inventory_Add(playerid, "Boombox", 1);

                SendClientMessage(playerid, COLOR_GREEN, "|===============================|");
                SendClientMessage(playerid, COLOR_YELLOW, "Coin {FFFFFF} - 100 Coin");
                SendClientMessage(playerid, COLOR_YELLOW, "คุณได้รับ 'Boombox' จากการโดเนท (/boombox เพื่อใช้งาน)");
                SendClientMessage(playerid, COLOR_GREEN, "|===============================|");
			}
			case 6:
			{
				new string100[512];
				new string2[512];

				format(string100, sizeof(string100), "{FFFFFF}รายการ\t{F9C205}ราคา\n");
				strcat(string2,string100);

				format(string100, sizeof(string100), "{FFFFFF}ฟักฟักฟัก\t{F9C205}500 {FFFFFF}Coin\n");
				strcat(string2,string100);

				Dialog_Show(playerid,d_fashionD,DIALOG_STYLE_TABLIST_HEADERS,"{FFFFFF}[{F9C205}โดเนท > อาวุธแฟชั่น{FFFFFF}]",string2,"ตกลง","ยกเลิก");
			}
		}
	}
	return 1;
}

