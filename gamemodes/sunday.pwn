public OnPlayerCommandPerformed(playerid, cmd[], params[], result, flags)
{
	if(playerData[playerid][IsLoggedIn] == false)
	    return SendClientMessage(playerid, COLOR_RED, "[SUNDAY] {FFFFFF}กรุณาล็อกอินก่อน!");

    if (result == -1)
    {
        //SendClientMessageEx(playerid, COLOR_RED, "[Server Command] {FFFFFF}ไม่มีคำสั่ง /%s อยู่ในระบบ", cmd);
        return 0;
    }

    return 1;
}

