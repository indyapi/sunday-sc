alias:reportsv("แจ้งรีเซิฟ", "แจ้งรี")
CMD:reportsv(playerid, p[])
{
	if(playerData[playerid][pAdmin] == 0)
	    return 1;

	SendClientMessageToAll(COLOR_GREEN, "[SUNDAY]: ประกาศสำคัญ!!");
	SendClientMessageToAll(COLOR_GREEN, "[SUNDAY]: จะทำการรีเซิฟเวอร์ในอีก 1 นาทีข้างหน้า!!");
	SendClientMessageToAll(COLOR_GREEN, "[SUNDAY]: จะทำการรีเซิฟเวอร์ในอีก 1 นาทีข้างหน้า!!");
	SendClientMessageToAll(COLOR_GREEN, "[SUNDAY]: รีเซิฟเวอร์ทุกวันเวลา 18:00น.!!");

	return 1;
}

alias:restart("รีเซิฟ", "reserv")
CMD:restart(playerid, p[])
{
	if(playerData[playerid][pAdmin] == 0)
	    return 1;

	SendClientMessageToAll(COLOR_GREEN, " ");
	SendClientMessageToAll(COLOR_GREEN, "SAMP:UNITY TOWN");
	SendClientMessageToAll(COLOR_GREEN, "    Copyright (C) SUNDAY");
	SendClientMessageToAll(COLOR_GREEN, "    เซิร์ฟเวอร์นี้ถูกสร้างขึ้นมาใหม่ตั้งแต่ต้น เป็นโหมด Roleplay - Community");
	SendClientMessageToAll(COLOR_GREEN, "    ทุกคนสามารถแสดงความคิดเห็นได้อย่างอิสระเพื่อให้เกมส์โหมดนี้ดำเนินไปในทางที่ดีขึ้น");
	SendClientMessageToAll(COLOR_GREEN, " ");
	SendClientMessageToAll(COLOR_GREEN, "-------------------------------------------------------------------------------------------------------------------------");
	SendClientMessageToAll(COLOR_GREEN, " >  เซิร์ฟเวอร์กำลังรีสตาร์ท โปรดรอสักครู่...");
	SendClientMessageToAll(COLOR_GREEN, "-------------------------------------------------------------------------------------------------------------------------");

	foreach (new i : Player)
	{
		if(playerData[i][IsLoggedIn])
		{
			UpdateplayerData(i);
			DelayedKick(i);
			SendClientMessage(i, COLOR_YELLOW, "[SUNDAY]: เซิฟเวอร์ถูก Restart เพื่ออัพเดทระบบ กรุณาออกเข้าใหม่");
			SendClientMessage(i, COLOR_YELLOW, "[SUNDAY]: เซิฟเวอร์ถูก Restart เพื่ออัพเดทระบบ กรุณาออกเข้าใหม่");
			SendClientMessage(i, COLOR_YELLOW, "[SUNDAY]: เซิฟเวอร์ถูก Restart เพื่ออัพเดทระบบ กรุณาออกเข้าใหม่");
			SendClientMessage(i, COLOR_YELLOW, "[SUNDAY]: เซิฟเวอร์ถูก Restart เพื่ออัพเดทระบบ กรุณาออกเข้าใหม่");
			SendClientMessage(i, COLOR_YELLOW, "[SUNDAY]: เซิฟเวอร์ถูก Restart เพื่ออัพเดทระบบ กรุณาออกเข้าใหม่");
			SendClientMessage(i, COLOR_YELLOW, "[SUNDAY]: เซิฟเวอร์ถูก Restart เพื่ออัพเดทระบบ กรุณาออกเข้าใหม่");
		}
	}
	SendRconCommand("gmx");
	print("[Admin-Report]: Restart server now!");
	print("[Admin-Report]: Restart server now!");
	print("[Admin-Report]: Restart server now!");
	print("[Admin-Report]: Restart server now!");
	print("[Admin-Report]: Restart server now!");
	print("[Admin-Report]: Restart server now!");
	print("[Admin-Report]: Restart server now!");
	print("[Admin-Report]: Restart server now!");
	print("[MySQL]: Disconnect is successful.");

	DC_SendEmbedMessage(CH_DCC_ID, "SV SAVE & OFFLINE !!", "https://web.facebook.com/gtaunitytown/",  DCC_ReturnTimedata(), "---------------------------------\nSUNDAY.BOT", 0x990000, "https://image.pngaaa.com/148/958148-small.png");
	return 1;
}

CMD:jumpon(playerid)
{
	switch(pJumpOn[playerid])
	{
	    case 0: pJumpOn[playerid] = 1;
	    case 1: pJumpOn[playerid] = 0;
	}return 1;
}

stock isPlayerNearPos(playerid, Float:radius, Float:x, Float:y, Float:z)
{
	return (IsPlayerInRangeOfPoint(playerid, radius, x, y, z));
}

stock IsPlayerInRangeOfPlayer(playerid, playerid2, Float: radius) {

	new
		Float:Floats[3];

	GetPlayerPos(playerid2, Floats[0], Floats[1], Floats[2]);
	return IsPlayerInRangeOfPoint(playerid, radius, Floats[0], Floats[1], Floats[2]);
}

stock BanAllBots(playerid) // Bans the player.
{
    new PlayerName[25];
    GetPlayerName(playerid, PlayerName, sizeof(PlayerName));
    printf("%s was Banned due to MANY Connections.", PlayerName);
    Ban(playerid);
    return 1;
}

ReturnIP(playerid)
{
	new
	    ip[16];

	GetPlayerIp(playerid, ip, sizeof(ip));
	return ip;
}

stock CountIP(ip[]) // Counts how many connections from one IP.
{
    new b = 0;
    for(new i = 0; i < MAX_PLAYERS; i++) if(IsPlayerConnected(i) && !strcmp(GetIP(i),ip)) b++;
    return b;
}

public OnPlayerClickPlayer(playerid, clickedplayerid, source)
{
	if(playerData[playerid][pAdmin] == 0)
	    return 1;
	    
	if(clickedplayerid == playerid)
	    return 1;
	    
	pClickPlayer[playerid] = clickedplayerid;
    Dialog_Show(playerid, CLICKPLAYER, DIALOG_STYLE_LIST, "\
	[SUNDAY MENU : จัดการ %s]", "\
	{00FFFF}>> {FFFFFF}Go : ไป\n\
	{00FFFF}>> {FFFFFF}Bring : ดึง\n\
	{00FFFF}>> {FFFFFF}Possessed : สิงร่าง\n\
	{00FFFF}>> {FFFFFF}Check Stats : เช็คข้อมูล\n\
	{00FFFF}>> {FFFFFF}Check Item : เช็คไอเท็ม\n\
	{00FFFF}>> {FFFFFF}Check Vehicle : เช็ครถ\n\
	{00FFFF}>> {FFFFFF}Ban Player : แบน\n\
	{00FFFF}>> {FFFFFF}Kick Player : เตะ\n\
	", "Select", "Close",GetPlayerNameEx(clickedplayerid));

	return 1;
}
Dialog:CLICKPLAYER(playerid, response, listitem, inputtext[])
{
	new userid = pClickPlayer[playerid];
	if (!IsPlayerSpawnedEx(userid))
		return SendClientMessage(playerid, COLOR_RED, "[ ! ] {FFFFFF}ผู้เล่นไอดีนี้ยังไม่ได้อยู่ในสถานะปกติ");

	if (response)
	{
	    switch(listitem){
	        case 0:{
	            new string[302];
	            SendPlayerToPlayer(playerid, userid);

				format(string, sizeof(string), "You have ~y~teleported~w~ to %s.", GetPlayerNameEx(userid));
				GameTextForPlayer(playerid, string, 5000, 1);
	        }
	        case 1:{
	            SendPlayerToPlayer(userid, playerid);
				SendClientMessageEx(playerid, COLOR_SERVER, "คุณได้ดึงผู้เล่น %s มาหา", GetPlayerNameEx(userid));

	        }
	        case 2:{
		        if (GetPlayerState(playerid) != PLAYER_STATE_SPECTATING)
				{
					GetPlayerPos(playerid, playerData[playerid][pPos_X], playerData[playerid][pPos_X], playerData[playerid][pPos_Z]);
					GetPlayerFacingAngle(playerid, playerData[playerid][pPos_A]);

					playerData[playerid][pInterior] = GetPlayerInterior(playerid);
					playerData[playerid][pWorld] = GetPlayerVirtualWorld(playerid);
				}
				SetPlayerInterior(playerid, GetPlayerInterior(userid));
				SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(userid));

				TogglePlayerSpectating(playerid, 1);

				if (IsPlayerInAnyVehicle(userid))
				    	PlayerSpectateVehicle(playerid, GetPlayerVehicleID(userid));

				else
					PlayerSpectatePlayer(playerid, userid);

				SendClientMessage(playerid, COLOR_WHITE, "คุณกำลังส่อง");
				playerData[playerid][pSpectator] = userid;
				checkspec[playerid] = 1;

	        }
			case 3:{
				static const aGender[3][10] = {"แก้ไข", "ชาย", "หญิง"};

				if (isPlayerAndroid(userid))
				{
					Dialog_Show(playerid, CLICKPLAYER, DIALOG_STYLE_MSGBOX, "[ข้อมูลตัวละคร: %s]", 
					"--------------------------------------------------------------------------------------------------------------------------------\n\
					 | เพศ: {FFFF00}[%s] {FFFFFF}เงินในตัว: {FFFF00}[%s] {FFFFFF}เงินแดง: {FFFF00}[%s] {FFFFFF}วันเดือนปีเกิด: {FFFF00}[%s]\n\
					 | ฆ่า: {FFFF00}[%s] {FFFFFF}ตาย: {FFFF00}[%s] {FFFFFF}น้ำ: {FFFF00}[%.3f] {FFFFFF}อาหาร: {FFFF00}[%.3f]\n\
					 | เลเวล: {FFFF00}[%d] {FFFFFF}ค่าประสบการณ์: {FFFF00}[%d/%d] {FFFFFF}ชั่วโมงที่เล่น: {FFFF00}[%d] {FFFFFF}ครบชั่วโมง: {FFFF00}[%d/60]\n\
					 | วันที่ลงทะเบียน: {FFFF00}[%s]\n\
					 | เงินฝากในธนาคาร : {FFFF00}[$%s]\n\
					 --------------------------------------------------------------------------------------------------------------------------------\n\
					 | เล่นบนแพลตฟอร์ม : Android\n\
					 --------------------------------------------------------------------------------------------------------------------------------\n\
					", "โอเค", "", GetPlayerNameEx(userid),
					aGender[playerData[userid][pGender]], 
					FormatMoney(GetPlayerMoneyEx(userid)), 
					FormatMoney(GetPlayerRedMoney(userid)), 
					playerData[userid][pBirthday], 
					FormatNumber(playerData[userid][pKills]), 
					FormatNumber(playerData[userid][pDeaths]), 
					playerData[userid][pThirsty], 
					playerData[userid][pHungry], GetPlayerLevel(userid), 
					GetPlayerExp(userid), 
					GetPlayerRequiredExp(userid), 
					playerData[userid][pHours], 
					playerData[userid][pMinutes], 
					playerData[userid][pRegisterDate], 
					FormatNumber(playerData[userid][pBankMoney]));
				}
				else
				{
					Dialog_Show(playerid, CLICKPLAYER, DIALOG_STYLE_MSGBOX, "[ข้อมูลตัวละคร: %s]", 
					"--------------------------------------------------------------------------------------------------------------------------------\n\
					 | เพศ: {FFFF00}[%s] {FFFFFF}เงินในตัว: {FFFF00}[%s] {FFFFFF}เงินแดง: {FFFF00}[%s] {FFFFFF}วันเดือนปีเกิด: {FFFF00}[%s]\n\
					 | ฆ่า: {FFFF00}[%s] {FFFFFF}ตาย: {FFFF00}[%s] {FFFFFF}น้ำ: {FFFF00}[%.3f] {FFFFFF}อาหาร: {FFFF00}[%.3f]\n\
					 | เลเวล: {FFFF00}[%d] {FFFFFF}ค่าประสบการณ์: {FFFF00}[%d/%d] {FFFFFF}ชั่วโมงที่เล่น: {FFFF00}[%d] {FFFFFF}ครบชั่วโมง: {FFFF00}[%d/60]\n\
					 | วันที่ลงทะเบียน: {FFFF00}[%s]\n\
					 | เงินฝากในธนาคาร : {FFFF00}[$%s]\n\
					 --------------------------------------------------------------------------------------------------------------------------------\n\
					 | เล่นบนแพลตฟอร์ม : PC\n\
					 --------------------------------------------------------------------------------------------------------------------------------\n\
					", "โอเค", "", GetPlayerNameEx(userid),
					aGender[playerData[userid][pGender]], 
					FormatMoney(GetPlayerMoneyEx(userid)), 
					FormatMoney(GetPlayerRedMoney(userid)), 
					playerData[userid][pBirthday], 
					FormatNumber(playerData[userid][pKills]), 
					FormatNumber(playerData[userid][pDeaths]), 
					playerData[userid][pThirsty], 
					playerData[userid][pHungry], GetPlayerLevel(userid), 
					GetPlayerExp(userid), 
					GetPlayerRequiredExp(userid), 
					playerData[userid][pHours], 
					playerData[userid][pMinutes], 
					playerData[userid][pRegisterDate], 
					FormatNumber(playerData[userid][pBankMoney]));
				}
			}
			case 4:{
				toggleInventory(playerid, userid);
			}
			case 5:{
				new query[128];
				mysql_format(g_SQL, query, sizeof(query), "SELECT * FROM `vehicles` WHERE `carOwnerID` = %d", playerData[userid][pID]);
				mysql_tquery(g_SQL, query, "OnQueryFinished", "dd", playerid, THREAD_LIST_VEHICLES2);
			}
			case 6:{

				if (playerData[userid][pAdmin] > playerData[playerid][pAdmin])
					return SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}ไม่สามารถแบนแอดมินได้");

				Dialog_Show(playerid, D_BanPlayer, DIALOG_STYLE_INPUT, "[BAN ID]", "{FFFFFF}คุณต้องการจะแบนใข่ไหม กรุณาใส่สาเหตุ", "แบน", "ยกเลิก");
			}
			case 7:{
				if (playerData[userid][pAdmin] > playerData[playerid][pAdmin])
					return SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}ไม่สามารถเตะแอดมินได้");

				Dialog_Show(playerid, D_KickPlayer, DIALOG_STYLE_INPUT, "[KICK ID]", "{FFFFFF}คุณต้องการจะเตะใข่ไหม กรุณาใส่สาเหตุ", "แบน", "ยกเลิก");
			}
		 }
	}
	return 1;
}

Dialog:D_BanPlayer(playerid, response, listitem, inputtext[])
{
	new clickedplayerid;
	new reason = strval(inputtext);
	pClickPlayer[playerid] = clickedplayerid;
	new userid = pClickPlayer[playerid];
	if(clickedplayerid == playerid)
	    return 1;

	if(response)
	{
		new query[5000];
		SendClientMessageToAllEx(COLOR_LIGHTRED, "{FFFFFF}%s {FF3300}ถูกแบนออกจากเซิร์ฟเวอร์: สาเหตุ: {FFFFFF}%s", GetPlayerNameEx(userid), reason);
		playerData[userid][pBan] = 1;
		playerData[userid][pBanReason] = reason;
		mysql_format(g_SQL, query, sizeof query, "UPDATE `players` SET `playerBan` = %d , `playerBanReason` = '%e' WHERE `playerID` = %d",
		playerData[userid][pBan],
		reason,
		playerData[userid][pID]);
		mysql_tquery(g_SQL, query);
		//Ban(userid);
		DelayedKick(userid);
	}
	if(!response)
	{
		Dialog_Show(playerid, CLICKPLAYER, DIALOG_STYLE_LIST, "\
		[SUNDAY MENU : จัดการ %s]", "\
		{00FFFF}>> {FFFFFF}Go : ไป\n\
		{00FFFF}>> {FFFFFF}Bring : ดึง\n\
		{00FFFF}>> {FFFFFF}Possessed : สิงร่าง\n\
		{00FFFF}>> {FFFFFF}Check Stats : เช็คข้อมูล\n\
		{00FFFF}>> {FFFFFF}Check Item : เช็คไอเท็ม\n\
		{00FFFF}>> {FFFFFF}Check Vehicle : เช็ครถ\n\
		{00FFFF}>> {FFFFFF}Ban Player : แบน\n\
		{00FFFF}>> {FFFFFF}Kick Player : เตะ\n\
		", "Select", "Close",GetPlayerNameEx(userid));
	}
	return 1;
}

Dialog:D_KickPlayer(playerid, response, listitem, inputtext[])
{
	new reason = strval(inputtext);
	new clickedplayerid;
	pClickPlayer[playerid] = clickedplayerid;
	new userid = pClickPlayer[playerid];
	if(clickedplayerid == playerid)
	    return 1;

	if(response)
	{
		if (playerData[userid][pAdmin] > playerData[playerid][pAdmin])
			return SendClientMessage(playerid, COLOR_RED, "[ ! ] {FFFFFF}ไม่สามารถเตะแอดมินได้");

		SendClientMessageToAllEx(COLOR_LIGHTRED, "AdmCmd: %s ถูกเตะโดยแอดมิน %s, สาเหตุ: %s", GetPlayerNameEx(userid), GetPlayerNameEx(playerid), reason);
		DelayedKick(userid);
	}
	if(!response)
	{
		Dialog_Show(playerid, CLICKPLAYER, DIALOG_STYLE_LIST, "\
		[SUNDAY MENU : จัดการ %s]", "\
		{00FFFF}>> {FFFFFF}Go : ไป\n\
		{00FFFF}>> {FFFFFF}Bring : ดึง\n\
		{00FFFF}>> {FFFFFF}Possessed : สิงร่าง\n\
		{00FFFF}>> {FFFFFF}Check Stats : เช็คข้อมูล\n\
		{00FFFF}>> {FFFFFF}Check Item : เช็คไอเท็ม\n\
		{00FFFF}>> {FFFFFF}Check Vehicle : เช็ครถ\n\
		{00FFFF}>> {FFFFFF}Ban Player : แบน\n\
		{00FFFF}>> {FFFFFF}Kick Player : เตะ\n\
		", "Select", "Close",GetPlayerNameEx(userid));
	}
	return 1;
}

static DC_SendEmbedMessage(const channel[], const caption[], const url[], const description[], const description_2[], color, const image_url[])
{
    //System By Phayakko_Phayakka , Scum Samp Thai (ห้ามลบและแก้ไข)

    new DCC_Embed:embed = DCC_CreateEmbed(caption);
    DCC_SetEmbedUrl(embed, url);//ลิ้งเวลากด caption
    DCC_SetEmbedColor(embed, color);//สีของ embed
    DCC_SetEmbedThumbnail(embed, image_url);//ลิ้งรูปภาพ
    DCC_AddEmbedField(embed,description, description_2, true);//ข้อความคำอธิบาย
    DCC_SendChannelEmbedMessage(DCC_FindChannelById(channel), embed); //ส่งข้อความ
    return 0;
}

Dialog:DIALOG_ITEMCODE(playerid, response, listitem, inputtext[])
{
	if(!response)
		return 1;

	if(response)
	{

 		if (strfind(inputtext, "NEW-MEMBER" ,true) != -1) // เปลี่ยนรหัสแอดมิน
   		{
			if (playerData[playerid][pGiftBox] == 1)
                return SendClientMessage(playerid, COLOR_GREY, "คุณใช้ไปแล้ว"); 

			playerData[playerid][pGiftBox] = 1;

            GivePlayerMoneyEx(playerid, 20000);
            Inventory_Add(playerid, "พิซซ่า", 10);
            Inventory_Add(playerid, "น้ำเปล่า", 10);
            Inventory_Add(playerid, "มือถือ", 1);
			playerData[playerid][pPhone] = random(9000) + 1000;

			SendClientMessage(playerid, COLOR_GREY, "|========================================|");
			SendClientMessage(playerid, COLOR_GREEN, "[ของเริ่มต้น!] : {FFFFFF}คุณได้รับ เงินสด + $20,000");
			SendClientMessage(playerid, COLOR_GREEN, "[ของเริ่มต้น!] : {FFFFFF}คุณได้รับ พิซซ่า + 10");
			SendClientMessage(playerid, COLOR_GREEN, "[ของเริ่มต้น!] : {FFFFFF}คุณได้รับ น้ำเปล่า + 10");
			SendClientMessage(playerid, COLOR_GREEN, "[ของเริ่มต้น!] : {FFFFFF}คุณได้รับ มือถือ + 1");
 			SendClientMessage(playerid, COLOR_GREY, "|========================================|");
            SendClientMessageToAllEx(COLOR_GREEN, "[SUN-Report]: ผู้เล่น  %s ได้รับไอเท็มเริ่มต้นแล้ว {FFFFFF}| ยินดีต้อนรับสู่เซิร์ฟเวอร์ GTA UNITY TOWN", GetPlayerNameEx(playerid));
			SendClientMessage(playerid, COLOR_GREY, "|==   ยินดีต้อนรับเข้าสู่ GTA UNITY TOWN   ===|");
		}
		if (strfind(inputtext, "TOFFEE-CODE" ,true) != -1) // เปลี่ยนรหัสแอดมิน
   		{
			if (playerData[playerid][pItemcode] >= 1) //pItemcode
                return SendClientMessage(playerid, COLOR_GREY, "คุณใช้ไปแล้ว");

			playerData[playerid][pItemcode] = 1;

            playerData[playerid][pCoin] += 100;
            Inventory_Add(playerid, "กาชาผู้เล่นใหม่", 3);

			SendClientMessage(playerid, COLOR_GREY, "|========================================|");
			SendClientMessage(playerid, COLOR_GREEN, "[ของเริ่มต้น!] : {FFFFFF}คุณได้รับ coin + 100");
			SendClientMessage(playerid, COLOR_GREEN, "[ของขวัญจากท็อฟฟี่] : {FFFFFF}คุณได้รับ กาชาผู้เล่นใหม่ + 3");
 			SendClientMessage(playerid, COLOR_GREY, "|========================================|");
			SendClientMessageToAllEx(COLOR_GREEN, "[SUN-Report]: ผู้เล่น  %s ใช้งานโค้ดจากช่อง TOFFEE แล้ว", GetPlayerNameEx(playerid));
			SendClientMessage(playerid, COLOR_GREY, "|==   ยินดีต้อนรับเข้าสู่ GTA UNITY TOWN   ===|");
		}
		if (strfind(inputtext, "SUNDAY" ,true) != -1) // เปลี่ยนรหัสแอดมิน
   		{
			if (playerData[playerid][pItemcode] >= 2) //pItemcode
                return SendClientMessage(playerid, COLOR_GREY, "คุณใช้ไปแล้ว");

			playerData[playerid][pItemcode] = 2;

            playerData[playerid][pMaxItem] = 17;

			SendClientMessage(playerid, COLOR_GREY, "|========================================|");
			SendClientMessage(playerid, COLOR_SUN, "[ของขวัญจากแอดซัน] : {FFFFFF}คุณได้รับช่องกระเป๋า 17 ช่อง");
 			SendClientMessage(playerid, COLOR_GREY, "|========================================|");
			SendClientMessageToAllEx(COLOR_SUN, "[SUN-Report]: ผู้เล่น  %s ใช้งานโค้ดของแอดซันจากช่อง SUNDAY แล้ว", GetPlayerNameEx(playerid));
			SendClientMessage(playerid, COLOR_GREY, "|==   ยินดีต้อนรับเข้าสู่ GTA UNITY TOWN   ===|");
		}
	}
	return 1;
}

