static Loung[MAX_PLAYERS];

alias:Loung("ล้วง")
CMD:Loung(playerid, params[])
{
    if(IsPlayerConnected(playerid))
   	{
		new userid;
        if(sscanf(params, "ud", userid))
			return SendClientMessage(playerid, COLOR_WHITE, "/ล้วง [ไอดี/ชื่อ]");

        if(userid == INVALID_PLAYER_ID)
			return SendClientMessage(playerid, COLOR_RED, "[WARNING] {FFFFFF}ผู้เล่นไอดีนี้ไม่ได้อยู่ในเกม");

		if (!IsPlayerNearPlayer(playerid, userid, 5.0))
	    	return SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}ผู้เล่นไอดีนี้ไม่ได้อยู่ใกล้คุณ");

        if(Loung[playerid] == 1)
			return SendClientMessage(playerid, COLOR_RED, "[WARNING] {FFFFFF}คุณล้วงไปแล้ว อีก 1ชม. จะล้วงได้อีก");

        Loung[playerid] = 1;

		if (GetPlayerMoneyEx(userid) == 0)
		{
			SendClientMessageEx(playerid, COLOR_ORANGE, "[WARNING] {FFFFFF}ล้วงเงินของ %s ไม่สำเร็จ ว๊าๆๆ", GetPlayerNameEx(userid));
        	SendClientMessageEx(userid, COLOR_ORANGE, "[WARNING] {FFFFFF}คุณถูกล้วงเงินโดยใครบางคน แต่คุณโชคดีที่ไม่มีตัง หรือจนเกิ๊น");
		}
		if (GetPlayerMoneyEx(userid) < 300)
		{
			new moneyrand3 = randomEx(100, 200);
			GivePlayerMoneyEx(userid, - moneyrand3);
        	GivePlayerMoneyEx(playerid, moneyrand3);
			SendClientMessageEx(playerid, COLOR_ORANGE, "[WARNING] {FFFFFF}ล้วงเงิน $%d ของ %s สำเร็จ", moneyrand3, GetPlayerNameEx(userid));
        	SendClientMessageEx(userid, COLOR_ORANGE, "[WARNING] {FFFFFF}คุณถูกล้วงเงิน $%d โดยใครบางคน", moneyrand3);
		}
		if (GetPlayerMoneyEx(userid) < 500 && GetPlayerMoneyEx(userid) > 300)
		{
			new moneyrand3 = randomEx(100, 300);
			GivePlayerMoneyEx(userid, - moneyrand3);
        	GivePlayerMoneyEx(playerid, moneyrand3);
			SendClientMessageEx(playerid, COLOR_ORANGE, "[WARNING] {FFFFFF}ล้วงเงิน $%d ของ %s สำเร็จ", moneyrand3, GetPlayerNameEx(userid));
        	SendClientMessageEx(userid, COLOR_ORANGE, "[WARNING] {FFFFFF}คุณถูกล้วงเงิน $%d โดยใครบางคน", moneyrand3);
		}
		if (GetPlayerMoneyEx(userid) < 1000 && GetPlayerMoneyEx(userid) > 500)
		{
			new moneyrand2 = randomEx(100, 500);
			GivePlayerMoneyEx(userid, - moneyrand2);
        	GivePlayerMoneyEx(playerid, moneyrand2);
			SendClientMessageEx(playerid, COLOR_ORANGE, "[WARNING] {FFFFFF}ล้วงเงิน $%d ของ %s สำเร็จ", moneyrand2, GetPlayerNameEx(userid));
        	SendClientMessageEx(userid, COLOR_ORANGE, "[WARNING] {FFFFFF}คุณถูกล้วงเงิน $%d โดยใครบางคน", moneyrand2);
		}
		if (GetPlayerMoneyEx(userid) > 1000)
		{
			new moneyrand = randomEx(100, 1000);
			GivePlayerMoneyEx(userid, - moneyrand);
			GivePlayerMoneyEx(playerid, moneyrand);
			SendClientMessageEx(playerid, COLOR_ORANGE, "[WARNING] {FFFFFF}ล้วงเงิน $%d ของ %s สำเร็จ", moneyrand, GetPlayerNameEx(userid));
        	SendClientMessageEx(userid, COLOR_ORANGE, "[WARNING] {FFFFFF}คุณถูกล้วงเงิน $%d โดยใครบางคน", moneyrand);
		}
	}
	return 1;
}

ptask OneHour[60000*60](playerid)
{
    if (!playerData[playerid][IsLoggedIn]) return 0;
    

    Loung[playerid] = 0;
    SendClientMessage(playerid, COLOR_RED, "[WARNING] {FFFFFF}ล้วงเงินได้อีกครั้งแล้ว");

	return 1;
}

ptask FiveMin[60000*5](playerid)
{
    if (!playerData[playerid][IsLoggedIn]) return 0;
    
	UpdateplayerData(playerid);
    SendClientMessage(playerid, COLOR_RED, "[SUNDAY] {FFFFFF}ประเทศได้ทำการบันทึกข้อมูลผู้เล่นเรียบร้อย!");

	return 1;
}

CMD:mask(playerid, params[])
{
	switch (playerData[playerid][pMaskOn])
	{
		case false:
		{
		    SendNearbyMessage(playerid, 10.0, COLOR_PURPLE, "** %s ควักหน้ากากออกมาและสวมใส่มัน", GetPlayerNameEx(playerid));
		    playerData[playerid][pMaskOn] = true;

	        for(new i = 0; i < MAX_PLAYERS; i++)
	        {
	            ShowPlayerNameTagForPlayer(i, playerid, false);
	        }
		}
		case true:
		{
		    playerData[playerid][pMaskOn] = false;
		    SendNearbyMessage(playerid, 10.0, COLOR_PURPLE, "** %s หยิบหน้ากากที่สวมอยู่และนำมันออกไป", GetPlayerNameEx(playerid));

	        for(new i = 0; i < MAX_PLAYERS; i++)
	        {
	            ShowPlayerNameTagForPlayer(i, playerid, true);
	        }
		}
	}
	return 1;
}

/*
				สคริปต์พัฒนาโดย SUNDAY |หากพบสคริปต์นี้วางขายบนสื่ออนไลน์หรือเว็บไซต์ออนไลน์ โดยมีชื่อผู้ขายเป็น Sunday คือถูกต้อง
									  แต่หากชื่อผู้ขายไม่ใช่ Sunday โปรดอย่าซื้อ เราจะไม่รับผิดชอบใดๆทั้งสินหากซื้อจากผู้อื่น
*/ 



ResetPlayerPhone(playerid){
	if (OnPhone[playerid]) SvDetachSpeakerFromStream(OnPhone[playerid], playerid);
	return 1;
}

alias:rain("ฝนตก")
CMD:rain(playerid)
{
    if(playerData[playerid][pAdmin] < 1)
        return SendClientMessage(playerid, COLOR_LIGHTRED, "คุณไม่ใช่แอดมิน");

  	new randomrain = randomEx(0,200);
	if(randomrain >= 50 && randomrain <= 100)
	{
		switch(random(3))
		{
			case 0:
			{
				SetWeather(32);
				SendClientMessageToAll(COLOR_RED, "[Future News]: ญ: ขณะนี้หมอกลงอย่างหนัก ไม่ทราบสาเหตุ โปรดระมัดระวังในการใช้ชีวิตกันด้วยนะคะ");
				SendClientMessageToAll(COLOR_RED, "[Future News]: ช: ทราบว่า หมอกลงทั่วประเทศ GTA UNITY ถือว่าเป็นปรากฏการณ์ธรรมชาติที่พบเห็นได้ยากในรอบล้านปี");
				SendClientMessageToAll(COLOR_RED, "[Future News]: ช: แต่ไม่ทราบว่าจะมีผลเสียต่อมนุษยชนหรือไม่ ก็ให้ระมัดระวังตัวใครตัวมันนะครับ");
				SendClientMessageToAll(COLOR_RED, "[Future News]: ญ: ขฯะนี้ถึงเวลาแล้ว Future News รายงาน");
				SendClientMessageToAll(COLOR_RED, "[Future News]: ช&ญ: สวัสดีค่ะ/ครับ");
				SetTimer("OffRainAuto", 1200000, false);
			}
			case 1:
			{
				SetWeather(16);
				SendClientMessageToAll(COLOR_RED, "[Future News]: ญ: ขณะนี้ฝนตกหนักทั่วประเทศ โปรดระมัดระวังการใช้รถใช้ถนนกันด้วยนะคะ");
				SendClientMessageToAll(COLOR_RED, "[Future News]: ช: ระวังน้ำท่วม ดินถล่ม กันด้วยนะครับ");
				SendClientMessageToAll(COLOR_RED, "[Future News]: ช: ช่วงนี้ฝนไม่ค่อยตกต้องตามฤดูกาล ระมัดระวังตัวใครตัวมันนะครับ");
				SendClientMessageToAll(COLOR_RED, "[Future News]: ญ: ขณะนี้ถึงเวลาแล้ว Future News รายงาน");
				SendClientMessageToAll(COLOR_RED, "[Future News]: ช&ญ: สวัสดีค่ะ/ครับ");
				SetTimer("OffRainAuto", 1200000, false);
			}
			case 2:
			{
				foreach (new i : Player)
				{
		     		SetPlayerAttachedObject(i, 3, 18863, 1, 14.877702, -3.078147, 19.289804, 213.993621, 36.619785, 334.528167 );
		    	}

            	SetWeather(9);

				SendClientMessageToAll(COLOR_RED, "[Future News]: ญ: ขณะนี้หิมะตกทั่วทุกเมืองของงประเทศ GTA UNITY ของเรานะคะ");
				SendClientMessageToAll(COLOR_RED, "[Future News]: ช: ช่วงนี้ก็จะหนาวเป็นพิเศษนะครับ ใครมีบุตรเล็ก ก็ไปซื้อเสื้อผ้าหนาๆมาให้สวมใส่กันด้วยนะครับ");
				SendClientMessageToAll(COLOR_RED, "[Future News]: ช: ช่วงนี้นะครับ รัฐบาลก็เตรียมทำถ่านขาย สามารถสั่งซื้อได้ที่ ww.prayud.com นะครับ ให้ซานต้าไปส่งถึงที่ กระสอบละ 100เท่านั้นครับ");
				SendClientMessageToAll(COLOR_RED, "[Future News]: ญ: ขฯะนี้ถึงเวลาแล้ว Future News รายงาน");
				SendClientMessageToAll(COLOR_RED, "[Future News]: ช&ญ: สวัสดีค่ะ/ครับ");
				SetTimer("OffRainAuto", 1200000, false);
			}
		}
	}
    return 1;
}

alias:clearrain("หยุดฝน")
CMD:clearrain(playerid)
{
    if(playerData[playerid][pAdmin] < 1)
        return SendClientMessage(playerid, COLOR_LIGHTRED, "คุณไม่ใช่แอดมิน");

   	foreach (new i : Player)
	{
		RemovePlayerAttachedObject(i, 3);
	}
    SendClientMessageToAll(COLOR_RED, "[Future News]: ญ: ขณะนี้สภาพบัญญากาศในประเทศกลับมาสดใสเหมือนเดิมแล้วนะคะ");
	SendClientMessageToAll(COLOR_RED, "[Future News]: ช: จะได้เจอแดดกันสักทีแล้วนะครับ 555");
	SendClientMessageToAll(COLOR_RED, "[Future News]: ญ: ค่ะ");
	SendClientMessageToAll(COLOR_RED, "[Future News]: ญ: ขณะนี้ถึงเวลาแล้ว Future News รายงาน");
	SendClientMessageToAll(COLOR_RED, "[Future News]: ช&ญ: สวัสดีค่ะ/ครับ");

	SetWeather(globalWeather);

    return 1;
}

