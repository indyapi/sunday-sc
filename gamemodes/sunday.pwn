{
	isFuelcar[playerid] = 0;
	ClearAnimations(playerid);

	TogglePlayerControllable(playerid, true);

	new vehicleid = Vehicle_Nearest(playerid) && GetVehicleModel(GetPlayerVehicleID(playerid));

	vehicleFuel[vehicleid] += 30;
	SendClientMessage(playerid, COLOR_WHITE, "คุณเติมน้ำมันรถสำเร็จ.");
