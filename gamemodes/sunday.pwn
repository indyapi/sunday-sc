Dialog:DIALOG_EDITWP1(playerid, response, listitem, inputtext[])
{
	new factionid = playerData[playerid][pFactionEdit];
	new number;

	if (factionid == -1)
	    return 0;

	if (response)
	{
		if(sscanf(inputtext, "i", number)) return Dialog_Show(playerid, DIALOG_EDITWP1, DIALOG_STYLE_INPUT, "[ตู้เก็บอาวุธ]", "** เฉพาะตัวเลขเท่านั้น!\nกรุณาใส่เลขอาวุธที่ต้องการลงไป", "ตกลง", "ออก");
		factionData[factionid][factionWeapons][0] = number;
		Faction_Save(factionid);
		Dialog_Show(playerid, DIALOG_EDITWP, DIALOG_STYLE_LIST, "[ตู้เก็บอาวุธ]", "อาวุธหมายเลข (%d)\nอาวุธหมายเลข (%d)\nอาวุธหมายเลข (%d)\nอาวุธหมายเลข (%d)\nอาวุธหมายเลข (%d)\nอาวุธหมายเลข (%d)\nอาวุธหมายเลข (%d)\nอาวุธหมายเลข (%d)\nอาวุธหมายเลข (%d)\nอาวุธหมายเลข (%d)", "ตกลง", "ออก",
		factionData[factionid][factionWeapons][0],
		factionData[factionid][factionWeapons][1],
		factionData[factionid][factionWeapons][2],
		factionData[factionid][factionWeapons][3],
		factionData[factionid][factionWeapons][4],
		factionData[factionid][factionWeapons][5],
		factionData[factionid][factionWeapons][6],
		factionData[factionid][factionWeapons][7],
		factionData[factionid][factionWeapons][8],
		factionData[factionid][factionWeapons][9]);
	}
	return 1;
}

