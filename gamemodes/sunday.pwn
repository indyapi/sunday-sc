			if (playerData[playerid][pRemingtontune] == 0)
			    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณไม่มีรถรุ่น Remington");

			playerData[playerid][pRemingtontune] = 0;
			playerData[userid][pRemingtontune] = 1;

			name = "Remington";
		}
	}

	SendClientMessageEx(playerid, COLOR_LIGHTBLUE, "* คุณได้ให้รถรุ่น %s แต่งเรียบร้อยแล้วกับ %s", name, GetPlayerNameEx(userid));
	SendClientMessageEx(userid, COLOR_LIGHTBLUE, "* คุณได้รับรถรุ่น %s แต่งเรียบร้อยแล้วจาก %s", name, GetPlayerNameEx(playerid));

	return 1;
