alias:givecar("ให้รถ")
CMD:givecar(playerid, params[])
{
	new userid, type, amount, name[24];

	if (sscanf(params, "udd", userid, type, amount))
	{
		SendClientMessage(playerid, COLOR_GREY, "การใช้งาน : {FFFFFF}/givecar [ไอดี/ชื่อ] [รายการ]");
		SendClientMessage(playerid, COLOR_YELLOW, "[รายการ] : {FFFFFF}1: Elegy | 2: Flash | 3: Sultan | 4: Jester | 5: Phoenix | 6: Cheetah");
		SendClientMessage(playerid, COLOR_YELLOW, "[รายการ] : {FFFFFF}7: Uranus | 8: Slamvan | 9: Stratum | 10: Broadway | 11: Remington");
		return 1;
	}
	if (type < 1 || type > 11)
	{
	    SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}รายการต้องไม่ต่ำกว่า 1 และไม่เกิน 11 เท่านั้น");
	    return 1;
	}
	switch(type)
	{
	    case 1:
	    {
			if (playerData[playerid][pElegy] == 0)
			    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณไม่มีรถรุ่น Elegy");
	    
			playerData[playerid][pElegy] = 0;
			playerData[userid][pElegy] = 1;
			
			name = "Elegy";
		}
	    case 2:
	    {
			if (playerData[playerid][pFlash] == 0)
			    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณไม่มีรถรุ่น Flash");

			playerData[playerid][pFlash] = 0;
			playerData[userid][pFlash] = 1;

			name = "Flash";
		}
	    case 3:
	    {
			if (playerData[playerid][pSultantuning] == 0)
			    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณไม่มีรถรุ่น Sultan");

			playerData[playerid][pSultantuning] = 0;
			playerData[userid][pSultantuning] = 1;

			name = "Sultan";
		}
	    case 4:
	    {
			if (playerData[playerid][pJester] == 0)
			    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณไม่มีรถรุ่น Jester");

			playerData[playerid][pJester] = 0;
			playerData[userid][pJester] = 1;

			name = "Jester";
		}
	    case 5:
	    {
			if (playerData[playerid][pPhoenix] == 0)
			    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณไม่มีรถรุ่น Phoenix");

			playerData[playerid][pPhoenix] = 0;
			playerData[userid][pPhoenix] = 1;

			name = "Phoenix";
		}
	    case 6:
	    {
			if (playerData[playerid][pCheetah] == 0)
			    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณไม่มีรถรุ่น Cheetah");

			playerData[playerid][pCheetah] = 0;
			playerData[userid][pCheetah] = 1;

			name = "Cheetah";
		}
	    case 7:
	    {
			if (playerData[playerid][pUranus] == 0)
			    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณไม่มีรถรุ่น Uranus");

			playerData[playerid][pUranus] = 0;
			playerData[userid][pUranus] = 1;

			name = "Uranus";
		}
	    case 8:
	    {
			if (playerData[playerid][pSlamvantune] == 0)
			    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณไม่มีรถรุ่น Slamvan");

			playerData[playerid][pSlamvantune] = 0;
			playerData[userid][pSlamvantune] = 1;

			name = "Slamvan";
		}
	    case 9:
	    {
			if (playerData[playerid][pStratum] == 0)
			    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณไม่มีรถรุ่น Stratum");

			playerData[playerid][pStratum] = 0;
			playerData[userid][pStratum] = 1;

			name = "Stratum";
		}
	    case 10:
	    {
			if (playerData[playerid][pBroadway] == 0)
			    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณไม่มีรถรุ่น Broadway");

			playerData[playerid][pBroadway] = 0;
			playerData[userid][pBroadway] = 1;

