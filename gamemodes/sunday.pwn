forward SmokeWeed5(playerid);
public SmokeWeed5(playerid)
{
    SetPlayerAttachedObject(playerid, 4, 18687, 2, 0.012896, 0.179381, -1.588311, 0.000000, 0.000000, 0.000000, 1.000000, 1.000000, 1.000000 ); //
	SetTimerEx("SmokeWeed8", 2000, false, "d", playerid);
}

forward SmokeWeed8(playerid);
public SmokeWeed8(playerid)
{
    RemovePlayerAttachedObject(playerid, 4);
	ClearAnimations(playerid);
	TogglePlayerControllable(playerid, 1);
	//SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
}

ptask CraftTimer[1000](playerid)
{
	new string[256];

	playerData[playerid][pItemAmount] = 50;

    foreach (new i : Player)
    {
		new idz = -1;
		if ((idz = Boombox_Nearest(i)) != INVALID_PLAYER_ID && playerData[i][pBoombox] != idz && strlen(BoomboxData[idz][boomboxURL]) && !IsPlayerInAnyVehicle(i))
		{
		    new str[128];
		    strunpack(str, BoomboxData[idz][boomboxURL]);
		    playerData[i][pBoombox] = idz;

		    //StopAudioStreamForPlayer(i);
		    PlayAudioStreamForPlayer(i, str, BoomboxData[idz][boomboxPos][0], BoomboxData[idz][boomboxPos][1], BoomboxData[idz][boomboxPos][2], 30.0, 1);
		}
		else if (playerData[i][pBoombox] != INVALID_PLAYER_ID && !IsPlayerInRangeOfPoint(i, 30.0, BoomboxData[playerData[i][pBoombox]][boomboxPos][0], BoomboxData[playerData[i][pBoombox]][boomboxPos][1], BoomboxData[playerData[i][pBoombox]][boomboxPos][2]))
		{
		    playerData[i][pBoombox] = INVALID_PLAYER_ID;
		    StopAudioStreamForPlayer(i);
		}
	}

    if (playerData[playerid][pCuffed])
    {
	    TogglePlayerControllable(playerid, false);
	    SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CUFFED);

        ApplyAnimation(playerid, "ped", "cower", 3.0, 1, 0, 0, 0, 0);
    }

    if (GetPlayerWantedLevelEx(playerid) > 0)
    {
		SetPlayerWantedLevel(playerid, GetPlayerWantedLevelEx(playerid));
	}

	// ชื่อแก๊ง
	if (playerData[playerid][pFaction] != -1)
	{
	    if (playerData[playerid][pMarryOn] == 0)
	    {
			format(string, sizeof(string), "{%06x}%s", factionData[playerData[playerid][pFaction]][factionColor] >>> 8, Faction_GetName(playerid));
			SetPlayerChatBubble(playerid,string,COLOR_RED,7.0,1500);
		}
		else
		{
			format(string, sizeof(string), "{F60661}[แต่งงานแล้ว]\n{%06x}%s", factionData[playerData[playerid][pFaction]][factionColor] >>> 8, Faction_GetName(playerid));
			SetPlayerChatBubble(playerid,string,COLOR_RED,7.0,1500);
		}
	}

	// -- ผู้เล่นใหม่
	if (GetPlayerWantedLevelEx(playerid) > 0)
	{
		format(string, sizeof(string), "{BF0202}[{F74242}ความต้องการตัว : %d ดาว{BF0202}]\n{FFFFFF}[รออีก %d/200 วินาทีถึงจะลดดาว]",GetPlayerWantedLevelEx(playerid), playerData[playerid][pWantedTime]);
		SetPlayerChatBubble(playerid,string,COLOR_RED,10.0,1500);
	}
	
	new Float:hp, Float:armour;
	GetPlayerHealth(playerid, hp);
	GetPlayerArmour(playerid, armour);



	if (Inventory_Count(playerid, "โคเคน") == 0) Inventory_Remove(playerid, "โคเคน");
	if (Inventory_Count(playerid, "กัญชา") == 0) Inventory_Remove(playerid, "กัญชา");
	if (Inventory_Count(playerid, "ปูน") == 0) Inventory_Remove(playerid, "ปูน");

	// กินเหล้า
    if (RegencyUse[playerid] == 1)
    {
        ApplyAnimation(playerid,"BAR", "dnk_stndF_loop",4.1, 0, 0, 0, 0, 0, 0);
		warPoints[playerid] += 5;

		format(string, sizeof(string), "~n~~n~~n~~r~Drink Regency : ~w~%d/100", warPoints[playerid]);
		GameTextForPlayer(playerid,  string, 2000, 5);

		if (warPoints[playerid] >= 100)
		{
            RegencyUse[playerid] = 0;
            warPoints[playerid] = 0;

	        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_DRINK_SPRUNK);
	        SetPlayerDrunkLevel(playerid, 10000);

	        ApplyAnimation(playerid, "PED", "WALK_drunk", 4.1, 1, 1, 1, 1, 1, 1);
	        Inventory_Remove(playerid, "Regency", 1);

	        SendClientMessage(playerid, COLOR_WHITE, "คุณกำลังดื่ม {00FF00}Regency");
	        TogglePlayerControllable(playerid, true);

	        SetTimerEx("UnRegency", 30000, false, "d", playerid);
		}
    }

	// กินยา
    if (DrugActive[playerid] == 1)
    {
        ApplyAnimation(playerid,"FOOD", "EAT_Burger",4.1, 0, 0, 0, 0, 0, 0);
		warPoints[playerid] += 10;

		format(string, sizeof(string), "~n~~n~~n~~b~Drug Active : ~w~%d/100", warPoints[playerid]);
		GameTextForPlayer(playerid,  string, 2000, 5);

		if (warPoints[playerid] >= 100)
		{
            DrugActive[playerid] = 0;
            warPoints[playerid] = 0;

//			new Float: hp;
			GetPlayerHealth(playerid, hp);

			Inventory_Remove(playerid, "กล่องยา", 1);
			SendClientMessage(playerid, COLOR_GREEN, "[กล่องยา] : คุณได้ใช้ 'กล่องยา' เสร็จเรียบร้อยแล้ว!");

			SetPlayerHealth(playerid, hp + 50.0);

			if (hp > 100.0)
	    		SetPlayerHealth(playerid, 100.0);
	    		
            TogglePlayerControllable(playerid, true);
		}
    }

	// บุหรี่
    if (RegencyUse[playerid] == 2)
    {
        ApplyAnimation(playerid,"SMOKING", "M_smklean_loop",4.1, 0, 0, 0, 0, 0, 0);
		warPoints[playerid] += 5;

		format(string, sizeof(string), "~n~~n~~n~~b~Smoke : ~w~%d/100", warPoints[playerid]);
		GameTextForPlayer(playerid,  string, 2000, 5);
		
		if (warPoints[playerid] >= 100)
		{
            RegencyUse[playerid] = 0;
            warPoints[playerid] = 0;

		    SetTimerEx("SmokeWeed5", 2000, false, "d", playerid);
			Inventory_Remove(playerid, "บุหรี่", 1);
		    SendClientMessage(playerid, COLOR_WHITE, "คุณกำลังสูบ {00FF00}บุหรี่");
		    
		    SetPlayerSpecialAction(playerid, SPECIAL_ACTION_SMOKE_CIGGY);
		    TogglePlayerControllable(playerid, true);
		}
    }


	// ยึดฐานทัพเรือนาวิกโยธิน
   /* if (TakeWarStats[playerid] == 1)
    {
		warPoints[playerid] += 5;
		ApplyAnimation(playerid,"BD_FIRE","wash_up",4.1, 0, 0, 0, 0, 0, 0);

		format(string, sizeof(string), "~b~WAR TAKE : ~w~%d/100", warPoints[playerid]);
		GameTextForPlayer(playerid,  string, 2000, 5);

		if (warPoints[playerid] >= 100)
		{
		    new factionid = playerData[playerid][pFaction];
		
            TakeWarStats[playerid] = 0;
            warPoints[playerid] = 0;
            
            NavikColor = factionData[factionid][factionColor];
            NavikStats = 0;
            NavikCooldown = 300;
            TogglePlayerControllable(playerid, true);

			SendClientMessageToAllEx(COLOR_GREEN, "ฐานทัพเรือนาวิก > %s จากแก๊ง %s ได้ทำการยึดฐานทัพเรือแล้ว!", GetPlayerNameEx(playerid), factionData[factionid][factionName]);
		}
    }

	// ยึดสนามบินร้าง
    if (TakeWarStats[playerid] == 2)
    {
		warPoints[playerid] += 5;
		ApplyAnimation(playerid,"BD_FIRE","wash_up",4.1, 0, 0, 0, 0, 0, 0);

		format(string, sizeof(string), "~b~WAR TAKE : ~w~%d/100", warPoints[playerid]);
		GameTextForPlayer(playerid,  string, 2000, 5);

		if (warPoints[playerid] >= 100)
		{
		    new factionid = playerData[playerid][pFaction];

            TakeWarStats[playerid] = 0;
            warPoints[playerid] = 0;

