forward CheckFaction(playerid, userid);
public CheckFaction(playerid, userid)
{
    new count = 0;
    new rows = cache_num_rows();

	for(new i = 0; i < rows; i ++)
	{
		count++;
	}
	if (count >= factionData[playerData[playerid][pFaction]][factionMax])
		return SendClientMessageEx(playerid, COLOR_LIGHTRED, "กลุ่มของคุณมีจำนวนสมาชิกสูงสุดแล้ว! [%d/%d]", count, factionData[playerData[playerid][pFaction]][factionMax]);

	playerData[userid][pFactionOffer] = playerid;
    playerData[userid][pFactionOffered] = playerData[playerid][pFaction];

    SendClientMessageEx(playerid, COLOR_WHITE, "คุณได้ส่งคำขอให้ {33CCFF}%s {FFFFFF}ในการเข้าร่วมกลุ่ม \"%s\"", GetPlayerNameEx(userid), Faction_GetName(playerid));
    SendClientMessageEx(userid, COLOR_LIGHTBLUE, "%s {FFFFFF}ได้ส่งคำขอให้คุณในการเข้าร่วมกลุ่ม \"%s\" (พิมพ์ \"/ยอมรับ apply\" ในการตอบข้อเสนอ)", GetPlayerNameEx(playerid), Faction_GetName(playerid));

	return 1;
}

