Dialog:DIALOG_HOUSE_2(playerid, response, listitem, inputtext[])
{
	new amount = strval(inputtext);
	if(response)
	{
		switch(storageType[playerid])
		{
			case 0:
			{
			    if (amount <= 0)
			        return SendClientMessage(playerid, -1, "* คุณต้องระบุจำนวนมากกว่า 0");

			    if (Inventory_Count(playerid, "กัญชา") < amount)
			        return SendClientMessage(playerid, -1, "* คุณไม่มีกัญชา");

				new id;
				if (!IsPlayerInAnyVehicle(playerid) && (id = (House_Inside(playerid) == -1) ? (House_Nearest(playerid)) : (House_Inside(playerid))) != -1 && House_IsOwner(playerid, id))
				{
				    Inventory_Remove(playerid, "กัญชา", amount);
				    HouseData[id][houseCannabis] += amount;
				    House_Save(id);
				    storageType[playerid] = -1;

				    SendClientMessageEx(playerid, COLOR_YELLOW, "* คุณได้ฝาก 'กัญชา' เข้าบ้านจำนวน %d", amount);
				}
				return 1;
			}
			case 1:
			{
			    if (amount <= 0)
			        return SendClientMessage(playerid, -1, "* คุณต้องระบุจำนวนมากกว่า 0");

			    if (Inventory_Count(playerid, "โคเคน") < amount)
			        return SendClientMessage(playerid, -1, "* คุณไม่มีโคเคน");

				new id;
				if (!IsPlayerInAnyVehicle(playerid) && (id = (House_Inside(playerid) == -1) ? (House_Nearest(playerid)) : (House_Inside(playerid))) != -1 && House_IsOwner(playerid, id))
				{
				    Inventory_Remove(playerid, "โคเคน", amount);
				    HouseData[id][houseCocain] += amount;
				    House_Save(id);
				    storageType[playerid] = -1;

				    SendClientMessageEx(playerid, COLOR_YELLOW, "* คุณได้ฝาก 'โคเคน' เข้าบ้านจำนวน %d", amount);
				}
				return 1;
			}
			case 2:
			{
			    if (amount <= 0)
			        return SendClientMessage(playerid, -1, "* คุณต้องระบุจำนวนมากกว่า 0");

			    if (Inventory_Count(playerid, "ปูน") < amount)
			        return SendClientMessage(playerid, -1, "* คุณไม่มีปูน");

				new id;
				if (!IsPlayerInAnyVehicle(playerid) && (id = (House_Inside(playerid) == -1) ? (House_Nearest(playerid)) : (House_Inside(playerid))) != -1 && House_IsOwner(playerid, id))
				{
				    Inventory_Remove(playerid, "ปูน", amount);
				    HouseData[id][housePoon] += amount;
				    House_Save(id);
				    storageType[playerid] = -1;

				    SendClientMessageEx(playerid, COLOR_YELLOW, "* คุณได้ฝาก 'ปูน' เข้าบ้านจำนวน %d", amount);
				}
				return 1;
			}
			case 3:
			{
			    if (amount <= 0)
			        return SendClientMessage(playerid, -1, "* คุณต้องระบุจำนวนมากกว่า 0");

			    if (Inventory_Count(playerid, "แพ็คยาบ้า") < amount)
			        return SendClientMessage(playerid, -1, "* คุณไม่มีแพ็คยาบ้า");

				new id;
				if (!IsPlayerInAnyVehicle(playerid) && (id = (House_Inside(playerid) == -1) ? (House_Nearest(playerid)) : (House_Inside(playerid))) != -1 && House_IsOwner(playerid, id))
				{
				    Inventory_Remove(playerid, "แพ็คยาบ้า", amount);
				    HouseData[id][houseDrug] += amount;
				    House_Save(id);
				    storageType[playerid] = -1;

				    SendClientMessageEx(playerid, COLOR_YELLOW, "* คุณได้ฝาก 'แพ็คยาบ้า' เข้าบ้านจำนวน %d", amount);
				}
				return 1;
			}
			case 4:
			{
			    if (amount <= 0)
			        return SendClientMessage(playerid, -1, "* คุณต้องระบุจำนวนมากกว่า 0");

			    if (GetPlayerMoneyEx(playerid) < amount)
			        return SendClientMessage(playerid, -1, "* คุณไม่มีเงินเขียวมากพอ!");

				new id;
				if (!IsPlayerInAnyVehicle(playerid) && (id = (House_Inside(playerid) == -1) ? (House_Nearest(playerid)) : (House_Inside(playerid))) != -1 && House_IsOwner(playerid, id))
				{
				    GivePlayerMoneyEx(playerid, -amount);
				    HouseData[id][houseMoney] += amount;
				    House_Save(id);
				    storageType[playerid] = -1;

				    SendClientMessageEx(playerid, COLOR_YELLOW, "* คุณได้ฝาก 'เงินเขียว' เข้าบ้านจำนวน $%d", amount);
				}
				return 1;
			}
			case 5:
			{
			    if (amount <= 0)
			        return SendClientMessage(playerid, -1, "* คุณต้องระบุจำนวนมากกว่า 0");

			    if (playerData[playerid][pRedMoney] < amount)
			        return SendClientMessage(playerid, -1, "* คุณไม่มีเงินแดงมากพอ!");

				new id;
				if (!IsPlayerInAnyVehicle(playerid) && (id = (House_Inside(playerid) == -1) ? (House_Nearest(playerid)) : (House_Inside(playerid))) != -1 && House_IsOwner(playerid, id))
				{
				    playerData[playerid][pRedMoney] -= amount;
				    HouseData[id][houseRedMoney] += amount;
				    House_Save(id);
				    storageType[playerid] = -1;

				    SendClientMessageEx(playerid, COLOR_YELLOW, "* คุณได้ฝาก 'เงินแดง' เข้าบ้านจำนวน $%d", amount);
				}
				return 1;
			}
			case 6:
			{
			    if (amount <= 0)
			        return SendClientMessage(playerid, -1, "* คุณต้องระบุจำนวนมากกว่า 0");

			    if (Inventory_Count(playerid, "แพ็คกัญชา") < amount)
			        return SendClientMessage(playerid, -1, "* คุณไม่มีแพ็คกัญชา");

				new id;
				if (!IsPlayerInAnyVehicle(playerid) && (id = (House_Inside(playerid) == -1) ? (House_Nearest(playerid)) : (House_Inside(playerid))) != -1 && House_IsOwner(playerid, id))
				{
				    Inventory_Remove(playerid, "แพ็คกัญชา", amount);
				    HouseData[id][housePackWeed] += amount;
				    House_Save(id);
				    storageType[playerid] = -1;

				    SendClientMessageEx(playerid, COLOR_YELLOW, "* คุณได้ฝาก 'แพ็คกัญชา' เข้าบ้านจำนวน %d", amount);
				}
				return 1;
			}
			case 7:
			{
			    if (amount <= 0)
			        return SendClientMessage(playerid, -1, "* คุณต้องระบุจำนวนมากกว่า 0");

			    if (Inventory_Count(playerid, "แพ็คโคเคน") < amount)
			        return SendClientMessage(playerid, -1, "* คุณไม่มีแพ็คโคเคน");

				new id;
				if (!IsPlayerInAnyVehicle(playerid) && (id = (House_Inside(playerid) == -1) ? (House_Nearest(playerid)) : (House_Inside(playerid))) != -1 && House_IsOwner(playerid, id))
				{
				    Inventory_Remove(playerid, "แพ็คโคเคน", amount);
				    HouseData[id][housePackCocain] += amount;
				    House_Save(id);
				    storageType[playerid] = -1;

				    SendClientMessageEx(playerid, COLOR_YELLOW, "* คุณได้ฝาก 'แพ็คโคเคน' เข้าบ้านจำนวน %d", amount);
				}
				return 1;
			}
		}
	}
	return 1;
}

