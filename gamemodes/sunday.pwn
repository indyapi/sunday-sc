		format(string, sizeof(string), "~r~Stadium Take : ~w~%d/100", warPoints[playerid]);
		GameTextForPlayer(playerid,  string, 2000, 5);

		if (warPoints[playerid] >= 100)
		{
		    new factionid = playerData[playerid][pFaction];

            TakeWarStats[playerid] = 0;
            warPoints[playerid] = 0;

            StadiumColor = factionData[factionid][factionColor];
            StadiumStats = 0;
            StadiumCooldown = 300;
            TogglePlayerControllable(playerid, true);

			SendClientMessageToAllEx(COLOR_RED, "Staidum > %s จากแก๊ง %s ได้ทำการยึด Stadium แล้ว!", GetPlayerNameEx(playerid), factionData[factionid][factionName]);
		}
    }*/

	//

	if (isRepairVehicle[playerid] == 1)
	{
		repairPoints[playerid] += 5;

		format(string, sizeof(string), "~r~Repair Car : ~w~%d/100", repairPoints[playerid]);
		GameTextForPlayer(playerid,  string, 2000, 5);

		if (repairPoints[playerid] >= 100)
		{
            isRepairVehicle[playerid] = 0;
            repairPoints[playerid] = 0;

			new Float:oX, Float:oY, Float:oZ, Float:rX, Float:rY, Float:rZ;

			GetDynamicObjectPos(TuningGate, oX, oY, oZ);
			GetDynamicObjectRot(TuningGate, rX, rY, rZ);

			MoveDynamicObject(TuningGate, oX, oY, oZ - 2.0, 1.0, rX, rY, rZ);
            RepairVehicleAr(GetPlayerVehicleID(playerid));
            SendClientMessage(playerid, COLOR_YELLOW, "* คุณประสบความสำเร็จในการซ่อมรถแล้ว");
            TogglePlayerControllable(playerid, 1);

            TuningStats = 0;
		}
		return 1;
	}

	//

	if (isStartCraft[playerid] == 1)
	{
		isCraftPoints[playerid] += 5;
		ApplyAnimation(playerid,"BD_FIRE","wash_up",4.1, 0, 0, 0, 0, 0, 0);

		format(string, sizeof(string), "~b~Craft Weapon : ~w~%d/100", isCraftPoints[playerid]);
		GameTextForPlayer(playerid,  string, 2000, 5);

		if (isCraftPoints[playerid] >= 100)
		{
            isStartCraft[playerid] = 0;
            isCraftPoints[playerid] = 0;

			switch (CraftTypeLast[playerid])
