Dialog:DIALOG_VIP(playerid, response, listitem, inputtext[])
{
	if(response)
	{
		switch(listitem)
  		{
			case 0:
			{
				if (playerData[playerid][pCoin] < 100)
				    return SendClientMessage(playerid, COLOR_RED, "คุณมี Coin ไม่เพียงพอ (100 Coin)");

                playerData[playerid][pCoin] -= 100;
				playerData[playerid][pVip] = 1;
				playerData[playerid][pMaxItem] = 20;
				playerData[playerid][pVipTime] = 30.0;

                SendClientMessage(playerid, COLOR_GREEN, "|===============================|");
