Dialog:DIALOG_MEC_CRAFT(playerid, response, listitem, inputtext[])
{
    if(response)
	{
	    switch(listitem)
		{
	        case 0:
			{
                Dialog_Show(playerid, DIALOG_MEC_CRAFT1, DIALOG_STYLE_MSGBOX,
				"{767272}[ MEC - กล่องซ่อม ]",
				"{FFC133}[-------------------]\n\
				 {FFC133}แร่เฮมาไทต์ 30 ก้อน\n\
				 {FFC133}แร่เหล็ก 5 ก้อน\n\
				 {FFC133}[-------------------]",
				 "Craft", "Close");
			}
			case 1:
			{
                Dialog_Show(playerid, DIALOG_MEC_CRAFT2, DIALOG_STYLE_MSGBOX,
				"{767272}[ MEC - ถังน้ำมัน ]",
				"{FFC133}[-------------------]\n\
				 {FFC133}ท่อนซุง 20 ท่อน\n\
				 {FFC133}แร่เหล็ก 5 ก้อน\n\
				 {FFC133}[-------------------]",
				 "Craft", "Close");
			}
  		}
	}
}

Dialog:DIALOG_MEC_CRAFT1(playerid, response, listitem, inputtext[])
{
    if(response)
	{
	    switch(random(10))
		{
	        case 0..10:
			{
                if(Inventory_Count(playerid, "แร่เฮมาไทต์") < 30)
                    return SendClientMessageEx(playerid, COLOR_LIGHTRED, "[MEC-Craft] ต้องการแร่เฮมาไทต์ 30 ก้อน [ มีอยู่ %d ]", Inventory_HasItem(playerid, "แร่เฮมาไทต์"));

                if(Inventory_Count(playerid, "แร่เหล็ก") < 5)
                    return SendClientMessageEx(playerid, COLOR_LIGHTRED, "[MEC-Craft] ต้องการแร่เหล็ก 5 ก้อน [ มีอยู่ %d ]", Inventory_HasItem(playerid, "แร่เหล็ก"));

			    if (playerData[playerid][pRunBar] != 0)
			        return SendClientMessage(playerid, COLOR_LIGHTRED, "[MEC-Craft] กำลังคราฟ....");

				ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.0, 1, 0, 0, 0, 0, 1);
				playerData[playerid][pRunBar] = 1;
				StartProgress(playerid, 100, 0, INVALID_OBJECT_ID);
				TogglePlayerControllable(playerid, false);
			}
  		}
	}
	return 1;
}

