alias:menu("เมนู")
CMD:menu(playerid, params[])
{
    if (playerData[playerid][pJailTime] > 0)
        return SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}คุณติดคุกอยู่ ไม่สามารถเปิดกระเป๋าได้");

    if (playerData[playerid][pCuffed] > 0)
        return SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}คุณถูกจับอยู่ ไม่สามารถเปิดกระเป๋าได้");


	new string100[512];
	new string2[512];

	format(string100, sizeof(string100), "{FFFFFF}[{38FAA8}+{FFFFFF}] สถานะตัวละคร\n");
	strcat(string2,string100);

	format(string100, sizeof(string100), "{FFFFFF}[{38FAA8}+{FFFFFF}] กระเป๋าเก็บของ\n");
	strcat(string2,string100);

	format(string100, sizeof(string100), "{FFFFFF}[{38FAA8}+{FFFFFF}] {38FAA8}ร้านค้าโดเนท\n");
	strcat(string2,string100);

	format(string100, sizeof(string100), "{FFFFFF}[{38FAA8}+{FFFFFF}] GPS นำทาง\n");
	strcat(string2,string100);

	Dialog_Show(playerid,HelpMenu,DIALOG_STYLE_LIST,"{FFFFFF}[{73FA38}เมนูอำนวยความสะดวก{FFFFFF}]",string2,"ตกลง","ยกเลิก");
	return 1;
}

Dialog:DIALOG_CRAFT_2(playerid, response, listitem, inputtext[])
{
	if(response)
	{
		switch (listitem)
		{
			case 0: //
			{
				if (GetPlayerMoneyEx(playerid) < 10000)
    				return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณมีเงินไม่เพียงพอ ($10,000)");

				if (playerData[playerid][pRedMoney] < 5000)
					return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณมีเงินไม่เพียงพอ ($5,000)");

                CraftTypeLast[playerid] = 0;

				isStartCraft[playerid] = 1;
				isCraftPoints[playerid] = 0;

				SendClientMessage(playerid, COLOR_LIGHTBLUE, "* คุณกำลังเริ่มต้นการสร้างอาวุธ ...");
				return 1;
			}

			case 1: //
			{
				if (GetPlayerMoneyEx(playerid) < 11000)
    				return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณมีเงินไม่เพียงพอ ($11,000)");

				if (playerData[playerid][pRedMoney] < 5500)
					return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณมีเงินไม่เพียงพอ ($5,500)");

