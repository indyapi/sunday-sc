Dialog:DIALOG_BUYFOOD(playerid, response, listitem, inputtext[])
{
	if (response)
	{
		switch(listitem)
		{
		    case 0..7:
		    {
		        itemType[playerid] = listitem;
				Dialog_Show(playerid, DIALOG_BUYFOOD2, DIALOG_STYLE_INPUT, "[จำนวนที่ต้องการ]", "{FFFFFF}กรอกจำนวนที่จะซื้อ", "ยืนยัน", "ยกเลิก");
		    }
		}
	}
	return 1;
}

