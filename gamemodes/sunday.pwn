// --> เรียกดาบไฟ
alias:weaponfire("ดาบไฟ")
CMD:weaponfire(playerid, params[])
{
	if (playerData[playerid][pKatanaDamage] == 0)
	    return SendClientMessage(playerid, COLOR_GREY, "คุณยังไม่มีดาบไฟ");

	if (KatanaUse[playerid] == 0)
	{
		GivePlayerWeaponEx(playerid, 8, 1);
		SetPlayerAttachedObject(playerid,4,19590,6,0.051999,0.008000,-0.140000,-81.599990,-72.900032,6.100000,2.805999,1.699999,1.065999);
		SetPlayerAttachedObject(playerid,5,18694,6,0.191999,-0.062000,-0.208001,0.000000,95.199958,74.399993,0.000000,0.000000,0.000000);

		KatanaUse[playerid] = 1;
		SendClientMessage(playerid, COLOR_YELLOW, "คุณได้เรียก 'ดาบไฟ' ออกมาใช้งานแล้ว");

		return 1;
	}
	else
	{
	    ResetPlayerWeaponsEx(playerid);
	    RemovePlayerAttachedObject(playerid, 4);
	    RemovePlayerAttachedObject(playerid, 5);

	    KatanaUse[playerid] = 0;
		SendClientMessage(playerid, COLOR_LIGHTRED, "คุณได้เก็บ 'ดาบไฟ' แล้ว");

		return 1;
	}
}

public OnDialogResponse( playerid, dialogid, response, listitem, inputtext[] ) {

    if (dialogid == 0) { //
        if (response)
		{ //
		    if (playerData[playerid][pCoin] < 150)
		        return SendClientMessage(playerid, COLOR_GREY, "คุณต้องมีมากกว่า 150 Coin");

		    playerData[playerid][pSkin] = listitem;
			//UpdateplayerData(playerid);
            SetPlayerSkin(playerid, listitem);
            playerData[playerid][pCoin] -= 150;
            GameTextForPlayer(playerid, "~g~Skin Success!", 3000, 3);
        }
    }
    return 1;
}

