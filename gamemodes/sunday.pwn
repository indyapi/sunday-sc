ShowPlayerStats(playerid, bool:enable)
{
	new tmp2[256];
	if(enable == true)
	{
		format(tmp2, sizeof(tmp2), "~w~Welcome to GTA UNITY, ~n~~y~   %s.", GetPlayerNameEx(playerid));
		GameTextForPlayer(playerid, tmp2, 5000, 1);

		new strzing[128];
		format(strzing, sizeof(strzing), "%d", playerid);
		PlayerTextDrawSetString(playerid, sun_statsTD[playerid][16], strzing);

		PlayerTextDrawShow(playerid, sun_statsTD[playerid][0]);
