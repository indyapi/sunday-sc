alias:agivecar("gc")
CMD:agivecar(playerid, params[])
{
	new
		userid,
	    model[32],
	    query[256];

    if (playerData[playerid][pDevMode] < 7)
	    return SendClientMessage(playerid, COLOR_LIGHTRED, "แอดมินเท่านั้น");

	if (sscanf(params, "us[32]", userid, model))
	    return SendClientMessage(playerid, COLOR_LIGHTRED, "/givecar [playerid] [modelid/name]");

    if ((model[0] = GetVehicleModelByName(model)) == 0)
	    return SendClientMessage(playerid, COLOR_LIGHTRED, "ไม่มีรถไอดีนี้");

	mysql_format(g_SQL, query, sizeof(query), "INSERT INTO vehicles (carOwnerID, carOwner, carModel, carPrice, carFuel, carPosX, carPosY, carPosZ, carPosA) VALUES(%d, '%s', %d, 0, 100.0, '562.3970', '-1283.8485', '17.0007', '0.0000')", playerData[userid][pID], GetPlayerNameEx(userid),  model[0]);
	mysql_tquery(g_SQL, query);

	SendClientMessageEx(playerid, COLOR_ORANGE, "* แอดมินมอบรถ %s ให้กับ %s เรียบร้อย", ReturnVehicleModelName(model[0]), GetPlayerNameEx(userid));
	SendClientMessageEx(userid, COLOR_ORANGE, "* คุณได้รับรถยี่ห้อ %s จากแอดมิน", ReturnVehicleModelName(model[0]));

	return 1;
}

// --> สูบกัญชา
alias:cannabis("สูบกัญชา")
CMD:cannabis(playerid, params[])
{
	if (!Inventory_HasItem(playerid, "กัญชา"))
	    return SendClientMessage(playerid, COLOR_GREY, "คุณไม่มีกัญชา");

	Inventory_Remove(playerid, "กัญชา", 1);

    SetPlayerArmedWeapon(playerid,0);
    ApplyAnimation(playerid, "BUDDY", "BUDDY_CROUCHRELOAD", 4.0, 0, 0, 0, 1, 0); // hut
    SetPlayerAttachedObject(playerid, 5, 1666, 1, 0.2487, 0.4408, 0.1939, 127.0998, 21.3999, 11.7999, 0.6620, 0.7839, 3.5720, 0xFFFFFFFF, 0xFFFFFFFF); // propbeerglass1 attached to the Spine of Gasman
	SetPlayerAttachedObject(playerid, 6, 1942, 1, 0.2558, 0.5037, 0.2409, 34.2000, 0.0000, 112.1998, 0.0637, 0.6539, 0.0599, 0xFFFFFFFF, 0xFFFFFFFF); // kg50 attached to the Spine of Gasman
	SetPlayerAttachedObject(playerid, 7, 1942, 1, 0.1490, 0.6419, 0.3479, 33.5000, 7.4998, 21.7999, 0.0860, 0.4699, 0.0920, 0xFFFFFFFF, 0xFFFFFFFF); // kg50 attached to the Spine of Gasman
	SetPlayerAttachedObject(playerid, 8, 18673, 1, 0.3449, -0.3939, -1.0950, -34.4000, -1.2999, 101.3000, 1.0000, 1.0000, 1.0000, 0xFFFFFFFF, 0xFFFFFFFF); // cigarette_smoke attached to the Spineof Gasman
	SetPlayerAttachedObject(playerid, 9, 1933, 5, 0.0777, 0.0399, -0.0368, 0.0000, 0.0000, 0.0000, 0.1620, 0.0419, 0.5529, 0xFFFFFFFF, 0xFFFFFFFF); // chip_stack16 attached to the Left Hand of Gasman
    SetTimerEx("SmokeWeed", 5000, false, "d", playerid);

	SendClientMessageEx(playerid, COLOR_LIGHTRED, "> คุณได้ 'สูบกัญชา' เรียบร้อยแล้ว (กัญชา - 1)");
	return 1;
}

forward SmokeWeed(playerid);
