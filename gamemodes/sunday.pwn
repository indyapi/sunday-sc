alias:engine("สตาร์ทรถ")
CMD:en(playerid, params[])
{
    new vehicleid = GetPlayerVehicleID(playerid);
    new Float:vehiclehealth;
    GetVehicleHealth(vehicleid, vehiclehealth);

	if (!IsEngineVehicle(vehicleid))
		return SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}ยานพาหนะคันนี้ไม่มีเครื่องยนต์");

	if (vehiclehealth <= 350)
	    return SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}ยานพาหนะคันนี้มีความเสียหายมากเกินไป ไม่สามารถสตาร์ทได้");

	if (vehicleFuel[vehicleid] <= 0)
		return SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}รถคันนี้ไม่มีน้ำมันเลย");

	if (GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
    {
		switch (GetEngineStatus(vehicleid))
		{
		    case false:
		    {
			    SetEngineStatus(vehicleid, true);
		        SendClientMessage(playerid, COLOR_WHITE, "คุณได้บิดกุญแจเพื่อ{00FF00}สตาร์ท{FFFFFF}เครื่องยนต์");
			}
			case true:
			{
			    SetEngineStatus(vehicleid, false);
		        SendClientMessage(playerid, COLOR_WHITE, "คุณได้บิดกุญแจเพื่อ{FF0000}ดับ{FFFFFF}เครื่องยนต์");
			}
		}
	}
	return 1;
}

CMD:settime(playerid, params[])
{
    if(playerData[playerid][pAdmin] >= 6)
    {
    	new amount, msg[256];
        if(sscanf(params, "ud", amount))
			return SendClientMessage(playerid, COLOR_WHITE, "/settime [เวลา (0 คือปกติ)]");

        //SetPlayerMoneyEx(userid, amount);
        settime2 = amount;
        SetTimerEx("TimeCheckV", 50000, 0, "d", playerid);
        
        //new msg[256];
	//if(playerData[playerid][pAdmin] < 3) return SendClientMessage(playerid, COLOR_GREY, "   คุณไม่ได้รับอนุญาตให้ใช้คำสั่งนี้");
	//if(sscanf(params, "d", time)) return SendClientMessage(playerid, COLOR_GREY, "การใช้งาน : /ปรับเวลา [time] (0-23)");
	    SetWorldTime(settime2);
	    format(msg, sizeof(msg), "เวลา : นาฬิกาเซิร์ฟเวอร์ถูกเปลี่ยนเป็น %d:00", FormatMoney(amount));
    	SendClientMessageToAll(COLOR_ORANGE, msg);

        SendAdminMessage(COLOR_ADMIN, "AdmLog: %s ได้ปรับเวลา เป็น %s", FormatMoney(amount));
	}
    return 1;
}

