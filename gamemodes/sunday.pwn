	SendClientMessageToAll(COLOR_GREEN, "{00A9FE}[Twitter]{FFFFFF}: {00FE7F}(24/7 ผุพัง) ราคาสินค้าได้ถูกอัพเดทเรียบร้อยแล้ว!, ตรวจสอบที่ (24/7 ผุพัง) ใน GPS");
	return 1;
}

task RepeatingTimer[1000]()
{
	if (robCount > 0)
	    robCount--;

	if (shopCount[0] > 0)
	    shopCount[0] --;

	if (shopCount[1] > 0)
	    shopCount[1] --;

	if (shopCount[2] > 0)
	    shopCount[2] --;

	/**if (NavikCooldown > 0) NavikCooldown --;
	if (NavikCooldown < 0) NavikCooldown = 0;

	if (AirportCooldown > 0) AirportCooldown --;
	if (AirportCooldown < 0) AirportCooldown = 0;

	if (StadiumCooldown > 0) StadiumCooldown --;
	if (StadiumCooldown < 0) StadiumCooldown = 0;*/

//	GangZoneShowForAll(NavikZone, NavikColor);
//	GangZoneShowForAll(AirportZone, AirportColor);
	//GangZoneShowForAll(StadiumZone, StadiumColor);
	
//GangZoneShowForAll(JailZone, 0xFF0000AA);
  //  GangZoneShowForAll(redzone, 0xFF0000AA);
}

task vehicleFuelTimer[60000*5]()
{
	for(new i = 1; i < MAX_VEHICLES; i ++)
	{
		if(IsValidVehicle(i))
		{
			if (IsEngineVehicle(i) && GetEngineStatus(i))
			{
				if(vehicleFuel[i] > 0)
				{
					vehicleFuel[i] -= 1.0;
				}
				else
				{
				    SetEngineStatus(i, false);
				    vehicleFuel[i] = 0;
				}
			}
		}
	}
}

CMD:robbank(playerid, params[])
{
	if (CopOnline() < 2)
		return SendClientMessage(playerid, COLOR_LIGHTRED, "ต้องมีตำรวจออนไลน์มากกว่า 2");

	if (playerData[playerid][pLevel] < 3)
	    return SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}คุณต้องเลเวลมากกว่า 3 เท่านั้น");

	if (!IsPlayerInRangeOfPoint(playerid, 3.0, 2316.6187, -7.3258, 26.7422))
	    return SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}คุณไม่ได้อยู่ที่ธนาคาร");

	if (robCount > 0)
	    return SendClientMessageEx(playerid, COLOR_RED, "[ระบบ] {FFFFFF}รอเวลาอีก %s วินาที ถึงปล้นได้อีกครั้ง", FormatNumber(robCount));

	new price = 4000;
	robCount = 1800;
	GivePlayerMoneyEx(playerid, price);
	GivePlayerWanted(playerid, 6);
	robActive[playerid] = 1;
	SendClientMessageToAllEx(COLOR_LIGHTRED, "[ปล้นธนาคาร] %s ได้ทำการปล้นธนาคารและได้รับเงินไปจำนวน %s", GetPlayerNameEx(playerid), FormatMoney(price));
	SendClientMessage(playerid, COLOR_RED, "[ค่าความต้องการตัว] {FFFFFF}+ 6");
	return 1;
}

CMD:agps(playerid, params[])
{
    if (playerData[playerid][pAdmin] < 6)
	    return 1;

	Dialog_Show(playerid, DIALOG_AGPS, DIALOG_STYLE_LIST, "[ADMIN-GPS]",
	"{17FE00}<+>{FFFFFF} สถานที่\n{17FE00}<+>{FFFFFF} งาน\n{17FE00}<+>{FFFFFF} จุดขายสินค้า\n{17FE00}<+>{FFFFFF} การาจ\n{17FE00}<+>{FFFFFF} ปั้มน้ำมัน\n{17FE00}<+>{FFFFFF} จุดเช่ารถ\n{17FE00}<+>{FFFFFF} ATM", "Show", "Close");
	return 1;
}

CMD:gps(playerid, const params[])
{
	Dialog_Show(playerid, DIALOG_GPS, DIALOG_STYLE_LIST, "[GPS]",
	"{17FE00}<+>{FFFFFF} สถานที่\n{17FE00}<+>{FFFFFF} งาน\n{17FE00}<+>{FFFFFF} จุดชายสินค้า\n{17FE00}<+>{FFFFFF} การาจ\n{17FE00}<+>{FFFFFF} ปั้มน้ำมัน\n{17FE00}<+>{FFFFFF} จุดเช่ารถ\n{17FE00}<+>{FFFFFF} ATM", "Show", "Close");
	return 1;
}

CMD:flist(playerid, params[])
{
	new
		count,
		string[4096],
		string2[4096];

    if (playerData[playerid][pAdmin] < 6)
	    return 1;

	for (new i = 0; i != MAX_FACTIONS; i ++) if (factionData[i][factionExists])
	{
		format(string, sizeof(string), "%d\t{FFFFFF}({%06x}%s{FFFFFF})\n", i, factionData[i][factionColor] >>> 8, factionData[i][factionName]);
		strcat(string2, string);
		count++;
	}
	if (!count)
	{
		SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}เซิร์ฟเวอร์ไม่มีกลุ่มใด ๆ เลย");
		return 1;
	}
	format(string, sizeof(string), "ไอดี\tชื่อ\n%s", string2);
	Dialog_Show(playerid, DIALOG_UNUSED, DIALOG_STYLE_TABLIST_HEADERS, "[รายชื่อ Faction]", string, "ปิด", "");
	return 1;
}
