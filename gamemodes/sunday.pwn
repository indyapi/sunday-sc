forward SmokeWeed1(playerid);
public SmokeWeed1(playerid)
{
    RemovePlayerAttachedObject(playerid, 4);
    RemovePlayerAttachedObject(playerid, 5);
    RemovePlayerAttachedObject(playerid, 6);
    RemovePlayerAttachedObject(playerid, 7);
    RemovePlayerAttachedObject(playerid, 8);
    RemovePlayerAttachedObject(playerid, 9);
	ClearAnimations(playerid);
	TogglePlayerControllable(playerid, 1);
	ApplyAnimation(playerid,"PED","WALK_DRUNK",4.1, 1, 1, 1, 1, 1, 1);
}

stock IsPlayerNearIronPoint(playerid) {
	for(new x = 0; x < sizeof(ironPoints); x ++) {
	    if(IsPlayerInRangeOfPoint(playerid, 3.0, ironPoints[x][0], ironPoints[x][1], ironPoints[x][2])) {
	        return 1;
		}
	}
	return 0;
}

