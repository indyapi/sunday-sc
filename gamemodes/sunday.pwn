}*/

CMD:devkick(playerid, params[])
{
    if (playerData[playerid][pDevMode] < 3)
	    return 1;

	new reason[128];
	
	if(sscanf(params, "s[128]", reason)) return SendClientMessage(playerid, COLOR_WHITE, "/kickall [สาเหตุ]");

    foreach (new i : Player)
    {
        UpdateplayerData(i);
		SendClientMessageToAllEx(COLOR_LIGHTRED, "AdmCmd:เซิฟเวอร์เตะทุกคนออกจากเซิฟเวอร์, สาเหตุ: %s", reason);
		DelayedKick(i);
    }
	return 1;
}

Dialog:DIALOG_VIPREPAIR2(playerid, response, listitem, inputtext[])
{
	if (response)
	{
		switch(listitem)
		{
		    case 0:
		    {
				if (playerData[playerid][pVip] != 4)
				    return SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}คุณไม่ใช่ VIP-4");

				if (!IsPlayerInAnyVehicle(playerid))
				    return SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}คุณต้องอยู่ในรถส่วนตัว");

				new vehicleid = GetPlayerVehicleID(playerid);
				//RepairVehicle(vehicleid);
				RepairVehicleAr(vehicleid);
				SendClientMessage(playerid, COLOR_VIP2, "คุณได้ทำการซ่อมรถเสร็จแล้ว!");
			}
		    case 1:
		    {
				if (playerData[playerid][pVip] != 4)
				    return SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}คุณไม่ใช่ VIP-4");

				if (!IsPlayerInAnyVehicle(playerid))
				    return SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}คุณต้องอยู่ในรถส่วนตัว");

				new vehicleid = GetPlayerVehicleID(playerid);
				new Float:maxfuel = 100.0;

				new Float:fuel = 100.0 - vehicleFuel[vehicleid];
				//new Float:valuefloat = fuel*26;
				//new value = floatround(valuefloat);

				//if (GetPlayerMoneyEx(playerid) < value)
				//	return SendClientMessageEx(playerid, COLOR_RED, "[ระบบ] {FFFFFF}คุณมีเงินไม่เพียงพอในการเติมน้ำมัน (%s/%s) ลิตรละ 26", FormatMoney(GetPlayerMoneyEx(playerid)), FormatMoney(value));

				if (vehicleFuel[vehicleid] >= maxfuel)
					return SendClientMessageEx(playerid, COLOR_RED, "[ระบบ] {FFFFFF}ไม่สามารถเติมน้ำมันมากกว่านี้ได้ (%.2f/%.2f)", vehicleFuel[vehicleid], maxfuel);

				vehicleFuel[vehicleid] += fuel;
				//GivePlayerMoneyEx(playerid, -value);

				SendClientMessageEx(playerid, COLOR_VIP3, "{FFFFFF}คุณได้เติมน้ำมัน %.1f ลิตร เรียบร้อยแล้ว", fuel);
			}
		}
	}
	return 1;
}

