Dialog:DIALOG_POLICE_2(playerid, response, listitem, inputtext[])
{
    new amount = strval(inputtext), factionid = playerData[playerid][pFaction];
	if (response)
	{
		switch(PoliceLocker[playerid])
		{
		    case 0:
		    {
				if (Inventory_Count(playerid, "กัญชา") < amount)
				    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณมีกัญชาไม่เพียงพอ!");
				    
				if (amount <= 0)
				    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณต้องระบุจำนวนมากกว่า 0");
				    
				Inventory_Remove(playerid, "กัญชา", amount);
				factionData[factionid][fLocker][0] += amount;
				
				Faction_Save(factionid);
				SendClientMessageEx(playerid, COLOR_YELLOW, "[คลังหลักฐาน] : คุณได้ทำการเก็บ 'กัญชา' เข้าคลังหลักฐาน จำนวน %d", amount);
		    }
		    case 1: // โคเคน
		    {
				if (Inventory_Count(playerid, "โคเคน") < amount)
				    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณมีโคเคนไม่เพียงพอ!");

				if (amount <= 0)
				    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณต้องระบุจำนวนมากกว่า 0");

				Inventory_Remove(playerid, "โคเคน", amount);
				factionData[factionid][fLocker][1] += amount;

				Faction_Save(factionid);
				SendClientMessageEx(playerid, COLOR_YELLOW, "[คลังหลักฐาน] : คุณได้ทำการเก็บ 'โคเคน' เข้าคลังหลักฐาน จำนวน %d", amount);

		    }
		    case 2: // ปูน
		    {
				if (Inventory_Count(playerid, "ปูน") < amount)
				    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณมีปูนไม่เพียงพอ!");

				if (amount <= 0)
				    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณต้องระบุจำนวนมากกว่า 0");

				Inventory_Remove(playerid, "ปูน", amount);
				factionData[factionid][fLocker][2] += amount;

				Faction_Save(factionid);
				SendClientMessageEx(playerid, COLOR_YELLOW, "[คลังหลักฐาน] : คุณได้ทำการเก็บ 'ปูน' เข้าคลังหลักฐาน จำนวน %d", amount);

		    }
		    case 3: // แพ็คยาบ้า
		    {
				if (Inventory_Count(playerid, "แพ็คยาบ้า") < amount)
				    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณมีแพ็คยาบ้าไม่เพียงพอ!");

				if (amount <= 0)
				    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณต้องระบุจำนวนมากกว่า 0");

				Inventory_Remove(playerid, "แพ็คยาบ้า", amount);
				factionData[factionid][fLocker][3] += amount;

				Faction_Save(factionid);
				SendClientMessageEx(playerid, COLOR_YELLOW, "[คลังหลักฐาน] : คุณได้ทำการเก็บ 'แพ็คยาบ้า' เข้าคลังหลักฐาน จำนวน %d", amount);

		    }
		    case 4: // เงินแดง
		    {
				if (playerData[playerid][pRedMoney] < amount)
				    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณมีเงินแดงไม่เพียงพอ!");

				if (amount <= 0)
				    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณต้องระบุจำนวนมากกว่า 0");

				playerData[playerid][pRedMoney] -= amount;
				factionData[factionid][fLocker][4] += amount;

				Faction_Save(factionid);
				SendClientMessageEx(playerid, COLOR_YELLOW, "[คลังหลักฐาน] : คุณได้ทำการเก็บ 'เงินแดง' เข้าคลังหลักฐาน จำนวน %s", FormatMoney(amount));

		    }
		    case 5: // เงินค่าปรับ
		    {
				if (GetPlayerMoneyEx(playerid) < amount)
				    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณมีเงินเขียวไม่เพียงพอ!");

				if (amount <= 0)
				    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณต้องระบุจำนวนมากกว่า 0");

				GivePlayerMoneyEx(playerid, -amount);
				factionData[factionid][fLocker][5] += amount;

				Faction_Save(factionid);
				SendClientMessageEx(playerid, COLOR_YELLOW, "[คลังหลักฐาน] : คุณได้ทำการเก็บ 'กัญชา' เข้าคลังหลักฐาน จำนวน %s", FormatMoney(amount));
		    }
		}
		PoliceLocker[playerid] = -1;
	}
	return 1;
}

