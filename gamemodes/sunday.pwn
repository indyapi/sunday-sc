stock destroyGlass()
{
    for(new i = 0; i < 63; i++)
    {
        if(IsValidObject(glassObject[nextglass])) DestroyObject(glassObject[nextglass]);
    }
    KillTimer(eventTimer);
    KillTimer(destroyTimer);
}

CMD:fallout(playerid, params[])
{
    if(playerData[playerid][pAdmin] > 1)
    {
        if (GlassEvent)
        {
            GlassEvent = 0;
            SendClientMessageToAll(COLOR_GREEN, "{B7B7B7}[FallOut] {FFFFFF}แอดมินได้ปิดกิจกรรม FallOut แล้ว, ขอบคุณทุกคนที่เข้าร่วม");
        }
        else
        {
            destroyGlass();
            createGlass();

            GlassEvent = 1;

            SendClientMessageToAll(COLOR_GREEN, "{B7B7B7}[FallOut] {FFFFFF}แอดมินได้เปิดกิจกรรม FallOut แล้ว {FFDC2E}/เข้าร่วม{FFFFFF} เพื่อเข้ากิจกรรม");
        }
    }
    else
    {
        return 0;
    }
    return 1;
}

alias:startevent("เปิดกิจกรรม")
CMD:startevent(playerid, params[])
{
    if(playerData[playerid][pAdmin] > 1)
    {
        foreach (new i : Player)
        {
            if(IsPlayerConnected(i))
            {
                /*if (inEvent[nextglass])
                {
                    TogglePlayerControllable(i, 1);
                    GameTextForPlayer(i, "FALLOUT EVENT STARTED!", 5000, 5);

                    eventTimer = SetTimer("checkPlay", 3000, true);
                    destroyTimer = SetTimer("destroyone", 1000, true);
                    timez = 10;
                    nextglass = random(62);
                }*/

				TogglePlayerControllable(i, 1);
				GameTextForPlayer(i, "FALLOUT EVENT STARTED!", 5000, 5);

				eventTimer = SetTimer("checkPlay", 3000, true);
				destroyTimer = SetTimer("destroyone", 1000, true);
				timez = 10;
				nextglass = random(62);
            }
        }
    }
    else
    {
        return 0;
    }
    return 1;
}

alias:destroyevent("ลบกิจกรรม")
CMD:destroyevent(playerid, params[])
{
    if(IsPlayerConnected(playerid))
    {
        if(playerData[playerid][pAdmin] > 1)
        {
            destroyGlass();

            SendClientMessage(playerid, COLOR_WHITE, "{B7B7B7}[เซิร์ฟเวอร์]: {FFFFFF}กระจก FallOut ถูกทำลายลงแล้ว");
        }
        else
        {
            return 0;
        }
    }
    return 1;
}

