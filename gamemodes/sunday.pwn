	cache_get_value_name_int(0, "Woods", playerData[playerid][pWoods]);

	cache_get_value_name_int(0, "MarryOn", playerData[playerid][pMarryOn]);

	cache_get_value_name_int(0, "pCocain", playerData[playerid][pCocain]);
	cache_get_value_name_int(0, "pKetamine", playerData[playerid][pKetamine]);
	cache_get_value_name_int(0, "pCocainPack", playerData[playerid][pCocainPack]);
	cache_get_value_name_int(0, "pPoon", playerData[playerid][pPoon]);
	cache_get_value_name_int(0, "Daily", playerData[playerid][pDaily]);
	cache_get_value_name_int(0, "Sleep", playerData[playerid][pSleep]);
	cache_get_value_name_int(0, "Fixcar", playerData[playerid][pFixcar]);
	cache_get_value_name_int(0, "RunBar", playerData[playerid][pRunBar]);
	
	cache_get_value_name_int(0, "DevMode", playerData[playerid][pDevMode]);
	cache_get_value_name_int(0, "BitCoin", playerData[playerid][pBitcoin]);
	cache_get_value_name_int(0, "playerIncase", incase[playerid]);
	cache_get_value_name_int(0, "playerTicket", playerData[playerid][pTicket]);
	cache_get_value_name_int(0, "playerTicketHours", playerData[playerid][pTicketHours]);
	cache_get_value_name_int(0, "GachaOpen", playerData[playerid][pGachaOpen]);
	cache_get_value_name_int(0, "Itemcode", playerData[playerid][pItemcode]); //pItemcode

	if (playerData[playerid][pFactionID] != -1)
	{
	    playerData[playerid][pFaction] = GetFactionByID(playerData[playerid][pFactionID]);

	    if (playerData[playerid][pFaction] == -1)
		{
	        ResetFaction(playerid);
		}
	}

	for(new i = 1; i < MAX_VEHICLES; i ++)
	{
		if(IsValidVehicle(i) && IsVehicleOwner(playerid, i) && carData[i][carTimer] >= 0)
		{
			KillTimer(carData[i][carTimer]);
			carData[i][carTimer] = -1;
		}
	}


    new query[256];
    mysql_format(g_SQL, query, sizeof(query), "SELECT * FROM `inventory` WHERE `invOwner` = '%d'", playerData[playerid][pID]);
	mysql_tquery(g_SQL, query, "Inventory_Load", "d", playerid);

    mysql_format(g_SQL, query, sizeof(query), "SELECT * FROM `contacts` WHERE `ID` = '%d'", playerData[playerid][pID]);
	mysql_tquery(g_SQL, query, "Contact_Load", "d", playerid);
	return 1;
}

