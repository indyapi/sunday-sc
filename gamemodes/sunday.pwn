// --> สัตว์เลี้ยง
Dialog:DonatePet(playerid, response, listitem, inputtext[])
{
	if(response)
	{
		switch(listitem)
  		{
			case 0: //
			{
			    if (playerData[playerid][pCoin] < 100)
			        return SendClientMessage(playerid, COLOR_GREY, "คุณมี Coin ไม่เพียงพอ (100 Coin)");

				playerData[playerid][pPets][0] = 1;
				playerData[playerid][pCoin] -= 100;
				SetPlayerAttachedObject(playerid,4,19833,1,-1.326999,0.290000,-1.164000,-10.000002,86.299995,-167.400039,1.000000,0.829000,0.703999);
				SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณได้เสีย 100 Coin สำหรับการซื้่อสัตว์เลี้ยง");
				SendClientMessage(playerid, COLOR_WHITE, "(ระบบ) : พิมพ์ /pets หากคุณต้องการใช้งาน");


				return 1;
			}
			case 1: //
			{
			    if (playerData[playerid][pCoin] < 100)
			        return SendClientMessage(playerid, COLOR_GREY, "คุณมี Coin ไม่เพียงพอ (100 Coin)");

                playerData[playerid][pPets][1] = 1;
				playerData[playerid][pCoin] -= 100;
				SetPlayerAttachedObject(playerid,4,19315,1,-0.782999,0.471999,-0.834000,106.599983,89.099998,-6.400000,1.000000,1.672000,1.000000);
				SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณได้เสีย 100 Coin สำหรับการซื้่อสัตว์เลี้ยง");
                SendClientMessage(playerid, COLOR_WHITE, "(ระบบ) : พิมพ์ /pets หากคุณต้องการใช้งาน");
              

				return 1;
			}
			case 2: //
			{
			    if (playerData[playerid][pCoin] < 100)
			        return SendClientMessage(playerid, COLOR_GREY, "คุณมี Coin ไม่เพียงพอ (100 Coin)");

                playerData[playerid][pPets][2] = 1;
				playerData[playerid][pCoin] -= 100;

				SetPlayerAttachedObject(playerid,4,19078,1,0.321000,-0.093999,-0.185999,0.000000,0.000000,0.000000,1.000000,1.000000,1.000000);
				SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณได้เสีย 100 Coin สำหรับการซื้่อสัตว์เลี้ยง");
                SendClientMessage(playerid, COLOR_WHITE, "(ระบบ) : พิมพ์ /pets หากคุณต้องการใช้งาน");
                //UpdateplayerData(playerid);

				return 1;
			}
			case 3: //
			{
			    if (playerData[playerid][pCoin] < 100)
			        return SendClientMessage(playerid, COLOR_GREY, "คุณมี Coin ไม่เพียงพอ (100 Coin)");

                playerData[playerid][pPets][3] = 1;
				playerData[playerid][pCoin] -= 100;

				SetPlayerAttachedObject(playerid,4, 1609, 1, -1.090000, 0.000000, -0.616000, -1.300004, 87.499969, -5.099998, 0.314000, 0.312000, 0.546999);
				SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณได้เสีย 100 Coin สำหรับการซื้่อสัตว์เลี้ยง");
                SendClientMessage(playerid, COLOR_WHITE, "(ระบบ) : พิมพ์ /pets หากคุณต้องการใช้งาน");
                //UpdateplayerData(playerid);

				return 1;
			}
		}
	}
	return 1;
}

