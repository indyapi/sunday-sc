Dialog:DIALOG_POLICE_LOCKER(playerid, response, listitem, inputtext[])
{
	if (response)
	{
		switch(listitem)
		{
		    case 0..5:
		    {
				if (playerData[playerid][pFactionRank] < 5)
				    return SendClientMessageEx(playerid, COLOR_RED, "[ระบบ] {FFFFFF}คุณไม่สามารถใช้คำสั่งนี้ได้ (Rank ขั้นต่ำ : %d)", 5);

		        PoliceLocker[playerid] = listitem;
		        Dialog_Show(playerid, DIALOG_POLICE_TYPE, DIALOG_STYLE_LIST, "{FFFFFF}[{F5FD05}คลังเก็บหลักฐาน{FFFFFF}]", "{FFFFFF}- นำหลักฐานออกมาจากล็อคเกอร์\n- นำหลักฐานเก็บเข้าไปในล็อคเกอร์", "ตกลง", "ออก");
		    }
		    case 6:
			{
   				new query[512];
		     	mysql_format(g_SQL, query, sizeof(query), "SELECT * FROM `players` ORDER BY `CopPoints` DESC LIMIT 10");
			    mysql_tquery(g_SQL, query, "TopRank", "ii", playerid, 1);
			}
		}
	}
	return 1;
}

Dialog:DIALOG_MEDIC_LOCKER(playerid, response, listitem, inputtext[])
{
	if (response)
	{
		switch(listitem)
		{
		    case 0:
		    {
				if (playerData[playerid][pFactionRank] < 5)
				    return SendClientMessageEx(playerid, COLOR_RED, "[ระบบ] {FFFFFF}คุณไม่สามารถใช้คำสั่งนี้ได้ (Rank ขั้นต่ำ : %d)", 5);

		        MedicLocker[playerid] = listitem;
		        Dialog_Show(playerid, DIALOG_MEDICx_TYPE, DIALOG_STYLE_LIST, "{FFFFFF}[{F5FD05}คลังเก็บเงิน{FFFFFF}]", "{FFFFFF}- เบิกเงินออกกองคลัง\n- ฝากเงินเข้ากองคลัง", "ตกลง", "ออก");
		    }
		    case 1:
			{
   				new query[512];
		     	mysql_format(g_SQL, query, sizeof(query), "SELECT * FROM `players` ORDER BY `MedicPoints` DESC LIMIT 10");
			    mysql_tquery(g_SQL, query, "TopRank", "ii", playerid, 1);
			}
		}
	}
	return 1;
}

forward TopRank(playerid, threadid);
public TopRank(playerid, threadid)
{
    new string[4096], string5[4096];
    new name[25], rmoney, money;
    new rows = cache_num_rows();

	switch(threadid)
    {
		case 1:
		{
		    for(new i = 0; i < rows; i ++)
		    {
			    cache_get_value_name(i, "playerName", name, 25);
			    cache_get_value_name_int(i, "CopPoints", rmoney);

				format(string, sizeof(string), "{FFFFFF}%d\t{F5DD0E}%s\t{FFFFFF}%s คะแนน\n", i+1, name, FormatNumber(rmoney));
				strcat(string5, string);
			}
			format(string, sizeof(string), "{FFFFFF}อันดับ\t{FFFFFF}ชื่อตัวละคร\t{FFFFFF}คะแนน\n%s", string5);
			Dialog_Show(playerid, ShowOnly, DIALOG_STYLE_TABLIST_HEADERS, "{0DD0F7}[รายชื่อเจ้าหน้าที่ดีเด่น!]", string, "ตกลง","");
		}
		case 2:
		{
			new str[256], factionid = playerData[playerid][pFaction], rank;
		    format(str, sizeof(str), "{A3F608}[รายชื่อสมาชิก Faction > %s]", factionData[factionid][factionName]);

		    for(new i = 0; i < rows; i ++)
			{
			    cache_get_value_name(i, "playerName", name, 25);
			    cache_get_value_name_int(i, "playerFactionRank", rank);

				format(string, sizeof(string), "{7BF765}(%d)\t{FFFFFF}%s\t[ตำแหน่ง : %s]\n", i+1, name, FactionRanks[factionid][rank - 1]);
				strcat(string5, string);
			}

			format(string, sizeof(string), "{FFFFFF}อันดับ\t{FFFFFF}ชื่อตัวละคร\t{FFFFFF}ตำแหน่ง\n%s", string5);
			Dialog_Show(playerid, ShowOnly, DIALOG_STYLE_TABLIST_HEADERS, str, string, "ปิด","");
		}
		case 3:
		{
			new str[256], factionid = playerData[playerid][pFaction], rank;
		    format(str, sizeof(str), "{A3F608}[รายชื่อสมาชิก Faction > %s]", factionData[factionid][factionName]);

		    for(new i = 0; i < rows; i ++)
		    {
			    cache_get_value_name(i, "playerName", name, 25);
			    cache_get_value_name_int(i, "playerFactionRank", rank);

				format(string, sizeof(string), "{7BF765}(%d)\t{FFFFFF}%s\t[ตำแหน่ง : %s]\n", i+1, name, FactionRanks[factionid][rank - 1]);
				strcat(string5, string);
			}

			format(string, sizeof(string), "{FFFFFF}อันดับ\t{FFFFFF}ชื่อตัวละคร\t{FFFFFF}ตำแหน่ง\n%s", string5);
			Dialog_Show(playerid, DIALOG_FACTION_SETTING, DIALOG_STYLE_TABLIST_HEADERS, str, string, "เตะ","ยกเลิก");
		}
		case 4:
		{
		    foreach (new x : Player)
			if (GetFactionType(x) == FACTION_MEDIC)
			{
			    for(new i = 0; i < rows; i ++)
			    {
			        name = GetPlayerNameEx(x);
				    //cache_get_value_name(i, "playerName", name, 25);
				    cache_get_value_name_int(i, "MedicPoints", money);

					format(string, sizeof(string), "{FFFFFF}%d\t{F5DD0E}%s\t{FFFFFF}%s คะแนน\n", i+1, name, FormatNumber(money));
					strcat(string5, string);
				}
				format(string, sizeof(string), "{FFFFFF}อันดับ\t{FFFFFF}ชื่อตัวละคร\t{FFFFFF}คะแนน\n%s", string5);
				Dialog_Show(playerid, ShowOnly, DIALOG_STYLE_TABLIST_HEADERS, "{0DD0F7}[รายชื่อแพทย์ดีเด่น!]", string, "ตกลง","");
			}
		}
	}
	return 1;
}

Dialog:DIALOG_FACTION_SETTING(playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new query[128];
		mysql_format(g_SQL, query, sizeof(query), "SELECT * FROM players WHERE playerFaction = %d LIMIT %d, 1", playerData[playerid][pFactionID], listitem);
		mysql_tquery(g_SQL, query, "FactionSettings", "i", playerid);
	}
	return 1;
}

forward FactionSettings(playerid);
public FactionSettings(playerid)
{
	static
	    rows, string[256];

	cache_get_row_count(rows);

	if(!rows)
	{
	    SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}ขณะนี้ระบบมีปัญหา กรุณาติดต่อแอดมิน...");
	}
	else
	{
	    new vid, name[25];
	    for(new i = 0; i < rows; i ++)
	    {
			cache_get_value_name_int(0, "playerID", vid);
			cache_get_value_name(0, "playerName", name, 25);
		}
				
		mysql_format(g_SQL, string, sizeof(string), "UPDATE `players` SET `playerFaction` = '-1' WHERE `playerID` = '%d'", vid);
		mysql_tquery(g_SQL, string);

		mysql_format(g_SQL, string, sizeof(string), "UPDATE `players` SET `playerFactionRank` = '0' WHERE `playerID` = '%d'", vid);
		mysql_tquery(g_SQL, string);

		SendClientMessageEx(playerid, COLOR_LIGHTRED, "[เตะออกแก๊ง] : คุณได้เตะ '%s' ออกจากแก๊ง", name);
		return 1;
	}
	return 1;
}

