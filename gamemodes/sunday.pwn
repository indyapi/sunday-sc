			    Dialog_Show(playerid, D_MecArveh, DIALOG_STYLE_LIST, "เสริมเกาะ", 
				"{FA492D}| {FFFFFF}เกราะอ่อน\n\
				{FA492D}| {FFFFFF}เกราะทองแดง\n\
				{FA492D}| {FFFFFF}เกราะเหล็ก", "ยืนยัน", "ปิด");
			}
