alias:storage("เก็บของในบ้าน")
CMD:storage(playerid, params[])
{
	new id;
	if (!IsPlayerInAnyVehicle(playerid) && (id = (House_Inside(playerid) == -1) ? (House_Nearest(playerid)) : (House_Inside(playerid))) != -1 && House_IsOwner(playerid, id))
	{
		new string100[1024];
		new string2[1024];

		format(string100, sizeof(string100), "{FFFFFF}สิ่งของ\tจำนวน\n");
		strcat(string2,string100);

		format(string100, sizeof(string100), "{FFFFFF}กัญชา\t%d\n", HouseData[id][houseCannabis]);
		strcat(string2,string100);

		format(string100, sizeof(string100), "{FFFFFF}โคเคน\t%d\n", HouseData[id][houseCocain]);
		strcat(string2,string100);

		format(string100, sizeof(string100), "{FFFFFF}ปูน\t%d\n", HouseData[id][housePoon]);
		strcat(string2,string100);

		format(string100, sizeof(string100), "{FFFFFF}แพ็คยาบ้า\t%d\n", HouseData[id][houseDrug]);
		strcat(string2,string100);

		format(string100, sizeof(string100), "{FFFFFF}เงินเขียว\t%s\n", FormatMoney(HouseData[id][houseMoney]));
		strcat(string2,string100);

		format(string100, sizeof(string100), "{FFFFFF}เงินแดง\t%s\n", FormatMoney(HouseData[id][houseRedMoney]));
		strcat(string2,string100);

		format(string100, sizeof(string100), "{FFFFFF}แพ็คกัญชา\t%d\n", HouseData[id][housePackWeed]);
		strcat(string2,string100);

		format(string100, sizeof(string100), "{FFFFFF}แพ็คโคเคน\t%d\n", HouseData[id][housePackCocain]);
		strcat(string2,string100);

		Dialog_Show(playerid,DIALOG_HOUSE,DIALOG_STYLE_TABLIST_HEADERS,"{BDC2C2}[> คลังเก็บของภายในบ้าน]",string2,"ตกลง","ยกเลิก");
	}
	return 1;
}

Dialog:DIALOG_HOUSE(playerid, response, listitem, inputtext[])
{
    //new id;
	if(response)
	{
		switch(listitem)
		{
			case 0..7:
			{
				storageType[playerid] = listitem;
				Dialog_Show(playerid,DIALOG_HOUSE_1,DIALOG_STYLE_LIST,"{BDC2C2}[คลังเก็บของภายในบ้าน]","> ฝากของเข้าบ้าน\n> นำของออกมาจากบ้าน","ตกลง","ยกเลิก");
			}
		}
	}
	return 1;
}

Dialog:DIALOG_HOUSE_1(playerid, response, listitem, inputtext[])
{
	if(response)
	{
		switch(listitem)
		{
			case 0:
