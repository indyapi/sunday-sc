SetFaction(playerid, id)
{
	if (id != -1 && factionData[id][factionExists])
	{
		playerData[playerid][pFaction] = id;
		playerData[playerid][pFactionID] = factionData[id][factionID];
	}
	incase[playerid] = 0;
	return 1;
}

