Dialog:DIALOG_SAFE_INV8(playerid, response, listitem, inputtext[])
{
	new amount = strval(inputtext);

	if(response)
	{
	    if (GetPlayerMoneyEx(playerid) < amount)
	        return SendClientMessage(playerid, COLOR_GREY, "คุณมีเงินเขียวไม่เพียงพอ");

        GivePlayerMoneyEx(playerid, -amount);
        playerData[playerid][pSafeMoney] += amount;

