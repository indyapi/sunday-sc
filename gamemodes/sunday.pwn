stock ShowYMenuTextDraws(playerid)
{
	new str[520];

    format(str, sizeof(str), "%s", GetPlayerNameEx(playerid));
    PlayerTextDrawSetString(playerid, Menu_SUN[playerid][15], str);

    PlayerTextDrawSetPreviewModel(playerid, Menu_SUN[playerid][14], GetPlayerSkin(playerid));
    PlayerTextDrawShow(playerid, Menu_SUN[playerid][14]);

    format(str, sizeof(str), "%d", GetPlayerLevel(playerid));
    PlayerTextDrawSetString(playerid, Menu_SUN[playerid][49], str);

    format(str, sizeof(str), "%d/%d", playerData[playerid][pExp], GetPlayerRequiredExp(playerid));
	PlayerTextDrawSetString(playerid,  Menu_SUN[playerid][50], str);
	
	SetPlayerProgressBarValue(playerid, Menu_SUN_Bar[playerid], ExpToPecentage(playerid));

	PlayerTextDrawShow(playerid, Menu_SUN[playerid][0]);
