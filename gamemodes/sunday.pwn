					//if(IsVehicleOwner(playerid, vehicleid))
					//{
					new carid = carData[vehicleid][carID], query[256];
					carData[vehicleid][carTrunkLv] = 3;
					format(query, sizeof(query), "UPDATE vehicles SET carTrunkLv = 3 WHERE carID = %d", carid);
					mysql_tquery(g_SQL, query);
					SendClientMessage(playerid, 0xF3FF00FF, "| หลังรถ Level 3");
					//}
				}
			}
		}
	}
	return 1;
}

Dialog:DIALOG_CHMID(playerid, response, listitem, inputtext[])
{
	new user = strval(inputtext);
	if(response)
	{
		//static
			//userid;

		if (GetFactionType(playerid) != FACTION_POLICE && GetFactionType(playerid) != FACTION_MEDIC &&  GetFactionType(playerid) != FACTION_MEC && GetFactionType(playerid) != FACTION_GOV)
			return SendClientMessage(playerid, COLOR_RED, "[ ! ] {FFFFFF}สำหรับช่าง และหน่วยรัฐ!");

		if (incase[playerid] == 0)
			return SendClientMessage(playerid,COLOR_RED,"[!]{FFFFFF}คุณต้องเข้าเวรก่อน");

		if (user == INVALID_PLAYER_ID)
			return SendClientMessage(playerid, COLOR_RED, "[ ! ] {FFFFFF}ผู้เล่นไอดีนี้ไม่ได้อยู่ในเกม");

		if (user == playerid)
			return SendClientMessage(playerid, COLOR_RED, "[ ! ] {FFFFFF}ไม่สามารถค้นหาตัวเองได้");

		if (ChmCD[playerid] == 1)
			return SendClientMessage(playerid, COLOR_GREY, "คุณเริ่มใช้ chm ไปแล้ว ภายใน 5นาทีจะใช้ได้อีกครั้ง !");

		new Float:X,Float:Y,Float:Z;
		GetPlayerPos(user, X,Y,Z);

		targetonname[playerid] = user;
		SetPlayerCheckpoint(playerid, X,Y,Z, 5);

		if (GetFactionType(playerid) != FACTION_MEDIC &&  GetFactionType(playerid) != FACTION_MEC)
		{
			ChmCD[playerid] = 0;
		}

		targeton[playerid] = 1;
		ChmCD[playerid] = 1;
		SetTimer("AutoOffchm", 1000*10, false);
		SendClientMessage(playerid, COLOR_GREY, "คุณเริ่มใช้ chm แล้ว ภายใน 5นาทีจะใช้ได้อีกครั้ง !");
	}
	return 1;
}

