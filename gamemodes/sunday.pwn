CMD:arveh1(playerid)
{
	if(playerData[playerid][pAdmin] < 1)
		return 1;

	if (GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		new vehicleid = GetPlayerVehicleID(playerid);
		if(IsVehicleOwner(playerid, vehicleid))
		{
			carData[vehicleid][carLevel] = 1;
			carData[vehicleid][carHealth] = 4000;
			SetVehicleHealth(vehicleid, 4000);
			SendClientMessage(playerid, 0xF3FF00FF, "| Level 1");
		}
	}

	return 1;
}

CMD:arveh2(playerid)
{
	if(playerData[playerid][pAdmin] < 1)
		return 1;

	if (GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		new vehicleid = GetPlayerVehicleID(playerid);
		if(IsVehicleOwner(playerid, vehicleid))
		{

			carData[vehicleid][carLevel] = 2;
			carData[vehicleid][carHealth] = 5000;
			SetVehicleHealth(vehicleid, 5000);
			SendClientMessage(playerid, 0xF3FF00FF, "| Level 2");
		}
	}

	return 1;
}

CMD:arveh3(playerid)
{
	if(playerData[playerid][pAdmin] < 1)
		return 1;

	if (GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		new vehicleid = GetPlayerVehicleID(playerid);
		if(IsVehicleOwner(playerid, vehicleid))
		{
			carData[vehicleid][carLevel] = 3;
			carData[vehicleid][carHealth] = 6000;
			SetVehicleHealth(vehicleid, 6000);
			SendClientMessage(playerid, 0xF3FF00FF, "| Level 3");
		}
	}
	return 1;
}

RepairVehicleAr(playerid)
{
	new vehicleid = Vehicle_Nearest(playerid);
	if(!carData[vehicleid][carLevel])
	{
		carData[vehicleid][carLevel] = 0;
		carData[vehicleid][carHealth] = 2000;
		SetVehicleHealth(vehicleid, 2000);

		new query[128];
		mysql_format(g_SQL, query, sizeof(query), "UPDATE `vehicles` SET carHealth = '%f' WHERE carID = %d", 2000, carData[vehicleid][carID]);
	    mysql_tquery(g_SQL, query);
	}
	if(carData[vehicleid][carLevel] == 1)
	{
		carData[vehicleid][carLevel] = 1;
		carData[vehicleid][carHealth] = 3000;
		SetVehicleHealth(vehicleid, 3000);

		new query[128];
		mysql_format(g_SQL, query, sizeof(query), "UPDATE `vehicles` SET carHealth = '%f' WHERE carID = %d", 3000, carData[vehicleid][carID]);
	    mysql_tquery(g_SQL, query);
	}
	if(carData[vehicleid][carLevel] == 2)
	{
		carData[vehicleid][carLevel] = 2;
		carData[vehicleid][carHealth] = 4000;
		SetVehicleHealth(vehicleid, 4000);

		new query[128];
		mysql_format(g_SQL, query, sizeof(query), "UPDATE `vehicles` SET carHealth = '%f' WHERE carID = %d", 4000, carData[vehicleid][carID]);
	    mysql_tquery(g_SQL, query);
	}
	if(carData[vehicleid][carLevel] == 3)
	{
		carData[vehicleid][carLevel] = 3;
		carData[vehicleid][carHealth] = 5000;
		SetVehicleHealth(vehicleid, 5000);

		new query[128];
		mysql_format(g_SQL, query, sizeof(query), "UPDATE `vehicles` SET carHealth = '%f' WHERE carID = %d", 5000, carData[vehicleid][carID]);
	    mysql_tquery(g_SQL, query);
	}
	for (new i = 0; i != MAX_VEHICLES; i ++)
	{
		if (GetVehicleModel(i) == 402 ||GetVehicleModel(i) == 523 || GetVehicleModel(i) == 596 || GetVehicleModel(i) == 597 || GetVehicleModel(i) == 598 || GetVehicleModel(i) == 599 || GetVehicleModel(i) == 427)
		{
			carData[vehicleid][carHealth] = 5000;
			SetVehicleHealth(vehicleid, 5000);
			new query[128];
			mysql_format(g_SQL, query, sizeof(query), "UPDATE `vehicles` SET carHealth = '%f' WHERE carID = %d", 5000, carData[vehicleid][carID]);
	    	mysql_tquery(g_SQL, query);
		}
	}
	return 1;
}

public OnPlayerCheatAC(playerid, code, name[])
{
	new string[512];
	format(string, sizeof(string), "{EE3222}แจ้งเตือน : {FBE105}%s [ไอดี:%d] {ffffff}ถูกเชิญออกจากเซิร์ฟเวอร์เพราะต้องสงสัยว่าใช้งานโปร : {FBE105}%s [โค้ด: %d]", GetPlayerNameEx(playerid), playerid,CheatName[code],code);
	SendAdminMessage(COLOR_WHITE, string);

	if (code == 0 || code == 1 || code == 19 || code == 20 || code == 21 || code == 22 || code == 34 || code == 43)
	{
		Dialog_Show(playerid, ShowOnly, DIALOG_STYLE_MSGBOX, "{EE3222}ระบบป้องกันโปรแกรมช่วยเล่น:", "{ffffff}คุณถูกเตะออกจากเซิร์ฟเวอร์เนื่องจากต้องสงสัยว่าใช้งานโปรแกรมช่วยเล่น\n{FBE105}โปรที่ต้องสงสัยว่าใช้งาน: {F3503A}%s (โค้ด: %d)", "เข้าใจแล้ว", "", CheatName[code], code);
		DelayedKick(playerid);
	}
	ResetPlayerWeaponsEx(playerid);
	return 1;
}

// โอนรถระหว่างผู้เล่น
alias:tcar("โอนรถ")
CMD:tcar(playerid, params[])
{
	new vehicleid = GetPlayerVehicleID(playerid), targetid;

	if(!vehicleid || !IsVehicleOwner(playerid, vehicleid))
	{
	    return SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}คุณต้องอยู่ในรถส่วนตัวของคุณ");
	}
	if(sscanf(params, "u", targetid))
	{
	    return SendClientMessage(playerid, COLOR_WHITE, "/โอนรถ [ไอดี/ชื่อ]");
	}
	if(!IsPlayerConnected(targetid) || !IsPlayerNearPlayer(playerid, targetid, 5.0))
	{
	    return SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}ผู้เล่นไอดีนี้ไม่ได้อยู่ใกล้คุณ");
	}

	GetPlayerName(targetid, carData[vehicleid][carOwner], MAX_PLAYER_NAME);
	carData[vehicleid][carOwnerID] = playerData[targetid][pID];

	new query[128];
	mysql_format(g_SQL, query, sizeof(query), "UPDATE vehicles SET carOwnerID = %d, carOwner = '%s' WHERE carID = %d", carData[vehicleid][carOwnerID], carData[vehicleid][carOwner], carData[vehicleid][carID]);
	mysql_tquery(g_SQL, query);

	SendClientMessageEx(targetid, COLOR_LIGHTRED, "** %s ได้โอนรถรุ่น %s ให้กับคุณแล้ว", GetPlayerNameEx(playerid), ReturnVehicleName(vehicleid));
	SendClientMessageEx(playerid, COLOR_LIGHTRED, "** คุณได้โอนรถรุ่น %s ให้กับ %s เรียบร้อยแล้ว", ReturnVehicleName(vehicleid), GetPlayerNameEx(targetid));
	return 1;
}

