// วอร์ยึดธง
task WarSF[1000]()
{
	new string[256];
	foreach(new i : Player)
	{
		if(IsPlayerConnected(i))
		{
			if (!IsPlayerInAnyVehicle(i))
			{
				if(IsPlayerInRangeOfPoint(i, 3.0, -2020.9893,-810.7471,33.3897))
				{
	                if(PlayerIsProgress[i] == 1)
	                {
						if (IsPlayerInAnyVehicle(i))
						{
							PlayerIsProgress[i] = 0;
	                        WarPlayerTime[i] = 0;
	                        WarIsProgress = 0;
							HidePlayerProgressBar(i, BarWar[i]);
							SendClientMessage(i, COLOR_LIGHTRED, "คุณได้หยุดการกระทำดังกล่าว");
							return 1;
						}

						/*if(IsAFK[i])
						{
							PlayerIsProgress[i] = 0;
	                        WarPlayerTime[i] = 0;
	                        WarIsProgress = 0;
							HidePlayerProgressBar(i, BarWar[i]);
							SendClientMessage(i, COLOR_LIGHTRED, "คุณได้หยุดการกระทำดังกล่าว");
							SendAdminAlert(COLOR_RED, "[แจ้งเตือนบัค CAPSF]: %s ได้ทำการ ESC ขณะทำการยึดวอ SF", GetPlayerNameEx(i));
							return 1;
						}*/

	                    WarPlayerTime[i]++;
						SetPlayerProgressBarValue(i,BarWar[i], WarPlayerTime[i]);

	                    if(WarPlayerTime[i] >= 30)
	                    {
	                        PlayerIsProgress[i] = 0;
	                        WarPlayerTime[i] = 0;
	                        WarIsProgress = 0;
							HidePlayerProgressBar(i, BarWar[i]);
							factionData[playerData[i][pFaction]][factionGangWarSF]++;
                         	WarIsFinish = playerData[i][pFaction];
							factionData[playerData[i][pFaction]][factionGangWarCount]--;
                         	format(string, sizeof(string), "[WARSF]: {FFFFFF}แก๊ง %s ได้ยึด WARSF จำนวน [%d/3]",factionData[playerData[i][pFaction]][factionName],factionData[playerData[i][pFaction]][factionGangWarSF]);
			                SendClientMessageToAll(GetPlayerColor(i), string);

							if(playerData[i][pFaction] == WarIsFinish)
							{
							    SpawnPlayer(i);
							}
	                    }
	                    if(factionData[playerData[i][pFaction]][factionGangWarSF] == 3)
	                    {
	                        new query[128];
	                        format(query, sizeof(query), "UPDATE `gangwarzone` SET `GangWarIs` = '%d' WHERE `ID` = '%d'",WarIsFinish, 1);
							mysql_tquery(g_SQL, query);

	                        mysql_tquery(g_SQL, "SELECT * FROM `gangwarzone`", "LOADGANGWARZONE", "");
	                        SendClientMessage(i, COLOR_YELLOW, " ชัยโย! คุณได้ยึดพื้นที่สำเร็จ");
						    format(string, sizeof(string), "[WARSF]: {FFFFFF}แก๊ง %s ได้รับชัยชนะในการวอร์ครั้งนี้",factionData[playerData[i][pFaction]][factionName]);
			                SendClientMessageToAll(GetPlayerColor(i), string);
							GetFactionWin = playerData[i][pFaction];
							factionData[playerData[i][pFaction]][factionWarStat]++;
							Faction_Save(playerData[i][pFaction]);

	                        SetTimer("RewardWar", 1000, 0);
	                        factionData[playerData[i][pFaction]][factionGangWarSF] = 0;
	                        factionData[playerData[i][pFaction]][factionGangWarCount] = 0;
	                        SetTimer("ReLoadWarZone", 5000, 1);
							SetTimer("ResetVariableWar", 1000, 0);
							OpenWarSF = 0;
	                    }
	                }
				}
				else
				{
				    if(PlayerIsProgress[i] == 1)
				    {
                        PlayerIsProgress[i] = 0;
                        WarPlayerTime[i] = 0;
                        WarIsProgress = 0;
						HidePlayerProgressBar(i, BarWar[i]);
                        SendClientMessage(i, COLOR_YELLOW, " คุณเดินออกนอกพื้นที่ จงไปที่เดิมแล้วพิมพ์ /capsf เพื่อยึดซะ");
				    }
				}
			}
		}
	}
	return 1;
}

forward RewardWar();
public RewardWar()
{
	foreach(new i : Player)
	{
		if(IsPlayerConnected(i))
		{
		    if(playerData[i][pFaction] == GetFactionWin)
		    {
				WarIsFinish = -1;
		    }
		}
	}
	return 1;
}

forward ResetVariableWar();
public ResetVariableWar()
{
	foreach(new i : Player)
	{
		if (playerData[i][IsLoggedIn])
		{
			if(InWarSF[i] == 1)
			{
				SpawnPlayer(i);
				WarPlayerTime[i] = 0;
				PlayerIsProgress[i] = 0;
				InWarSF[i] = 0;
			}
		}
	}

	for(new j=0; j < MAX_FACTIONS; j++)
	{
		if(factionData[j][factionExists])
		{
			factionData[j][factionGangWarCount] = 0;
		}
	}

	WarIsProgress = 0;

	return 1;
}

forward LOADGANGWARZONE();
public LOADGANGWARZONE()
{
	static
	    rows;

	cache_get_row_count(rows);

	for (new i = 0; i < rows; i ++) if (i < 3)
	{
		cache_get_value_name_int(i, "ID", warzoneid[i]);
		cache_get_value_name_int(i, "GangWarIs", warzoneis[i]);
		countzone++;
	}
	printf("Load GangZoneWar %d", countzone);
	printf("[ZoneWar]: ID: %d Faction: %d",warzoneid[0],warzoneis[0]);
	printf("[ZoneWar]: ID: %d Faction: %d",warzoneid[1],warzoneis[1]);
	printf("[ZoneWar]: ID: %d Faction: %d",warzoneid[2],warzoneis[2]);
	return 1;
}

task ReLoadWarZone[900000]()
{
	foreach(new i : Player)
	{
		if(IsPlayerConnected(i))
		{
			GangZoneHideForPlayer(i, ZoneSF);
			GangZoneShowForPlayer(i, ZoneSF, factionData[warzoneis[0]][factionColor]);
		}
	}
	return 1;
}

