		// --> ระบบแต่งรถ

    if( _:playertextid != INVALID_TEXT_DRAW ) {
        if( playertextid == TuningBuy[ playerid ][ 10 ] ) { // desno
            if( !IsPlayerInAnyVehicle( playerid ) ) return SendClientMessage(playerid, -1, "คุณต้องอยู่บนรถ" );
	        if( GetPlayerState( playerid ) != PLAYER_STATE_DRIVER ) return SendClientMessage(playerid, -1, "คุณต้องเป็นคนขับรถ" );

            if( TPInfo[ playerid ][ tPaintjob ] == false ) {

				new compid = -1, vehicleid = GetPlayerVehicleID( playerid );

	            for( new i = ( TPInfo[ playerid ][ tID ]+1 ); i < MAX_COMPONENTS; i++ ) {
					if( cInfo[ i ][ cType ] == TPInfo[ playerid ][ tType ] ) {
						if( cInfo[ i ][ cID ] == IsComponentidCompatible( GetVehicleModel( vehicleid ), cInfo[ i ][ cID ] ) ) {
							compid = i;
							break;
						}
					}
				}
				if( compid == -1 ) return SendClientMessage(playerid, COLOR_LIGHTRED, "[ ยานพาหนะของคุณไม่สามารถติดตั้งอุปกรณ์แต่งอื่นได้แล้ว ]" );

	            RemoveVehicleComponent( vehicleid, cInfo[ TPInfo[ playerid ][ tID ] ][ cID ] );

	            TPInfo[ playerid ][ tID ] = compid;

	            format( globalstring, sizeof( globalstring ), "%s", cInfo[ compid ][ cName ] );
				PlayerTextDrawSetString( playerid, TuningBuy[ playerid ][ 3 ], globalstring );
				format( globalstring, sizeof( globalstring ), "Price: ~w~%d$", cInfo[ compid ][ cPrice ] );
				PlayerTextDrawSetString( playerid, TuningBuy[ playerid ][ 4 ], globalstring );

				AddComponent( vehicleid, cInfo[ compid ][ cID ] );

				SelectTextDraw( playerid, COLOR_ORANGE );
			}
			else if( TPInfo[ playerid ][ tPaintjob ] == true ) {

			    new paintid = -1, vehicleid = GetPlayerVehicleID( playerid );

			    for( new i = ( TPInfo[ playerid ][ tID ]+1 ); i < NUMBER_TYPE_PAINTJOB; i++ ) {
			    	if( pjInfo[ i ][ vehID ] == GetVehicleModel( vehicleid ) ) {
						paintid = i;
						break;
					}
			   	}
			   	if( paintid == -1 ) return SendClientMessage(playerid, -1, "[ ยานพาหนะของคุณไม่สามารถติดตั้งอุปกรณ์แต่งอื่นได้แล้ว ]" );

                TPInfo[ playerid ][ tID ] = paintid;

                format( globalstring, sizeof( globalstring ), "%s", pjInfo[ paintid ][ pName ] );
				PlayerTextDrawSetString( playerid, TuningBuy[ playerid ][ 3 ], globalstring );
				format( globalstring, sizeof( globalstring ), "Price: ~w~%d$", pjInfo[ paintid ][ pPrice ] );
				PlayerTextDrawSetString( playerid, TuningBuy[ playerid ][ 4 ], globalstring );

                SetVehiclePaintjob( vehicleid, pjInfo[ paintid ][ pNumber ] );

                SelectTextDraw( playerid, COLOR_ORANGE );
			}
        }
        if( playertextid == TuningBuy[ playerid ][ 11 ] )
		{ // levo
			if( TPInfo[ playerid ][ tPaintjob ] == false )
			{
	            if( !IsPlayerInAnyVehicle( playerid ) ) return SendClientMessage(playerid, -1, "คุณต้องอยู่บนรถ" );
		        if( GetPlayerState( playerid ) != PLAYER_STATE_DRIVER ) return SendClientMessage(playerid, -1, "คุณต้องเป็นคนขับรถ" );

				new compid = -1, vehicleid = GetPlayerVehicleID( playerid );

	            for( new i = (TPInfo[ playerid ][ tID ]-1); i > 0; i-- ) {
					if( cInfo[ i ][ cType ] == TPInfo[ playerid ][ tType ] ) {
						if( cInfo[ i ][ cID ] == IsComponentidCompatible( GetVehicleModel( vehicleid ), cInfo[ i ][ cID ] ) ) {
							compid = i;
							break;
						}
					}
				}
				if( compid == -1 ) return SendClientMessage(playerid, -1, "[ ยานพาหนะของคุณไม่สามารถติดตั้งอุปกรณ์แต่งอื่นได้แล้ว ]" );

				RemoveVehicleComponent( vehicleid, cInfo[ TPInfo[ playerid ][ tID ] ][ cID ] );

	            TPInfo[ playerid ][ tID ] = compid;

	            format( globalstring, sizeof( globalstring ), "%s", cInfo[ compid ][ cName ] );
				PlayerTextDrawSetString( playerid, TuningBuy[ playerid ][ 3 ], globalstring );
				format( globalstring, sizeof( globalstring ), "Price: ~w~%d$", cInfo[ compid ][ cPrice ] );
				PlayerTextDrawSetString( playerid, TuningBuy[ playerid ][ 4 ], globalstring );

				AddComponent( vehicleid, cInfo[ compid ][ cID ] );

				SelectTextDraw( playerid, COLOR_ORANGE );
			}
			else if( TPInfo[ playerid ][ tPaintjob ] == true ) {

			    new paintid = -1, vehicleid = GetPlayerVehicleID( playerid );

			    for( new i = (TPInfo[ playerid ][ tID ]-1); i > 0; i-- ) {
			    	if( pjInfo[ i ][ vehID ] == GetVehicleModel( vehicleid ) ) {
						paintid = i;
						break;
					}
			   	}
			   	if( paintid == -1 ) return SendClientMessage(playerid, -1, "[ ยานพาหนะของคุณไม่สามารถติดตั้งอุปกรณ์แต่งอื่นได้แล้ว ]" );

                TPInfo[ playerid ][ tID ] = paintid;

                format( globalstring, sizeof( globalstring ), "%s", pjInfo[ paintid ][ pName ] );
				PlayerTextDrawSetString( playerid, TuningBuy[ playerid ][ 3 ], globalstring );
				format( globalstring, sizeof( globalstring ), "Price: ~w~%d$", pjInfo[ paintid ][ pPrice ] );
				PlayerTextDrawSetString( playerid, TuningBuy[ playerid ][ 4 ], globalstring );

                SetVehiclePaintjob( vehicleid, pjInfo[ paintid ][ pNumber ] );

                SelectTextDraw( playerid, COLOR_ORANGE );
			}
        }
        if( playertextid == TuningBuy[ playerid ][ 7 ] ) { // buy
            if( !IsPlayerInAnyVehicle( playerid ) ) return SendClientMessage(playerid, -1, "คุณต้องอยู่บนรถ" );
	        if( GetPlayerState( playerid ) != PLAYER_STATE_DRIVER ) return SendClientMessage(playerid, -1, "คุณต้องเป็นคนขับรถ" );

            new Float:Pos[ 6 ], vehicleid = GetPlayerVehicleID( playerid );

            if( TPInfo[ playerid ][ tPaintjob ] == false ) {

				if( GetPlayerMoneyEx( playerid ) < cInfo[ TPInfo[ playerid ][ tID ] ][ cPrice ] ) return SendClientMessage(playerid, -1, "คุณมีเงินไม่เพียงพอ" );

				new cid = TPInfo[ playerid ][ tID ];

		        RemoveVehicleComponent( vehicleid, cInfo[ TPInfo[ playerid ][ tID ] ][ cID ] );

		        VehicleInfo[ vehicleid ][ vTuned ] = true;

		        AddComponent( vehicleid, cInfo[ cid ][ cID ] );

		        GivePlayerMoneyEx( playerid, -cInfo[ TPInfo[ playerid ][ tID ] ][ cPrice ] );

			}
			else if( TPInfo[ playerid ][ tPaintjob ] == true ) {

			    if( GetPlayerMoneyEx( playerid ) < pjInfo[ TPInfo[ playerid ][ tID ] ][ pPrice ] ) return SendClientMessage(playerid, -1, "คุณมีเงินไม่เพียงพอ" );

			    new paintid = TPInfo[ playerid ][ tID ];

			    VehicleInfo[ vehicleid ][ vTuned ] = true;

			    VehicleInfo[ vehicleid ][ vPaintJob ] = pjInfo[ paintid ][ pNumber ];

			    GivePlayerMoneyEx( playerid, -pjInfo[ TPInfo[ playerid ][ tID ] ][ pPrice ] );

			    SetVehicleColor( vehicleid, TPInfo[ playerid ][ PJColor ][ 0 ], TPInfo[ playerid ][ PJColor ][ 1 ] );

			    SetVehiclePaintjob( vehicleid, pjInfo[ paintid ][ pNumber ] );

			}
			GetVehicleCameraPos( vehicleid, Pos[ 0 ], Pos[ 1 ], Pos[ 2 ], 0, 6, 2 );
			SetPlayerCameraPos( playerid, Pos[ 0 ], Pos[ 1 ], Pos[ 2 ] );

			GetVehiclePos( vehicleid, Pos[ 0 ],Pos[ 1 ],Pos[ 2 ] );
			SetPlayerCameraLookAt( playerid, Pos[ 0 ],Pos[ 1 ],Pos[ 2 ] );

			CancelSelectTextDraw( playerid );

		    TuningTDControl( playerid, false );
		    TogglePlayerControllable( playerid, true );

			SPD( playerid, dialog_TUNING, DSL, D_TOP, D_TEXT, D_OK, D_CANCEL );
        }
        if( playertextid == TuningBuy[ playerid ][ 2 ] ) { // close

            if( !IsPlayerInAnyVehicle( playerid ) ) return SendClientMessage(playerid, -1, "คุณต้องอยู่บนรถ" );
	        if( GetPlayerState( playerid ) != PLAYER_STATE_DRIVER ) return SendClientMessage(playerid, -1, "คุณต้องเป็นคนขับรถ" );

            new Float:Pos[ 6 ], vehicleid = GetPlayerVehicleID( playerid );

			if( TPInfo[ playerid ][ tPaintjob ] == false ) {

		        RemoveVehicleComponent( vehicleid, cInfo[ TPInfo[ playerid ][ tID ] ][ cID ] );

				SetTune( vehicleid );
			}
			else if( TPInfo[ playerid ][ tPaintjob ] == true ) {
			    SetVehiclePaintjob( vehicleid, 3 );
				SetVehicleColor( vehicleid, TPInfo[ playerid ][ PJColor ][ 0 ], TPInfo[ playerid ][ PJColor ][ 1 ] );
			}
			GetVehicleCameraPos( vehicleid, Pos[ 0 ], Pos[ 1 ], Pos[ 2 ], 0, 6, 2 );
			SetPlayerCameraPos( playerid, Pos[ 0 ], Pos[ 1 ], Pos[ 2 ] );

			GetVehiclePos( vehicleid, Pos[ 0 ],Pos[ 1 ],Pos[ 2 ] );
			SetPlayerCameraLookAt( playerid, Pos[ 0 ],Pos[ 1 ],Pos[ 2 ] );

	        CancelSelectTextDraw( playerid );

			TuningTDControl( playerid, false );
		    TogglePlayerControllable( playerid, true );

			SPD( playerid, dialog_TUNING, DSL, D_TOP, D_TEXT, D_OK, D_CANCEL );
        }
    }

	// ---------------------------------------------------------------------->
	
	// --> กาชาปอง
    if(playertextid == Gachapong_NewMember[playerid][10])
    {
		if (!Inventory_HasItem(playerid, "กาชาผู้เล่นใหม่"))
		    return SendClientMessage(playerid, COLOR_LIGHTRED, "คุณไม่มี 'กาชาผู้เล่นใหม่'");

		if (GachaNM_ActiveLast[playerid] == 1)
		    return SendClientMessage(playerid, COLOR_GREY, "[GACHAPONG]: กำลังเปิดกาชา...");

		Inventory_Remove(playerid, "กาชาผู้เล่นใหม่", 1);

		new Msg[128];
		format(Msg, sizeof(Msg), "%d", Inventory_Count(playerid, "กาชาผู้เล่นใหม่"));
		PlayerTextDrawSetString(playerid,Gachapong_NewMember[playerid][15], Msg);

        format(Msg, sizeof(Msg), "%d", playerData[playerid][pGachaOpen]);
		PlayerTextDrawSetString(playerid,Gachapong_NewMember[playerid][17], Msg);

        GachaNM_ActiveLast[playerid] = 1;
		playerData[playerid][pGachaOpen] += 1;
        SendClientMessage(playerid, COLOR_GREEN, "[GACHAPONG]: เริ่มการเปิดกาชาปอง....");
        // GachaNM_ActiveLast[playerid] == 1
        return 1;
    }
    if(playertextid == Gachapong_NewMember[playerid][11])
    {
        if (GachaNM_ActiveLast[playerid] == 1)
		    return SendClientMessage(playerid, COLOR_GREY, "[GACHAPONG]: กำลังเปิดกาชา...");

        PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][0]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][1]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][2]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][3]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][4]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][5]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][6]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][7]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][8]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][9]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][10]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][11]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][12]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][13]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][14]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][15]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][16]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][17]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][18]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][19]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][20]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][21]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][22]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][23]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][24]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][25]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][26]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][27]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][28]);
		PlayerTextDrawHide(playerid, Gachapong_NewMember[playerid][29]);
        CancelSelectTextDraw(playerid);

        GachaNM_TimeLast[playerid] = 0;
        GachaNM_StatsLast[playerid] = -1;
        GachaNM_ActiveLast[playerid] = 0;
        return 1;
    }
    if(playertextid == Gachapong_NewMember[playerid][12])
    {
        SendClientMessage(playerid, COLOR_GREEN, "[GACHAPONG]: อยู่ในระหว่างการพัฒนา...");
        return 1;
    }
    if(playertextid == Gachapong_NewMember[playerid][13])
    {
        SendClientMessage(playerid, COLOR_GREEN, "[GACHAPONG]: อยู่ในระหว่างการพัฒนา...");
        return 1;
    }

	// --> หน้าเมนูช่วยเหลือกด Y

    if (playertextid == Menu_SUN[playerid][33])
    {
        callcmd::stats(playerid, "\1");
        HideYMenuTextDraws(playerid);
        return 1;
    }

    if (playertextid == Menu_SUN[playerid][34])
    {
        OpenInventory(playerid);
        HideYMenuTextDraws(playerid);
        return 1;
    }

    if (playertextid == Menu_SUN[playerid][35])
    {
        callcmd::gps(playerid, "\1");
        HideYMenuTextDraws(playerid);
        return 1;
    }

    if (playertextid == Menu_SUN[playerid][36])
    {
        callcmd::phone(playerid, "\1");
        HideYMenuTextDraws(playerid);
        return 1;
    }

    if (playertextid == Menu_SUN[playerid][37])
    {
        callcmd::help(playerid, "\1");
        HideYMenuTextDraws(playerid);
        return 1;
    }

    if (playertextid == Menu_SUN[playerid][38])
    {
        callcmd::ai(playerid, "\1");
        HideYMenuTextDraws(playerid);
        return 1;
    }

    if (playertextid == Menu_SUN[playerid][39])
    {
		new string100[512];
		new string2[512];

		format(string100, sizeof(string100), "{FFFFFF}[การเติมเงิน]\t{35C005}รายละเอียด\n");
		strcat(string2,string100);

		format(string100, sizeof(string100), "{FFFFFF}รถโดเนท\t{16D603}คลิก\n");
		strcat(string2,string100);

		format(string100, sizeof(string100), "{FFFFFF}กาชาปอง (สุ่มรถ)\t{16D603}100 {FFFFFF}Coin\n");
		strcat(string2,string100);

		format(string100, sizeof(string100), "{FFFFFF}VIP\t{16D603}คลิก\n");
		strcat(string2,string100);

		format(string100, sizeof(string100), "{FFFFFF}ซื้อเงินเขียว $10\t{16D603}1 {FFFFFF}Coin\n");
		strcat(string2,string100);

		format(string100, sizeof(string100), "{FFFFFF}อาวุธแฟชั่น\t{16D603}คลิก\n");
		strcat(string2,string100);

		format(string100, sizeof(string100), "{FFFFFF}Boombox\t{16D603}100 {FFFFFF}Coin\n");
		strcat(string2,string100);

		format(string100, sizeof(string100), "{FFFFFF}ชุดเซ็ต\t{16D603}คลิก\n");
		strcat(string2,string100);

		Dialog_Show(playerid,DIALOG_DONATE,DIALOG_STYLE_TABLIST_HEADERS,"{FFFFFF}[{16D603}ของโดเนท{FFFFFF}]",string2,"ตกลง","ยกเลิก");
		HideYMenuTextDraws(playerid);
		return 1;
    }

    if (playertextid == Menu_SUN[playerid][40])
    {
        playerData[playerid][pFixcar] = 0;
 		playerData[playerid][pRunBar] = 0;
        SetPlayerWeather(playerid, globalWeather);
		ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.0, 0, 0, 0, 0, 1);
	  	ClearAnimations(playerid);
    	ShowPlayerStats(playerid, true);
    	SetPlayerInterior(playerid, 0);
		SetPlayerVirtualWorld(playerid, 0);

    	SendClientMessage(playerid, COLOR_RED, "{00FFF7}[SUN] {FFFFFF}: {8FFF00}แก้บัคเรียบร้อย");
        HideYMenuTextDraws(playerid);
        return 1;
    }

    if (playertextid == Menu_SUN[playerid][41])
    {
        SendClientMessage(playerid, COLOR_RED, "{00FFF7}[SUN] {FFFFFF}: {8FFF00}อยู่ระหว่างการพัฒนา....");
        HideYMenuTextDraws(playerid);
        return 1;
    }

    if (playertextid == Menu_SUN[playerid][42])
    {
        SendClientMessage(playerid, COLOR_RED, "{00FFF7}[SUN] {FFFFFF}: {8FFF00}อยู่ระหว่างการพัฒนา....");
        HideYMenuTextDraws(playerid);
        return 1;
    }

    if (playertextid == Menu_SUN[playerid][43])
    {
		if(GetFactionType(playerid) == FACTION_MEDIC)
		{
			Dialog_Show(playerid, Dialog_MEDIC_TYPE, DIALOG_STYLE_LIST, "{FA492D}[ MEDIC MENU ]", 
			"{FA492D}+ {FFFFFF}รายชื่อผู้บาดเจ็บ\n\
		    {FA492D}+ {FFFFFF}ยกเลิกรายชื่อผู้บาดเจ็บ\n\
			{FA492D}+ {FFFFFF}CPR\n\
		    {FA492D}+ {FFFFFF}ฉีดยา\n\
			{FA492D}+ {FFFFFF}เข้าวิทยุ\n\
			{FA492D}+ {FFFFFF}ออกวิทยุ\
			", "ตกลง", "ปิด");
		}
		if (GetFactionType(playerid) == FACTION_MEC)
		{
            Dialog_Show(playerid, Dialog_MEC_TYPE, DIALOG_STYLE_LIST, "\
			{5A5657}[ MECHANIC MENU ]","\
			{FA492D}+ {FFFFFF}ค้นหาผู้ที่ต้องการช่าง\n\
			{FA492D}+ {FFFFFF}ยกเลิกการรับเคส\n\
			{FA492D}+ {FFFFFF}เข้าวิทยุ\n\
			{FA492D}+ {FFFFFF}ออกวิทยุ\
			","ตกลง", "ปิด");
		}
		if (GetFactionType(playerid) == FACTION_POLICE)
		{
			Dialog_Show(playerid, D_PoliceMenu, DIALOG_STYLE_LIST, 
			"{037DE4}[ POLICE MENU ]", 
			"{037DE4}+ {ffffff}ดูรายชื่อผู้ทำงานผิดกฎหมาย\n\
			{037DE4}+ {ffffff}ยกเลิกรายชื่อผู้ทำงานผิดกฎหมาย\n\
			{037DE4}+ {FFFFFF}เข้าวิทยุ\n\
			{037DE4}+ {FFFFFF}ออกวิทยุ\
			", "ตกลง", "ปิด");
		}
        HideYMenuTextDraws(playerid);
        return 1;
    }

    if (playertextid == Menu_SUN[playerid][44])
    {
        //OpenInventory(playerid);
        HideYMenuTextDraws(playerid);
        return 1;
	}
	return 1;
}

public OnPlayerClickTextDraw(playerid, Text:clickedid)
{

	if(clickedid == BACARATextDraws[18]) // PLAYER
	{
        Dialog_Show(playerid, DIALOG_PLAYER, DIALOG_STYLE_INPUT, "[การวางเดิมพัน]", "{FFFFFF}คุณต้องการวางเดิมพัน {05AAFD}PLAYER {FFFFFF}เป็นจำนวนเงินเท่าใด", "ตกลง", "ออก");
	}

	if(clickedid == BACARATextDraws[19]) // TIE
	{
        Dialog_Show(playerid, DIALOG_TIE, DIALOG_STYLE_INPUT, "[การวางเดิมพัน]", "{FFFFFF}คุณต้องการวางเดิมพัน {10FD05}TIE {FFFFFF}เป็นจำนวนเงินเท่าใด", "ตกลง", "ออก");
	}

	if(clickedid == BACARATextDraws[20]) // BANKER
	{
        Dialog_Show(playerid, DIALOG_BANKER, DIALOG_STYLE_INPUT, "[การวางเดิมพัน]", "{FFFFFF}คุณต้องการวางเดิมพัน {FD2305}BANKER {FFFFFF}เป็นจำนวนเงินเท่าใด", "ตกลง", "ออก");
	}
	
	if(clickedid == BACARATextDraws[2])
	{
	    JoinBacara[playerid] = 0;
	    HideBACARA(playerid);
	}

	// คราฟอาวุธ
	/*if(clickedid == WeaponCraft[4])
	{
		HideCraftWeapon(playerid);
	}
	if(clickedid == WeaponCraft[7])
	{
	    ShowCraftWeaponType(playerid, 1);
	}
	if(clickedid == WeaponCraft[10])
	{
	    ShowCraftWeaponType(playerid, 2);
	}
	if(clickedid == WeaponCraft[13])
	{
	    ShowCraftWeaponType(playerid, 3);
	}
	if(clickedid == WeaponCraft[15])
	{
	    ShowCraftWeaponType(playerid, 4);
	}
	if(clickedid == WeaponCraft[21])
	{
	    ShowCraftWeaponType(playerid, 5);
	}
	if(clickedid == WeaponCraft[18])
	{
	    ShowCraftWeaponType(playerid, 6);
	}
	//
	if(clickedid == ItemWPCraft[6])
	{
	    HideCraftWeaponType(playerid);
	}

	// คราฟอาวุธ
	if(clickedid == ItemWPCraft[20])
	{
	    switch (CraftType[playerid])
	    {
	        case 0: { }
	        case 1:
	        {
	            if (playerData[playerid][pMaterials] < 50)
	                return SendClientMessage(playerid, COLOR_LIGHTRED, "คลังของคุณมีดินปืนไม่เพียงพอ! (50)");

	            if (playerData[playerid][pWoods] < 100)
	                return SendClientMessage(playerid, COLOR_LIGHTRED, "คลังของคุณมีไม้ไม่เพียงพอ! (100)");

	            if (playerData[playerid][pIrons] < 100)
	                return SendClientMessage(playerid, COLOR_LIGHTRED, "คลังของคุณมีเหล็กไม่เพียงพอ! (100)");

	            if (GetPlayerMoneyEx(playerid) < 20000)
	                return SendClientMessage(playerid, COLOR_LIGHTRED, "คุณมีเงินเขียวไม่เพียงพอ! ($20,000)");

			    if (StartCraft[playerid] != 0)
			        return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณอยู่ระหว่างการสร้างอาวุธ");

				ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.0, 1, 0, 0, 0, 0, 1);
				StartCraft[playerid] = 1;
				TogglePlayerControllable(playerid, false);
	        }
	        case 2:
	        {
	            if (playerData[playerid][pMaterials] < 80)
	                return SendClientMessage(playerid, COLOR_LIGHTRED, "คลังของคุณมีดินปืนไม่เพียงพอ! (80)");

	            if (playerData[playerid][pWoods] < 50)
	                return SendClientMessage(playerid, COLOR_LIGHTRED, "คลังของคุณมีไม้ไม่เพียงพอ! (50)");

	            if (playerData[playerid][pIrons] < 150)
	                return SendClientMessage(playerid, COLOR_LIGHTRED, "คลังของคุณมีเหล็กไม่เพียงพอ! (150)");

	            if (GetPlayerMoneyEx(playerid) < 30000)
	                return SendClientMessage(playerid, COLOR_LIGHTRED, "คุณมีเงินเขียวไม่เพียงพอ! ($30,000)");

			    if (StartCraft[playerid] != 0)
			        return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณอยู่ระหว่างการสร้างอาวุธ");

				ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.0, 1, 0, 0, 0, 0, 1);
				StartCraft[playerid] = 1;
				TogglePlayerControllable(playerid, false);
	        }
	        case 3:
	        {
	            if (playerData[playerid][pMaterials] < 100)
	                return SendClientMessage(playerid, COLOR_LIGHTRED, "คลังของคุณมีดินปืนไม่เพียงพอ! (100)");

	            if (playerData[playerid][pWoods] < 200)
	                return SendClientMessage(playerid, COLOR_LIGHTRED, "คลังของคุณมีไม้ไม่เพียงพอ! (200)");

	            if (playerData[playerid][pIrons] < 200)
	                return SendClientMessage(playerid, COLOR_LIGHTRED, "คลังของคุณมีเหล็กไม่เพียงพอ! (200)");

	            if (GetPlayerMoneyEx(playerid) < 40000)
	                return SendClientMessage(playerid, COLOR_LIGHTRED, "คุณมีเงินเขียวไม่เพียงพอ! ($40,000)");

			    if (StartCraft[playerid] != 0)
			        return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณอยู่ระหว่างการสร้างอาวุธ");

				ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.0, 1, 0, 0, 0, 0, 1);
				StartCraft[playerid] = 1;
				TogglePlayerControllable(playerid, false);
	        }
	        case 4:
