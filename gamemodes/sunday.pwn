repairveh(playerid)
{
	Fixcar[playerid] = 0;
	ClearAnimations(playerid);

	TogglePlayerControllable(playerid, true);

	new vehicleid = Vehicle_Nearest(playerid);
	RepairVehicle(vehicleid);
	if(!carData[vehicleid][carLevel])
	{
		carData[vehicleid][carLevel] = 0;
		carData[vehicleid][carHealth] = 2000;
		SetVehicleHealth(vehicleid, 2000);

		new query[128];
		mysql_format(g_SQL, query, sizeof(query), "UPDATE `vehicles` SET carHealth = '%f' WHERE carID = %d", 2000, carData[vehicleid][carID]);
	    mysql_tquery(g_SQL, query);
	}
	if(carData[vehicleid][carLevel] == 1)
	{
		carData[vehicleid][carLevel] = 1;
		carData[vehicleid][carHealth] = 3000;
		SetVehicleHealth(vehicleid, 3000);

		new query[128];
		mysql_format(g_SQL, query, sizeof(query), "UPDATE `vehicles` SET carHealth = '%f' WHERE carID = %d", 3000, carData[vehicleid][carID]);
	    mysql_tquery(g_SQL, query);
	}
	if(carData[vehicleid][carLevel] == 2)
	{
		carData[vehicleid][carLevel] = 2;
		carData[vehicleid][carHealth] = 4000;
		SetVehicleHealth(vehicleid, 4000);

		new query[128];
		mysql_format(g_SQL, query, sizeof(query), "UPDATE `vehicles` SET carHealth = '%f' WHERE carID = %d", 4000, carData[vehicleid][carID]);
	    mysql_tquery(g_SQL, query);
	}
	if(carData[vehicleid][carLevel] == 3)
	{
		carData[vehicleid][carLevel] = 3;
		carData[vehicleid][carHealth] = 5000;
		SetVehicleHealth(vehicleid, 5000);

		new query[128];
		mysql_format(g_SQL, query, sizeof(query), "UPDATE `vehicles` SET carHealth = '%f' WHERE carID = %d", 5000, carData[vehicleid][carID]);
	    mysql_tquery(g_SQL, query);
	}
	//RepairVehicle(vehicleid);
	SendClientMessage(playerid, COLOR_WHITE, "[REPAIR]:รถถูกซ่อมแล้ว");
	Inventory_Remove(playerid, "กล่องซ่อม", 1);

	return 1;
}

