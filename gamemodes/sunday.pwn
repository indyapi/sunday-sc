forward OffRainAuto();
public OffRainAuto()
{
	foreach (new i : Player)
	{
		RemovePlayerAttachedObject(i, 3);
	}
    SendClientMessageToAll(COLOR_RED, "[Future News]: ญ: ขณะนี้สภาพบัญญากาศในประเทศกลับมาสดใสเหมือนเดิมแล้วนะคะ");
	SendClientMessageToAll(COLOR_RED, "[Future News]: ช: จะได้เจอแดดกันสักทีแล้วนะครับ 555");
	SendClientMessageToAll(COLOR_RED, "[Future News]: ญ: ค่ะ");
	SendClientMessageToAll(COLOR_RED, "[Future News]: ญ: ขณะนี้ถึงเวลาแล้ว Future News รายงาน");
	SendClientMessageToAll(COLOR_RED, "[Future News]: ช&ญ: สวัสดีค่ะ/ครับ");

	SetWeather(globalWeather);
	return 1;
}

