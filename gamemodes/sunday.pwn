// --> สัตว์เลี้ยง

Dialog:DIALOG_PETS(playerid, response, listitem, inputtext[])
{
	if(response)
	{
		switch(listitem)
  		{
			case 0: //
			{
			    if (playerData[playerid][pPets][0] == 0)
			        return SendClientMessage(playerid, COLOR_GREY, "คุณไม่มีสัตว์เลี้ยงชนิดนี้");

                Dialog_Show(playerid,DIALOG_PET_1,DIALOG_STYLE_LIST,"{FFFFFF}[{FEF604}สัตว์เลี้ยง{FFFFFF}]","{FEF604}เรียกสัตว์เลี้ยง\n{FFFFFF}เก็บสัตว์เลี้ยง", "ตกลง", "ยกเลิก");
			}
			case 1: //
			{
			    if (playerData[playerid][pPets][1] == 0)
			        return SendClientMessage(playerid, COLOR_GREY, "คุณไม่มีสัตว์เลี้ยงชนิดนี้");

                Dialog_Show(playerid,DIALOG_PET_2,DIALOG_STYLE_LIST,"{FFFFFF}[{FEF604}สัตว์เลี้ยง{FFFFFF}]","{FEF604}เรียกสัตว์เลี้ยง\n{FFFFFF}เก็บสัตว์เลี้ยง", "ตกลง", "ยกเลิก");
			}
			case 2: //
			{
			    if (playerData[playerid][pPets][2] == 0)
			        return SendClientMessage(playerid, COLOR_GREY, "คุณไม่มีสัตว์เลี้ยงชนิดนี้");

                Dialog_Show(playerid,DIALOG_PET_3,DIALOG_STYLE_LIST,"{FFFFFF}[{FEF604}สัตว์เลี้ยง{FFFFFF}]","{FEF604}เรียกสัตว์เลี้ยง\n{FFFFFF}เก็บสัตว์เลี้ยง", "ตกลง", "ยกเลิก");
			}
			case 3: //
