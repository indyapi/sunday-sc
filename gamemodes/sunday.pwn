					{
					    case 0..20:
					    {
					        Inventory_Add(playerid, "ไม้สนุ๊ก", 1);
					        SendClientMessage(playerid, COLOR_YELLOW, "* ยินดีด้วย > คุณได้รับ 'ไม้สนุ๊ก' จากการสร้างอาวุธ");
					    }
					    case 21..99:
					    {
					        SendClientMessage(playerid, COLOR_RED, "* เสียใจด้วย > คุณล้มเหลวในการสร้างอาวุธ");
					    }
					}

					playerData[playerid][pRedMoney] -= 5500;
					GivePlayerMoneyEx(playerid, -111000);
					return 1;
				}

				case 5: //
				{
					if (GetPlayerMoneyEx(playerid) < 120000)
					    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณมีเงินไม่เพียงพอ ($120,000)");

					if (playerData[playerid][pRedMoney] < 10000)
					    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณมีเงินไม่เพียงพอ ($10,000)");

					new success = random(100);
					switch (success)
					{
					    case 0..15:
					    {
					        Inventory_Add(playerid, "ไม้แซ่", 1);
					        SendClientMessage(playerid, COLOR_YELLOW, "* ยินดีด้วย > คุณได้รับ 'ไม้แซ่' จากการสร้างอาวุธ");
					    }
					    case 16..99:
					    {
					        SendClientMessage(playerid, COLOR_RED, "* เสียใจด้วย > คุณล้มเหลวในการสร้างอาวุธ");
					    }
					}

					playerData[playerid][pRedMoney] -= 10000;
					GivePlayerMoneyEx(playerid, -120000);
					return 1;
				}

				case 6: //
				{
					if (GetPlayerMoneyEx(playerid) < 130000)
					    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณมีเงินไม่เพียงพอ ($130,000)");

					if (playerData[playerid][pRedMoney] < 15000)
					    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณมีเงินไม่เพียงพอ ($15,000)");

					new success = random(100);
					switch (success)
					{
					    case 0..10:
					    {
					        Inventory_Add(playerid, "มีดสั้น", 1);
					        SendClientMessage(playerid, COLOR_YELLOW, "* ยินดีด้วย > คุณได้รับ 'มีดสั้น' จากการสร้างอาวุธ");
					    }
					    case 11..99:
					    {
					        SendClientMessage(playerid, COLOR_RED, "* เสียใจด้วย > คุณล้มเหลวในการสร้างอาวุธ");
					    }
					}

					playerData[playerid][pRedMoney] -= 15000;
					GivePlayerMoneyEx(playerid, -130000);
					return 1;
				}

				case 7: //
				{
					if (GetPlayerMoneyEx(playerid) < 135000)
					    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณมีเงินไม่เพียงพอ ($135,000)");

					if (playerData[playerid][pRedMoney] < 20000)
					    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณมีเงินไม่เพียงพอ ($20,000)");

					new success = random(100);
					switch (success)
					{
					    case 0..10:
					    {
					        Inventory_Add(playerid, "ไม้เบส", 1);
					        SendClientMessage(playerid, COLOR_YELLOW, "* ยินดีด้วย > คุณได้รับ 'คาตานะ' จากการสร้างอาวุธ");
					    }
					    case 11..99:
					    {
					        SendClientMessage(playerid, COLOR_RED, "* เสียใจด้วย > คุณล้มเหลวในการสร้างอาวุธ");
					    }
					}

					playerData[playerid][pRedMoney] -= 20000;
					GivePlayerMoneyEx(playerid, -135000);
					return 1;
				}

				case 8: //
				{
					if (GetPlayerMoneyEx(playerid) < 200000)
					    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณมีเงินไม่เพียงพอ ($200,000)");

					if (playerData[playerid][pRedMoney] < 35000)
					    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณมีเงินไม่เพียงพอ ($35,000)");

					new success = random(100);
					switch (success)
					{
					    case 0..10:
					    {
					        Inventory_Add(playerid, "ปืนช็อต", 1);
					        SendClientMessage(playerid, COLOR_YELLOW, "* ยินดีด้วย > คุณได้รับ 'ปืนช็อต' จากการสร้างอาวุธ");
					    }
					    case 11..99:
					    {
					        SendClientMessage(playerid, COLOR_RED, "* เสียใจด้วย > คุณล้มเหลวในการสร้างอาวุธ");
					    }
					}

					playerData[playerid][pRedMoney] -= 35000;
					GivePlayerMoneyEx(playerid, -200000);
					return 1;
				}

				case 9:
				{
					if (GetPlayerMoneyEx(playerid) < 1000)
					    return SendClientMessage(playerid, COLOR_LIGHTRED, "* คุณมีเงินไม่เพียงพอ ($1,000)");

					Inventory_Add(playerid, "กระสุน", 1);
					SendClientMessage(playerid, COLOR_YELLOW, "* ยินดีด้วย > คุณได้รับ 'กระสุน' จากการสร้างอาวุธ");

					GivePlayerMoneyEx(playerid, -1000);
					return 1;
				}
			}

			CraftTypeLast[playerid] = -1;
		}
		return 1;
	}

	if (isRepairVehicle[playerid] == 3)
	{
		repairPoints[playerid] += 5;
		ApplyAnimation(playerid, "BD_FIRE","wash_up", 4.1, 0, 0, 0, 1, 0, 0);

		format(string, sizeof(string), "~r~Repair Car : ~w~%d/100", repairPoints[playerid]);
		GameTextForPlayer(playerid,  string, 2000, 5);

		if (repairPoints[playerid] >= 100)
		{
            isRepairVehicle[playerid] = 0;
            repairPoints[playerid] = 0;

			for (new i = 1; i != MAX_VEHICLES; i ++) if (IsValidVehicle(i) && IsPlayerNearHood(playerid, i))
			{
			    //RepairVehicle(i);
				RepairVehicleAr(i);
			}

			ClearAnimations(playerid);
			isRepairVehicle[playerid] = 0;
			SendClientMessage(playerid, COLOR_YELLOW, "> คุณได้ทำการซ่อมรถเสร็จสิ้นแล้ว");
			TogglePlayerControllable(playerid, 1);
		}
		return 1;
	}
	
	return 1;
}

// --> ลากรถ
stock GetVehicleFromBehind(vehicleid)
{
	new
	    Float:fCoords[7];

	GetVehiclePos(vehicleid, fCoords[0], fCoords[1], fCoords[2]);
	GetVehicleZAngle(vehicleid, fCoords[3]);

	for (new i = 1; i != MAX_VEHICLES; i ++) if (i != vehicleid && GetVehiclePos(i, fCoords[4], fCoords[5], fCoords[6]))
	{
		if (floatabs(fCoords[0] - fCoords[4]) < 6 && floatabs(fCoords[1] - fCoords[5]) < 6 && floatabs(fCoords[2] - fCoords[6]) < 6)
			return i;
	}
	return INVALID_VEHICLE_ID;
}

stock IsDoorVehicle(vehicleid)
{
	switch (GetVehicleModel(vehicleid)) {
		case 400..424, 426..429, 431..440, 442..445, 451, 455, 456, 458, 459, 466, 467, 470, 474, 475:
		    return 1;

		case 477..480, 482, 483, 486, 489, 490..492, 494..496, 498..500, 502..508, 514..518, 524..529, 533..536:
		    return 1;

		case 540..547, 549..552, 554..562, 565..568, 573, 575, 576, 578..580, 582, 585, 587..589, 596..605, 609:
			return 1;
	}
	return 0;
}

stock IsAPlane(vehicleid)
{
	switch (GetVehicleModel(vehicleid)) {
		case 460, 464, 476, 511, 512, 513, 519, 520, 553, 577, 592, 593: return 1;
	}
	return 0;
}

stock IsABoat(vehicleid)
{
	switch (GetVehicleModel(vehicleid)) {
		case 430, 446, 452, 453, 454, 472, 473, 484, 493, 595: return 1;
	}
	return 0;
}

stock IsAHelicopter(vehicleid)
{
	switch (GetVehicleModel(vehicleid)) {
		case 417, 425, 447, 465, 469, 487, 488, 497, 501, 548, 563: return 1;
	}
	return 0;
}

alias:tow("ลากรถ")
CMD:tow(playerid, params[])
{
	if (GetVehicleModel(GetPlayerVehicleID(playerid)) != 525)
	    return SendClientMessage(playerid, COLOR_GREY, "คุณไม่ได้อยู่บนรถบรรทุกพ่วง");

	if (GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
	    return SendClientMessage(playerid, COLOR_GREY, "คุณไม่ใช่คนขับ");

	new vehicleid = GetVehicleFromBehind(GetPlayerVehicleID(playerid));

	if (vehicleid == INVALID_VEHICLE_ID)
	    return SendClientMessage(playerid, COLOR_GREY, "ไม่มียานพาหนะคันไหนอยู่ในขอบเขต");

	if (!IsDoorVehicle(vehicleid) || IsAPlane(vehicleid) || IsABoat(vehicleid) || IsAHelicopter(vehicleid))
	    return SendClientMessage(playerid, COLOR_GREY, "ไม่สามารถลากยานพาหนะคันนี้ได้");

	AttachTrailerToVehicle(vehicleid, GetPlayerVehicleID(playerid));
	SendNearbyMessage(playerid, 30.0, COLOR_PURPLE, "** %s ได้เกี่ยวตะขอ %s ลงบนรถบรรทุกพ่วงของพวกเขา", GetPlayerNameEx(playerid), ReturnVehicleName(vehicleid));
	return 1;
}

alias:untow("หยุดลากรถ")
CMD:untow(playerid, params[])
{
	if (GetVehicleModel(GetPlayerVehicleID(playerid)) != 525)
	    return SendClientMessage(playerid, COLOR_GREY, "คุณไม่ได้อยู่บนรถบรรทุกพ่วง");

	if (GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
	    return SendClientMessage(playerid, COLOR_GREY, "คุณไม่ใช่คนขับ");

	new
	    trailerid = GetVehicleTrailer(GetPlayerVehicleID(playerid));

    if (!trailerid)
	    return SendClientMessage(playerid, COLOR_GREY, "ไม่มียานพาหนะคันไหนถูกลากโดยรถบรรทุกนี้");

	DetachTrailerFromVehicle(GetPlayerVehicleID(playerid));
	SendNearbyMessage(playerid, 30.0, COLOR_PURPLE, "** %s ได้ปลดตะขอ %s ออกจากรถบรรทุกพ่วง", GetPlayerNameEx(playerid), ReturnVehicleName(trailerid));

	return 1;
}

Dialog:DIALOG_MAIN_CAR(playerid, response, listitem, inputtext[])
{
	if (response)
	{
		switch(listitem)
		{
		    case 0:
  			{
			    new vehicleid = GetPlayerVehicleID(playerid);
			    new Float:vehiclehealth;
			    GetVehicleHealth(vehicleid, vehiclehealth);

				if (!IsEngineVehicle(vehicleid))
					return SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}ยานพาหนะคันนี้ไม่มีเครื่องยนต์");

				if (vehiclehealth <= 350)
				    return SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}ยานพาหนะคันนี้มีความเสียหายมากเกินไป ไม่สามารถสตาร์ทได้");

				if (vehicleFuel[vehicleid] <= 0)
					return SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}รถคันนี้ไม่มีน้ำมันเลย");

				if (GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
			    {
					switch (GetEngineStatus(vehicleid))
					{
					    case false:
					    {
						    SetEngineStatus(vehicleid, true);
					        SendClientMessage(playerid, COLOR_WHITE, "คุณได้บิดกุญแจเพื่อ{00FF00}สตาร์ท{FFFFFF}เครื่องยนต์");
						}
						case true:
						{
						    SetEngineStatus(vehicleid, false);
					        SendClientMessage(playerid, COLOR_WHITE, "คุณได้บิดกุญแจเพื่อ{FF0000}ดับ{FFFFFF}เครื่องยนต์");
						}
					}
				}
				else SendClientMessage(playerid, COLOR_LIGHTRED, "> คุณต้องเป็นคนขับรถ");
				return 1;
			}
			case 1:
			{
			    callcmd::lock(playerid, "\1");
			}
		}
	}
	return 1;
}

