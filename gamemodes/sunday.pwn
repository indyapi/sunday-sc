			adminVehicle[vehicleid] = false;
			PutPlayerInVehicle(playerid, vehicleid, 0);

			ReloadVehicle(vehicleid);

		    if(!parked)
			{
			    SendClientMessageEx(playerid, COLOR_PINK, "คุณได้เรียกรถรุ่น %s ออกมาแล้ว /จุดจอดรถ ในการค้นหาตำแหน่งปัจจุบัน", ReturnVehicleName(vehicleid));
			}
			
			GivePlayerMoneyEx(playerid, -300);
			SendClientMessage(playerid, COLOR_RED, "[การาจ] : {FFFFFF}คุณได้เสียเงินจำนวน $300 สำหรับค่าเรียกรถ!");
			//SendClientMessageEx(playerid, COLOR_YELLOW, "ระดับจูนรถของคุณคือ Lv.%d", carData[vehicleid][carLevel]);
		}
	}

	return 1;
}

