			SendClientMessageToAllEx(COLOR_LIGHTRED, "สนามบินร้าง > %s จากแก๊ง %s ได้ทำการยึดสนามบินร้างแล้ว!", GetPlayerNameEx(playerid), factionData[factionid][factionName]);
		}
    }

	// สเตเดี้ยม
    if (TakeWarStats[playerid] == 3)
    {
		warPoints[playerid] += 5;
