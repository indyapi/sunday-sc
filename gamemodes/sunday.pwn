StartProgress(playerid, duration, startvalue = 0, objectid)
{
	if(ProgressState[playerid] == 1)
		return 0;

	stop ProgressTimer[playerid];
	ProgressTimer[playerid] = repeat ProgressUpdate(playerid, objectid);

	ProgressLimit[playerid] = duration;
	ProgressCount[playerid] = startvalue;
	ProgressState[playerid] = 1;
	ProgressObject[playerid] = objectid;

	new string[32];

	format(string, sizeof string, "GTA UNITY");
	PlayerTextDrawSetString(playerid, sundayprogressbar[playerid][0], string);

	PlayerTextDrawShow(playerid, sundayprogressbar[playerid][0]);
	PlayerTextDrawShow(playerid, sundayprogressbar[playerid][1]);
	//PlayerTextDrawShow(playerid, sundayprogressbar[playerid][2]);
		
	return 1;
}

StopProgress(playerid)
{
	if(ProgressState[playerid] == 0)
		return 0;

	stop ProgressTimer[playerid];
	ProgressLimit[playerid] = 0;
	ProgressCount[playerid] = 0;
	ProgressState[playerid] = 0;
	ProgressObject[playerid] = INVALID_STREAMER_ID;

	PlayerTextDrawHide(playerid, sundayprogressbar[playerid][0]);
	PlayerTextDrawHide(playerid, sundayprogressbar[playerid][1]);
	//PlayerTextDrawHide(playerid, sundayprogressbar[playerid][2]);
		
	ClearAnimations(playerid);
	return 1;
}

timer ProgressUpdate[100](playerid, objectid)
{
	if(ProgressCount[playerid] >= ProgressLimit[playerid])
	{
		StopProgress(playerid);
		CallLocalFunction("OnProgressFinish", "dd", playerid, objectid);
		return;
	}

	CallLocalFunction("OnProgressUpdate", "ddd", playerid, ProgressCount[playerid], objectid);

	static
		string[32];

	ProgressCount[playerid]++;

	new Float:current_progress;
	if (ProgressLimit[playerid] == 0)
	{ } else { current_progress = (ProgressCount[playerid]*100/ProgressLimit[playerid]); }

	if (current_progress > 1 && current_progress < 10)
	{
		format(string, sizeof string, "~w~S~l~ometime"); //GTA UNITY
		PlayerTextDrawSetString(playerid, sundayprogressbar[playerid][0], string);
	}
	else if (current_progress > 10 && current_progress < 20)
	{
		format(string, sizeof string, "~w~So~l~metime"); //GTA UNITY
		PlayerTextDrawSetString(playerid, sundayprogressbar[playerid][0], string);
	}
	else if (current_progress > 20 && current_progress < 30)
	{
		format(string, sizeof string, "~w~Som~l~etime"); //GTA UNITY
		PlayerTextDrawSetString(playerid, sundayprogressbar[playerid][0], string);
	}
	else if (current_progress > 30 && current_progress < 40)
	{
		format(string, sizeof string, "~w~Some~l~time"); //GTA UNITY
		PlayerTextDrawSetString(playerid, sundayprogressbar[playerid][0], string);
	}
	else if (current_progress > 40 && current_progress < 50)
	{
		format(string, sizeof string, "~w~Somet~l~ime"); //GTA UNITY
		PlayerTextDrawSetString(playerid, sundayprogressbar[playerid][0], string);
	}
	else if (current_progress > 50 && current_progress < 60)
	{
		format(string, sizeof string, "~w~Someti~l~me"); //GTA UNITY
		PlayerTextDrawSetString(playerid, sundayprogressbar[playerid][0], string);
	}
	else if (current_progress > 60 && current_progress < 70)
	{
		format(string, sizeof string, "~w~Sometim~l~e"); //GTA UNITY
		PlayerTextDrawSetString(playerid, sundayprogressbar[playerid][0], string);
	}
	else if (current_progress > 70 && current_progress < 80)
	{
		format(string, sizeof string, "~w~GTA UNITY"); //GTA UNITY
		PlayerTextDrawSetString(playerid, sundayprogressbar[playerid][0], string);
	}
	else if (current_progress > 80 && current_progress < 90)
	{
		format(string, sizeof string, "~h~~h~GTA UNITY"); //GTA UNITY
		PlayerTextDrawSetString(playerid, sundayprogressbar[playerid][0], string);
	}
	else if (current_progress > 90 && current_progress < 100)
	{
		format(string, sizeof string, "~g~~h~~h~GTA UNITY"); //GTA UNITY
		PlayerTextDrawSetString(playerid, sundayprogressbar[playerid][0], string);
	}
	return;
}


