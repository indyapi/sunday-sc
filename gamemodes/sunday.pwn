// Safe ใบคาโค
Dialog:DIALOG_SAFE_INV116(playerid, response, listitem, inputtext[])
{
	if(response)
	{
		switch(listitem)
  		{
  		    case 0: Dialog_Show(playerid, DIALOG_SAFE_INV14, DIALOG_STYLE_INPUT, "{767272}My Safe : {FFFFFF}ใบคาโค", "{FFFFFF}กรุณาระบุจำนวน ใบคาโค ที่คุณต้องการนำเข้า Safe", "ตกลง", "ยกเลิก");
  		    case 1: Dialog_Show(playerid, DIALOG_SAFE_INV15, DIALOG_STYLE_INPUT, "{767272}My Safe : {FFFFFF}ใบคาโค", "{FFFFFF}กรุณาระบุจำนวน ใบคาโค ที่คุณต้องการเอาออกจาก Safe", "ตกลง", "ยกเลิก");
		}
	}
	return 1;
}

Dialog:DIALOG_SAFE_INV14(playerid, response, listitem, inputtext[])
{
	new amount = strval(inputtext);

	if(response)
	{
	    if (Inventory_Count(playerid, "ใบคาโค") < amount)
	        return SendClientMessage(playerid, COLOR_GREY, "คุณมี ใบคาโค ไม่เพียงพอ");

        Inventory_Remove(playerid, "ใบคาโค", amount);
        playerData[playerid][pCocain] += amount;

        SendClientMessageEx(playerid, COLOR_GREEN, "My Safe : ใบคาโค {FFFFFF}คุณได้ทำการฝาก ใบคาโค เข้า Safe จำนวน %d", amount);

		new string100[4096];
		new string2[4096];

		format(string100, sizeof(string100), "{999898}สิ่งของ\t{FFFFFF}จำนวน\n");
		strcat(string2,string100);

		format(string100, sizeof(string100), "{999898}(1) {FFFFFF}เงินแดง\t{FFFFFF}$%d\n", playerData[playerid][pSafeRedMoney]);
		strcat(string2,string100);

		format(string100, sizeof(string100), "{999898}(2) {FFFFFF}เงินเขียว\t{FFFFFF}$%d\n", playerData[playerid][pSafeMoney]);
		strcat(string2,string100);

		format(string100, sizeof(string100), "{999898}(3) {FFFFFF}Ketamine\t{FFFFFF}%d\n", playerData[playerid][pSafeKetamine]);
		strcat(string2,string100);

		format(string100, sizeof(string100), "{999898}(4) {FFFFFF}กัญชา\t{FFFFFF}%d\n", playerData[playerid][pSafeCannabis]);
		strcat(string2,string100);

		format(string100, sizeof(string100), "{999898}(5) {FFFFFF}ใบคาโค\t{FFFFFF}%d\n", playerData[playerid][pCocain]);
		strcat(string2,string100);

		format(string100, sizeof(string100), "{999898}(6) {FFFFFF}โคเคนผง\t{FFFFFF}%d\n", playerData[playerid][pKetamine]);
		strcat(string2,string100);

		format(string100, sizeof(string100), "{999898}(7) {FFFFFF}แพ็คโคเคน\t{FFFFFF}%d\n", playerData[playerid][pCocainPack]);
		strcat(string2,string100);

		format(string100, sizeof(string100), "{999898}(8) {FFFFFF}ปูน\t{FFFFFF}%d\n", playerData[playerid][pPoon]);
		strcat(string2,string100);

		Dialog_Show(playerid, DIALOG_SAFE_INV1, DIALOG_STYLE_TABLIST_HEADERS, "{767272}(My Safe)", string2, "ตกลง", "ยกเลิก");
	}
	return 1;
}

