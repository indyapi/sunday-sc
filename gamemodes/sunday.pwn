forward SpamCheck(playerid);
public SpamCheck(playerid)
{
	playerData[playerid][pSpam] = 0;
}

forward AbsCheck(playerid);
public AbsCheck(playerid)
{
	TogglePlayerControllable(playerid, true);//TogglePlayerControllable(playerid, false);
}

forward Abs2Check(playerid);
public Abs2Check(playerid)
{
    TogglePlayerControllable(playerid, false);
    SetTimerEx("AbsCheck", 1500, 0, "d", playerid);
}

forward TimeCheckV(playerid);
public TimeCheckV(playerid)
{
	settime2 = 0;
}

Dialog:DIALOG_PICKCARZ(playerid, response, listitem, inputtext[])
{
	if (response)
	{
		switch(listitem)
		{
		    case 0:
		    {
				new
				    count,
				    var[32],
					string[4096],
					string2[4096];

				for (new i = 0; i != MAX_CARSHOP; i ++) if (carshopData[i][carshopExists])
				{
				    if(carshopData[i][carshopType] == 1)
				    {
						format(string, sizeof(string), "{FE2E11}%s\t{FFFFFF}%s\n", ReturnVehicleModelName(carshopData[i][carshopModel]), FormatMoney(carshopData[i][carshopPrice]));
						strcat(string2, string);
						format(var, sizeof(var), "CARSHOP%d", count);
						SetPVarInt(playerid, var, i);
						count++;
					}
				}
				if (!count)
				{
					SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}เซิร์ฟเวอร์ยังไม่ได้เพิ่มยานพาหนะลงร้าน");
					return 1;
				}
				format(string, sizeof(string), "{FE2E11}[ชื่อรุ่น]\t{FFFFFF}[ราคา]\n%s", string2);
				Dialog_Show(playerid, DIALOG_BUYCAR, DIALOG_STYLE_TABLIST_HEADERS, "{FE2E11}(ร้านขายจักรยานยนต์)", string, "ซื้อ", "ปิด");
		    }
		    case 1:
		    {
				new
				    count,
				    var[32],
					string[4096],
					string2[4096];

				for (new i = 0; i != MAX_CARSHOP; i ++) if (carshopData[i][carshopExists])
				{
				    if(carshopData[i][carshopType] == 2)
				    {
						format(string, sizeof(string), "{48F3D9}%s\t{FFFFFF}%s\n", ReturnVehicleModelName(carshopData[i][carshopModel]), FormatMoney(carshopData[i][carshopPrice]));
						strcat(string2, string);
						format(var, sizeof(var), "CARSHOP%d", count);
						SetPVarInt(playerid, var, i);
						count++;
					}
				}
				if (!count)
				{
					SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}เซิร์ฟเวอร์ยังไม่ได้เพิ่มยานพาหนะลงร้าน");
					return 1;
				}
				format(string, sizeof(string), "{48F3D9}[ชื่อรุ่น]\t{FFFFFF}[ราคา]\n%s", string2);
				Dialog_Show(playerid, DIALOG_BUYCAR, DIALOG_STYLE_TABLIST_HEADERS, "{48F3D9}(ร้านขายรถยนต์)", string, "ซื้อ", "ปิด");
		    }
		    case 2:
		    {
				new
				    count,
				    var[32],
					string[4096],
					string2[4096];

				for (new i = 0; i != MAX_CARSHOP; i ++) if (carshopData[i][carshopExists])
				{
				    if(carshopData[i][carshopType] == 4)
				    {
						format(string, sizeof(string), "{EC0559}%s\t{FFFFFF}%s\n", ReturnVehicleModelName(carshopData[i][carshopModel]), FormatMoney(carshopData[i][carshopPrice]));
						strcat(string2, string);
						format(var, sizeof(var), "CARSHOP%d", count);
						SetPVarInt(playerid, var, i);
						count++;
					}
				}
				if (!count)
				{
					SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}เซิร์ฟเวอร์ยังไม่ได้เพิ่มยานพาหนะลงร้าน");
					return 1;
				}
				format(string, sizeof(string), "{EC0559}[ชื่อรุ่น]\t{FFFFFF}[ราคา]\n%s", string2);
				Dialog_Show(playerid, DIALOG_BUYCAR, DIALOG_STYLE_TABLIST_HEADERS, "{EC0559}(ร้านขายรถสปอร์ต)", string, "ซื้อ", "ปิด");
		    }
		}
	}
	return 1;
}

Dialog:DIALOG_BUYCAR(playerid, response, listitem, inputtext[])
{
	if (response)
	{
	    new var[32], string[512], query[256];
	    format(var, sizeof(var), "CARSHOP%d", listitem);
	    new carshopid = GetPVarInt(playerid, var);

		if (GetPlayerMoneyEx(playerid) < carshopData[carshopid][carshopPrice])
		{
		    SendClientMessageEx(playerid, COLOR_RED, "[ระบบ] {FFFFFF}คุณมีเงินเขียวไม่เพียงพอในการซื้อ ($%d/$%d)", GetPlayerMoneyEx(playerid), carshopData[carshopid][carshopPrice]);
		    return 1;
		}

		mysql_format(g_SQL, query, sizeof(query), "INSERT INTO vehicles (carOwnerID, carOwner, carModel, carPrice, carFuel, carPosX, carPosY, carPosZ, carPosA) VALUES(%d, '%s', %d, %d, %.1f, '562.3970', '-1283.8485', '17.0007', '0.0000')", playerData[playerid][pID], GetPlayerNameEx(playerid), carshopData[carshopid][carshopModel], carshopData[carshopid][carshopPrice], vehicleData[carshopData[carshopid][carshopModel] - 400][vFuel]);
		mysql_tquery(g_SQL, query);

		GivePlayerMoneyEx(playerid, -carshopData[carshopid][carshopPrice]);

		format(string, sizeof(string), "{FFFFFF}คุณได้ซื้อรถรุ่น {F9C205}%s {FFFFFF}ในราคา {F9C205}$%d {FFFFFF}เรียบร้อยแล้ว", ReturnVehicleModelName(carshopData[carshopid][carshopModel]), carshopData[carshopid][carshopPrice]);
		Dialog_Show(playerid, ShowOnly, DIALOG_STYLE_MSGBOX, "{F9C205}(ข้อความจาก Sale ขายรถ)", string, "ตกลง", "");
	}
	return 1;
}

