// --> ระบบ Hitman

alias:killplayer("จ้างฆ่า")
CMD:killplayer(playerid, params[])
{
	new targetid, price;

	if (GetFactionType(playerid) == FACTION_HITMAN)
	    return SendClientMessage(playerid, COLOR_GREY, "คุณเป็น Hitman ไม่สามารถจ้างฆ่าใครได้");

	if (Hitman_GetCount(playerid) != 0)
	    return SendClientMessage(playerid, COLOR_GREY, "คุณมีการจ้างวานฆ่าค้างอยู่");

	if (sscanf(params, "ud", targetid, price))
		return SendClientMessage(playerid, COLOR_GREY, "การใช้งาน : {FFFFFF}/จ้างฆ่า (ไอดีผู้เล่น/ชื่อบางส่วน) (ค่าหัว)");

	if (targetid == INVALID_PLAYER_ID)
		return SendClientMessage(playerid, COLOR_GREY, "ผู้เล่นนั้นตัดการเชื่อมต่อ");

	if (targetid == playerid)
		return SendClientMessage(playerid, COLOR_GREY, "คุณไม่สามารถจ้างฆ่าตัวเองได้");

	if (GetFactionType(targetid) == FACTION_HITMAN)
		return SendClientMessage(playerid, COLOR_GREY, "คุณไม่สามารถจ้างฆ่า Hitman ได้");

	if (price < 0 || price > 20000)
		return SendClientMessage(playerid, COLOR_GREY, "ค่าหัวต้องอยู่ระหว่าง $0 - $20,000");

	if (GetPlayerMoneyEx(playerid) < price)
	    return SendClientMessage(playerid, COLOR_GREY, "คุณมีเงินในธนาคารไม่เพียงพอ");

    Hitman_Add(playerid, targetid, price);

	SendClientMessageEx(playerid, -1, "{FC4D4D}(Hitman) : คุณได้ทำการจ้างฆ่า {FC4D4D}%s {FFFFFF}ในราคา {FC4D4D}$%d", GetPlayerNameEx(targetid), price);
    SendClientMessage(playerid, -1, "{F8CE11}(แนะนำ) : {FFFFFF}การจ้างฆ่าครั้งนี้ถูกส่งหา Hitman ทุกคนที่ออนไลน์แล้ว");

	return 1;
}

CMD:hitman(playerid, params[])
{
	if (GetFactionType(playerid) != FACTION_HITMAN)
	    return SendClientMessage(playerid, COLOR_GREY, "คุณไม่ใช่ Hitman");

	new
		string[1024],
		string2[1024];

	for (new i = 0; i != MAX_HITMAN; i ++)
	{
	    if (!hitmanData[i][hitmanExists])
			continue;

		new hitmanname = hitmanData[i][hitmanTarget];

		format(string, sizeof(string), "{FFFFFF}ไอดี : {F8EA0D}%d\t{FFFFFF}เป้าหมาย : {F8EA0D}%s\t{FFFFFF}ค่าหัว : {F8EA0D}%d\n", hitmanData[i][hitmanID], GetPlayerNameEx(hitmanname), hitmanData[i][hitmanPrice]);
        strcat(string2, string);

		//break;
	}

	format(string, sizeof(string), "{F8EA0D}(ไอดี)\t{F8EA0D}(เป้าหมาย)\t{F8EA0D}(ค่าหัว)\n%s", string2);
	Dialog_Show(playerid, ShowOnly, DIALOG_STYLE_TABLIST_HEADERS, "{F80D46}(รายการจ้างวานฆ่า Hitman)", string, "ปิด", "");

	return 1;
}

Hitman_Add(playerid, userid, price)
{
	for(new i = 0; i != MAX_HITMAN; ++ i)
	{
	    if (!hitmanData[i][hitmanExists])
	    {
		    hitmanData[i][hitmanID] = i;
		    hitmanData[i][hitmanExists] = true;
	        hitmanData[i][hitmanTarget] = userid;
	        hitmanData[i][hitmanPrice] = price;
	        hitmanData[i][hitmanRent] = playerid;

			foreach (new x : Player)
			{
				if (GetFactionType(x) == FACTION_HITMAN) {
					SendClientMessage(x, -1, "{696969}(การจ้างวาน Hitman) | {FFFFFF}มีงานจ้างใหม่เข้ามา /hitman เพื่อตรวจสอบ {696969}))");
				}
			}

	        playerData[userid][pHitman] = 1;
			SendClientMessageEx(userid, COLOR_LIGHTRED, "(โปรดระวังตัว) คุณถูกตั้งค่าหัวเป็นจำนวนเงิน {FFFFFF}$%d (โดย %s)", price, GetPlayerNameEx(playerid));
			return i;
		}
	}
	return -1;
}

Hitman_Remove(hitmanid)
{
	if (hitmanid != -1 && hitmanData[hitmanid][hitmanExists])
	{
	    hitmanData[hitmanid][hitmanExists] = false;

		hitmanData[hitmanid][hitmanID] = -1;
		hitmanData[hitmanid][hitmanTarget] = -1;
		hitmanData[hitmanid][hitmanPrice] = 0;
		hitmanData[hitmanid][hitmanRent] = -1;
	}
	return 1;
}

Hitman_Clear(playerid)
{
    for (new i = 0; i != MAX_HITMAN; i ++)
	{
	    if (hitmanData[i][hitmanExists] && hitmanData[i][hitmanRent] == playerid)
	    {
	        Hitman_Remove(i);
		}

	    if (hitmanData[i][hitmanExists] && hitmanData[i][hitmanTarget] == playerid)
	    {
	        Hitman_Remove(i);
		}
	}
	return 1;
}

Hitman_GetCount(playerid)
{
	new count;

    for (new i = 0; i != MAX_HITMAN; i ++)
	{
	    if (hitmanData[i][hitmanExists] && hitmanData[i][hitmanRent] == playerid)
	    {
	        count++;
		}
	}
	return count;
}

forward FriskInventory999(playerid, userid);
public FriskInventory999(playerid, userid)
{
    if (playerData[userid][IsLoggedIn] == false)
	    return 0;

	new
		string[512],
		string2[512],
		count,
		var[32];

    for (new i = 0; i < playerData[userid][pMaxItem]; i ++)
	{
 		if (invData[userid][i][invExists]) {
   			format(string, sizeof(string), "%s\t{D0AEEB}({FFFFFF}%d{D0AEEB})\n", invData[userid][i][invItem], invData[userid][i][invQuantity]);
   			strcat(string2, string);
   			format(var, sizeof(var), "itemlistza%d", count);
   			SetPVarInt(playerid, var, i);
   			count++;
		}
	}
	if (!count) {
		SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}ผู้เล่นนั้นไม่มีไอเท็มอยู่ในตัวเลย");
		return 1;
	}
	playerData[playerid][pTargetFrisk] = userid;
	format(string, sizeof(string), "ชื่อ\tความจุ (%d/%d)\n%s", Inventory_Items(userid), playerData[userid][pMaxItem], string2);
	return Dialog_Show(playerid, DIALOG_INVENTORY234, DIALOG_STYLE_TABLIST_HEADERS, "[กระเป๋า]", string, "เลือก", "ปิด");
}

Dialog:DIALOG_INVENTORY234(playerid, response, listitem, inputtext[])
{
	if (response)
	{
	    new userid = playerData[playerid][pTargetFrisk];
		new var[32];
		format(var, sizeof(var), "itemlistza%d", listitem);
		new item = GetPVarInt(playerid, var);

        FriskItemInventory(playerid, item, invData[userid][item][invItem]);
	}
	return 1;
}

