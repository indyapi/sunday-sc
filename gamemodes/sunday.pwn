Dialog:DIALOG_LOCKERWP(playerid, response, listitem, inputtext[])
{
	new factionid = playerData[playerid][pFaction];

	if (factionid == -1 || !IsNearFactionLocker(playerid))
		return 0;

	if (response)
	{
		switch(listitem)
		{
		    case 0:
		    {
		        if (factionData[factionid][factionWeapons][0] == 0)
		            return SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}ไม่มีอาวุธอยู่ในตู้เซฟ");

		        if (factionData[factionid][factionAmmo][0] == 0)
		            return SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}ไม่มีอาวุธอยู่ในตู้เซฟ");

		        GivePlayerWeaponEx(playerid, factionData[factionid][factionWeapons][0], factionData[factionid][factionAmmo][0]);
				SendClientMessageEx(playerid, COLOR_GREY, "คุณได้รับอาวุธ {FFFFFF}%s จำนวน %d นัด",factionData[factionid][factionWeapons][0], factionData[factionid][factionAmmo][0]);
		    }
		    case 1:
		    {
		        if (factionData[factionid][factionWeapons][1] == 0)
		            return SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}ไม่มีอาวุธอยู่ในตู้เซฟ");

		        if (factionData[factionid][factionAmmo][1] == 0)
		            return SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}ไม่มีอาวุธอยู่ในตู้เซฟ");

		        GivePlayerWeaponEx(playerid, factionData[factionid][factionWeapons][1], factionData[factionid][factionAmmo][1]);
				SendClientMessageEx(playerid, COLOR_GREY, "คุณได้รับอาวุธ {FFFFFF}%s จำนวน %d นัด",factionData[factionid][factionWeapons][1], factionData[factionid][factionAmmo][1]);
		    }
		    case 2:
		    {
		        if (factionData[factionid][factionWeapons][2] == 0)
		            return SendClientMessage(playerid, COLOR_RED, "[ระบบ] {FFFFFF}ไม่มีอาวุธอยู่ในตู้เซฟ");

