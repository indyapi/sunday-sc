Dialog:DIALOG_BUYFOOD2(playerid, response, listitem, inputtext[])
{
	new amount = strval(inputtext);
	if (response)
	{
	    switch(itemType[playerid])
	    {
			case 0:
   		 	{
				new itemname[24];
				itemname = "ผัดกระเพรา";
				new price = 50*amount;

				if (GetPlayerMoneyEx(playerid) < price)
				    return SendClientMessageEx(playerid, COLOR_RED, "[ERROR!] {FFFFFF}เงินไม่พอซื้อ {00FF00}%s{FFFFFF} (%s/%s)", itemname, FormatMoney(GetPlayerMoneyEx(playerid)), FormatMoney(price));

				if (amount <= 0)
				    return 1;

				new count = Inventory_Count(playerid, itemname)+1;

				if (count > 20)
                    return SendClientMessageEx(playerid, COLOR_RED, "[ERROR!] {FFFFFF}ซื้อ {00FF00}%s{FFFFFF} ได้ไม่เกิน 20 เพราะมันจะเสียเอานะ", itemname);

				new id = Inventory_Add(playerid, itemname, amount);

				if (id == -1)
				    return SendClientMessageEx(playerid, COLOR_RED, "[ERROR!] {FFFFFF} กระเป๋าคุณเล็กเกินไป (%d/%d)", Inventory_Items(playerid), playerData[playerid][pMaxItem]);

				GivePlayerMoneyEx(playerid, -price);

				SendClientMessageEx(playerid, COLOR_GREEN, "[ร้านอาหาร] {FFFFFF}ซื้อ {00FF00}%s{FFFFFF}(+%d) - ราคา {00FF00}%s", itemname, amount, FormatMoney(price));
			}
