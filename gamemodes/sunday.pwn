alias:moneyall("แจกเงินทั้งหมด")
CMD:moneyall(playerid, params[])
{
    if(playerData[playerid][pDevMode] >= 7)
    {
    	new amount;
        if(sscanf(params, "d", amount))
			return SendClientMessage(playerid, COLOR_WHITE, "/moneyall [จำนวน]");

        foreach (new i : Player){
			GivePlayerMoneyEx(i, amount);
		}

        SendClientMessageToAllEx(COLOR_ORANGE, "แอดมินซันได้แจกเงินชดเชยจำนวน %s ให้กับทุกคน!", FormatMoney(amount));
	}
    return 1;
}

alias:giveexpall("แจกประสบการณ์ทั้งหมด")
CMD:giveexpall(playerid, params[])
{
    if(playerData[playerid][pDevMode] >= 2)
    {
    	new amount;
        if(sscanf(params, "d", amount))
			return SendClientMessage(playerid, COLOR_WHITE, "/giveexpall [จำนวน]");

        foreach (new i : Player){
			playerData[i][pExp] += amount;
		}

        SendClientMessageToAllEx(COLOR_ORANGE, "แอดมินซัน ได้แจก Exp จำนวน %d ให้กับทุกคน!", amount);
	}
    return 1;
}

alias:giveitemall("แจกของทั้งหมด")
CMD:giveitemall(playerid,params[])
{
    if (playerData[playerid][pDevMode] < 7)
	    return 1;

	new item[32], amount;
	if(sscanf(params, "s[32]d", item, amount)) return SendClientMessage(playerid, COLOR_WHITE, "/giveitemall [ชื่อไอเท็ม] [จำนวน]");

	for (new i = 0; i < sizeof(itemData); i ++) if (!strcmp(itemData[i][itemName], item, true))
	{
	    foreach (new x : Player)
		{
	        Inventory_Add(x, itemData[i][itemName], amount);
	    }
	    SendAdminMessage(COLOR_ADMIN, "AdmLog: %s ได้ให้ไอเท็ม %s จำนวน %d กับผู้เล่นทุกคนในเซิร์ฟเวอร์", GetPlayerNameEx(playerid), item, amount);
		return 1;
	}
	SendClientMessageEx(playerid, COLOR_RED, "[ระบบ] {FFFFFF}ไม่มีไอเท็ม %s อยู่ในระบบ (คำสั่ง /itemlist ในการเช็ครายชื่อไอเท็ม)", item);
	return 1;
}

//รีรถส่วนตัว
alias:repcar("รีรถส่วนตัว")
CMD:repcar(playerid, params[])
{
    if (playerData[playerid][pAdmin] < 1)
	    return 1;

	for(new i = 1; i < MAX_VEHICLES; i ++)
	{
		if(carData[i][carID] > 0 && carData[i][carOwnerID] != 0)
   		{
			if(GetVehicleDriver(i) == INVALID_PLAYER_ID)
			{
				DespawnVehicle(i);
			}
		}
    }
    SendClientMessage(playerid, COLOR_PINK, "คุณได้ทำการรีรถส่วนตัวผู้เล่นกลับเข้า Garage แล้ว");
    return 1;
}


alias:rehpall("เกิดใหม่ทั้งหมด")
CMD:rehpall(playerid, params[])
{
    if(playerData[playerid][pDevMode] > 1)
    {
		foreach(new i : Player)
		{
		    if (playerData[i][pInjured] == 1)
		    {
				SetPlayerHealth(i, 100);
				SetPlayerWeather(i, globalWeather);
			    playerData[i][pInjured] = 0;
			    playerData[i][pInjuredTime] = 0;
			    ClearAnimations(i);
			}
		}

        SendAdminMessage(COLOR_ADMIN, "{FF0000}[?] {FFFFFF}%s {99FF33}ได้ชุบชีวิตผู้เล่นทุกคนในเซิร์ฟเวอร์", GetPlayerNameEx(playerid));
    }
    return 1;
}

CMD:lights(playerid, params[])
{
	new vehicleid = GetPlayerVehicleID(playerid);

	if (!IsEngineVehicle(vehicleid))
		return SendClientMessage(playerid, COLOR_LIGHTRED, "คุณไม่ได้อยู่ในยานพาหนะ");

	if (GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
	    return SendClientMessage(playerid, COLOR_LIGHTRED, "คุณไม่สามารถทำแบบนี้ได้ คุณไม่ใช่คนขับ");

	switch (GetLightStatus(vehicleid))
	{
	    case false:
	    {
	        SetLightStatus(vehicleid, true);
	        SendNearbyMessage(playerid, 30.0, COLOR_PURPLE, "** %s ได้เปิดไฟหน้ารถ", GetPlayerNameEx(playerid));
		}
		case true:
		{
		    SetLightStatus(vehicleid, false);
	        SendNearbyMessage(playerid, 30.0, COLOR_PURPLE, "** %s ได้ปิดไฟหน้ารถ", GetPlayerNameEx(playerid));
		}
	}
	return 1;
}

stock GetLightStatus(vehicleid)
{
	new
	    engine,
	    lights,
	    alarm,
	    doors,
	    bonnet,
	    boot,
	    objective;

	GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);

	if (lights != 1)
		return 0;

	return 1;
}

stock SetLightStatus(vehicleid, bool:status)
{
	new
	    engine,
	    lights,
	    alarm,
	    doors,
	    bonnet,
	    boot,
	    objective;

	GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
	return SetVehicleParamsEx(vehicleid, engine, status, alarm, doors, bonnet, boot, objective);
}

