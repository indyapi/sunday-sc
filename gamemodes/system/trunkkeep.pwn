                 //       return SendClientMessageEx(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} %s ท้ายรถเต็ม....(100)", NameItem);

				if(carData[vehicleid][carTrunkLv] == 1)
                {
                    if (carData[vehicleid][carFishShark] >= 50)
                        return SendClientMessage(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} ไอเท็มนี้ ท้ายรถเต็ม....(50)");

                    Dialog_Show(playerid, D_TKshark1, DIALOG_STYLE_INPUT, "{80FF00}[ %s ]", "จำนวนที่ต้องการใส่เข้าไป คือ","ใส่เข้าไป","ยกเลิก", NameItem);
                }
                if(carData[vehicleid][carTrunkLv] == 2)
                {
                    if (carData[vehicleid][carFishShark] >= 100)
                        return SendClientMessage(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} ไอเท็มนี้ ท้ายรถเต็ม....(100)");

                    Dialog_Show(playerid, D_TKshark1, DIALOG_STYLE_INPUT, "{80FF00}[ %s ]", "จำนวนที่ต้องการใส่เข้าไป คือ","ใส่เข้าไป","ยกเลิก", NameItem);
                }
                if(carData[vehicleid][carTrunkLv] == 3)
                {
                    if (carData[vehicleid][carFishShark] >= 300)
                        return SendClientMessage(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} ไอเท็มนี้ ท้ายรถเต็ม....(300)");

                    Dialog_Show(playerid, D_TKshark1, DIALOG_STYLE_INPUT, "{80FF00}[ %s ]", "จำนวนที่ต้องการใส่เข้าไป คือ","ใส่เข้าไป","ยกเลิก", NameItem);
                }
			}
			case 1:
			{
				Dialog_Show(playerid, D_TKshark2, DIALOG_STYLE_INPUT, "{80FF00}[ ปลาฉลาม ]", "จำนวนที่ต้องการนำออกมา คือ","นำออกมา","ยกเลิก");
			}
		}
	}
	return 1;
}

Dialog:D_TKshark1(playerid, response, listitem, inputtext[])
{
	new amount = strval(inputtext);
	new vehicleid = GetVehicleModel(GetPlayerVehicleID(playerid));
	new query[300];
	if(vehicleid != INVALID_VEHICLE_ID && IsVehicleOwner(playerid, vehicleid))
	{
        if (response)
        {
            new NameItem[64];
            NameItem = "ปลาฉลาม";
            if (amount <= 0)
                return SendClientMessage(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} 0 ตัวเดียวไม่มีค่า....");

            if (Inventory_Count(playerid, "ปลาฉลาม") < amount)
                return SendClientMessageEx(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} %s ไม่พอ....", NameItem);

            if(carData[vehicleid][carTrunkLv] == 1)
            {
                if (amount > 50)
                    return SendClientMessageEx(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} พื้นที่เก็บไอเท็ม....%s(50)", NameItem);
            }
            if(carData[vehicleid][carTrunkLv] == 2)
            {
                if (amount > 100)
                    return SendClientMessageEx(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} พื้นที่เก็บไอเท็ม....%s(100)", NameItem);
            }
            if(carData[vehicleid][carTrunkLv] == 3)
            {
                if (amount > 300)
                    return SendClientMessageEx(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} พื้นที่เก็บไอเท็ม....%s(300)", NameItem);
            }

            new NamePlayer[128];
            NamePlayer = GetPlayerNameEx(playerid);
            carData[vehicleid][carFishShark] += amount;
            Inventory_Remove(playerid, "ปลาฉลาม", amount);

            new gString[256];
		    format(gString, sizeof(gString), "INSERT INTO trunklog (givePlayerID, givePlayerName, giveItem, giveAmount, carID) VALUES('%d', '%s', '[+] ปลาฉลาม', '%d', '%d')", playerData[playerid][pID], GetPlayerNameEx(playerid), amount, carData[vehicleid][carID]);
		    mysql_tquery(g_SQL, gString);

            mysql_format(g_SQL, query, sizeof(query), "UPDATE vehicles SET carFishShark = %d WHERE carID = %d", carData[vehicleid][carFishShark], carData[vehicleid][carID]);
            mysql_tquery(g_SQL, query);
    
            SendClientMessageEx(playerid, COLOR_LIGHTBLUE, "[TRUNK] : {FFFFFF}ฝาก %s จำนวน %d", NameItem, amount);
            printf("[TRUNK] : deposit 'Fish Shark' %d (By : %s)", amount, NamePlayer);
        }
        else
        {
            SendClientMessage(playerid, COLOR_RED, "[ ERROR! ] {FFFFFF}รถอยู่ไกลเกินไป....");
        }
	}
	return 1;
}

Dialog:D_TKshark2(playerid, response, listitem, inputtext[])
{
	new amount = strval(inputtext);
	new vehicleid = GetVehicleModel(GetPlayerVehicleID(playerid));
	new query[300];
	if(vehicleid != INVALID_VEHICLE_ID && IsVehicleOwner(playerid, vehicleid))
	{
        if (response)
        {
            new NameItem[64];
            NameItem = "ปลาฉลาม";
            if (amount <= 0)
                return SendClientMessage(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} 0 ตัวเดียวไม่มีค่า....");

            if (carData[vehicleid][carFishShark] < amount)
                return SendClientMessageEx(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} %s ในรถไม่พอ....", NameItem);

            new NamePlayer[128];
            NamePlayer = GetPlayerNameEx(playerid);
            carData[vehicleid][carFishShark] -= amount;
            Inventory_Add(playerid, "ปลาฉลาม", amount);

            new gString[256];
		    format(gString, sizeof(gString), "INSERT INTO trunklog (givePlayerID, givePlayerName, giveItem, giveAmount, carID) VALUES('%d', '%s', '[-] ปลาฉลาม', '%d', '%d')", playerData[playerid][pID], GetPlayerNameEx(playerid), amount, carData[vehicleid][carID]);
		    mysql_tquery(g_SQL, gString);

            mysql_format(g_SQL, query, sizeof(query), "UPDATE vehicles SET carFishShark = %d WHERE carID = %d", carData[vehicleid][carFishShark], carData[vehicleid][carID]);
            mysql_tquery(g_SQL, query);

            SendClientMessageEx(playerid, COLOR_LIGHTBLUE, "[TRUNK] : {FFFFFF}ถอน %s จำนวน %d", NameItem, amount);
            printf("[TRUNK] : withdraw 'Fish Shark' %d (By : %s)", amount, NamePlayer);
        }
        else
        {
            SendClientMessage(playerid, COLOR_RED, "[ ERROR! ] {FFFFFF}รถอยู่ไกลเกินไป....");
        }
	}
	return 1;
}

