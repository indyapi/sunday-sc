Dialog:D_TKmoeny1(playerid, response, listitem, inputtext[])
{
	new amount = strval(inputtext);
	new vehicleid = GetVehicleModel(GetPlayerVehicleID(playerid));
	new query[300];
	if(vehicleid != INVALID_VEHICLE_ID && IsVehicleOwner(playerid, vehicleid))
	{
        if (response)
        {
            if (amount <= 0)
                return SendClientMessage(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} 0 ตัวเดียวไม่มีค่า....");

            if (amount < 1 || amount > GetPlayerMoneyEx(playerid))
                return SendClientMessage(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} เงินไม่พอ....");

            if(carData[vehicleid][carTrunkLv] == 1)
            {
                if (amount > 100000)
                    return SendClientMessage(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} พื้นที่เก็บเงิน....($100,000)");
            }
            if(carData[vehicleid][carTrunkLv] == 2)
            {
                if (amount > 500000)
                    return SendClientMessage(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} พื้นที่เก็บเงิน....($500,000)");
            }
            if(carData[vehicleid][carTrunkLv] == 3)
            {
                if (amount > 1000000)
                    return SendClientMessage(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} พื้นที่เก็บเงิน....($1,000,000)");
            }

            new NameItem[64];
            NameItem = "เงินเขียว";
            new NamePlayer[128];
            NamePlayer = GetPlayerNameEx(playerid);
            carData[vehicleid][carMoney] += amount;
            GivePlayerMoneyEx(playerid, -amount);

            new gString[256];
		    format(gString, sizeof(gString), "INSERT INTO trunklog (givePlayerID, givePlayerName, giveItem, giveAmount, carID) VALUES('%d', '%s', '[+] เงินเขียว', '%d', '%d')", playerData[playerid][pID], GetPlayerNameEx(playerid), amount, carData[vehicleid][carID]);
		    mysql_tquery(g_SQL, gString);

            mysql_format(g_SQL, query, sizeof(query), "UPDATE vehicles SET carMoney = %d WHERE carID = %d", carData[vehicleid][carMoney], carData[vehicleid][carID]);
            mysql_tquery(g_SQL, query);
    
            SendClientMessageEx(playerid, COLOR_LIGHTBLUE, "[TRUNK] : {FFFFFF}ฝาก %s จำนวน %d บาท", NameItem, amount);
            printf("[TRUNK] : deposit 'Money' %d (By : %s)", amount, NamePlayer);
        }
        else
        {
            SendClientMessage(playerid, COLOR_RED, "[ ERROR! ] {FFFFFF}รถอยู่ไกลเกินไป....");
        }
	}
	return 1;
}

Dialog:D_TKmoeny2(playerid, response, listitem, inputtext[])
{
	new amount = strval(inputtext);
	new vehicleid = GetVehicleModel(GetPlayerVehicleID(playerid));
	new query[300];
	if(vehicleid != INVALID_VEHICLE_ID && IsVehicleOwner(playerid, vehicleid))
	{
        if (response)
        {
            if (amount <= 0)
                return SendClientMessage(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} 0 ตัวเดียวไม่มีค่า....");

            if (carData[vehicleid][carMoney] < amount)
                return SendClientMessage(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} เงินในรถไม่พอ....");

            new NameItem[64];
            NameItem = "เงินเขียว";
            new NamePlayer[128];
            NamePlayer = GetPlayerNameEx(playerid);
            carData[vehicleid][carMoney] -= amount;
            GivePlayerMoneyEx(playerid, amount);

            new gString[256];
		    format(gString, sizeof(gString), "INSERT INTO trunklog (givePlayerID, givePlayerName, giveItem, giveAmount, carID) VALUES('%d', '%s', '[-] เงินเขียว', '%d', '%d')", playerData[playerid][pID], GetPlayerNameEx(playerid), amount, carData[vehicleid][carID]);
		    mysql_tquery(g_SQL, gString);

            mysql_format(g_SQL, query, sizeof(query), "UPDATE vehicles SET carMoney = %d WHERE carID = %d", carData[vehicleid][carMoney], carData[vehicleid][carID]);
            mysql_tquery(g_SQL, query);

            SendClientMessageEx(playerid, COLOR_LIGHTBLUE, "[TRUNK] : {FFFFFF}ถอน %s จำนวน %d บาท", NameItem, amount);
            printf("[TRUNK] : withdraw 'Money' %d (By : %s)", amount, NamePlayer);
        }
        else
        {
            SendClientMessage(playerid, COLOR_RED, "[ ERROR! ] {FFFFFF}รถอยู่ไกลเกินไป....");
        }
	}
	return 1;
}

