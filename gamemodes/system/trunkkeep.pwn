			case 1:
			{
				Dialog_Show(playerid, D_TKGolf2, DIALOG_STYLE_INPUT, "{80FF00}[ ไม้กอล์ฟ ]", "จำนวนที่ต้องการนำออกมา คือ","นำออกมา","ยกเลิก");
			}
		}
	}
