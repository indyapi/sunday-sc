CMD:tk(playerid)
{
    //if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 402)
    //{
    if (GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
        new vehicleid = GetVehicleModel(GetPlayerVehicleID(playerid));
        if(vehicleid != INVALID_VEHICLE_ID && IsVehicleOwner(playerid, vehicleid) && carData[vehicleid][carTrunkLv] == 1)
        {
            new string100[1024];
            new string2[1024];

            format(string100, sizeof(string100), "{FFFFFF}[รายการ]\n");
            strcat(string2,string100);

            format(string100, sizeof(string100), "[+] {FFB600}ช่องเก็บเงิน\n");
            strcat(string2,string100);

            format(string100, sizeof(string100), "[+] {FFB600}ช่องเก็บอาวุธ\n");
            strcat(string2,string100);

            format(string100, sizeof(string100), "[+] {FFB600}ช่องเก็บงานขาว\n");
            strcat(string2,string100);

            Dialog_Show(playerid, D_KeepTrunk, DIALOG_STYLE_TABLIST_HEADERS, "{00FFFB}[ ช่องเก็บของบนรถ ]", string2, "Select", "Close");
        }
    }
    else
    {
        SendClientMessage(playerid, COLOR_RED, "[ ERROR! ] {FFFFFF}ต้องอยู่บนรถ....");
    }
	return 1;
}

Dialog:D_KeepTrunk(playerid, response, listitem, inputtext[])
{
    if (response)
	{
	    switch(listitem)
	    {
	        case 0:
	        {
                new vehicleid =  GetVehicleModel(GetPlayerVehicleID(playerid));
                if(vehicleid != INVALID_VEHICLE_ID && IsVehicleOwner(playerid, vehicleid))
                {
                    new string100[1024];
                    new string2[1024];

                    format(string100, sizeof(string100), "{FFFFFF}[รายการ]\t{FFFFFF}[จำนวน]\n");
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{80FF00}เงินเขียว\t( $%d )\n", carData[vehicleid][carMoney]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{FF0000}เงินแดง\t( $%d )\n", carData[vehicleid][carRMoney]);
                    strcat(string2,string100);

                    Dialog_Show(playerid, D_TrunkMoney, DIALOG_STYLE_TABLIST_HEADERS,"{00FFFB}[ ช่องเก็บเงิน ]", string2, "Select", "Close");
                }
                else
                {
                    SendClientMessage(playerid, COLOR_RED, "[ ERROR! ] {FFFFFF}รถอยู่ไกลเกินไป....");
                }
            }
            case 1:
            {
                new vehicleid = GetVehicleModel(GetPlayerVehicleID(playerid));
                if(vehicleid != INVALID_VEHICLE_ID && IsVehicleOwner(playerid, vehicleid))
                {
                    new string100[5000];
                    new string2[5000];

                    format(string100, sizeof(string100), "{FFFFFF}[รายการ]\t{FFFFFF}[จำนวน]\n");
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}สนับมือ\t( %d )\n", carData[vehicleid][carKnuckles]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}ดอกไม้\t( %d )\n", carData[vehicleid][carFlower]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}ดิลโด้\t( %d )\n", carData[vehicleid][carDildo]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}ไม้พูล\t( %d )\n", carData[vehicleid][carPool]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}ไม้กอล์ฟ\t( %d )\n", carData[vehicleid][carGolf]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}พลั่ว\t( %d )\n", carData[vehicleid][carSholver]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}คาตานะ\t( %d )\n", carData[vehicleid][carKatana]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}กระบองตำรวจ\t( %d )\n", carData[vehicleid][carPDbong]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}ไม้แซ่\t( %d )\n", carData[vehicleid][carWooden]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}มีดสั้น\t( %d )\n", carData[vehicleid][carKnife]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}ปืนช็อต\t( %d )\n", carData[vehicleid][carGunShot]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}กระสุน\t( %d )\n", carData[vehicleid][carAmmo]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}เสื้อเกราะ\t( %d )\n", carData[vehicleid][carProtect]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}ปากฉลาม\t( %d )\n", carData[vehicleid][carShrkKnife]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}ไม้เบส\t( %d )\n", carData[vehicleid][carBasball]);
                    strcat(string2,string100);

                    Dialog_Show(playerid, D_TrunkWeapon, DIALOG_STYLE_TABLIST_HEADERS,"{00FFFB}[ ช่องเก็บอาวุธ ]", string2, "Select", "Close");
                }
                else
                {
                    SendClientMessage(playerid, COLOR_RED, "[ ERROR! ] {FFFFFF}รถอยู่ไกลเกินไป....");
                }
            }
            case 2:
	        {
                new vehicleid = GetVehicleModel(GetPlayerVehicleID(playerid));
                if(vehicleid != INVALID_VEHICLE_ID && IsVehicleOwner(playerid, vehicleid))
                {
                    new string100[7000];
                    new string2[7000];

                    format(string100, sizeof(string100), "{FFFFFF}[รายการ]\t{FFFFFF}[จำนวน]\n");
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}แพ็กมะม่วง\t( %d )\n", carData[vehicleid][carMangoPack]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}แพ็กมะเขือเทศ\t( %d )\n", carData[vehicleid][carTomatoPack]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}แพ็กลิ้นจี่\t( %d )\n", carData[vehicleid][carLyncheePack]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}แพ็กมะพร้าว\t( %d )\n", carData[vehicleid][carCoconutPack]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}แพ็กแอปเปิ้ล\t( %d )\n", carData[vehicleid][carApplePack]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}ปลาเก๋า\t( %d )\n", carData[vehicleid][carFishGou]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}ปลาช่อน\t( %d )\n", carData[vehicleid][carFishChon]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}ปลาดอลลี่\t( %d )\n", carData[vehicleid][carFishDolly]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}ปลานิล\t( %d )\n", carData[vehicleid][carFishNil]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}ปลากระพง\t( %d )\n", carData[vehicleid][carFishKrapong]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}ปลาทับทิม\t( %d )\n", carData[vehicleid][carFishTaptim]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}ปลาดุก\t( %d )\n", carData[vehicleid][carFishDuk]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}ปลาทูน่า\t( %d )\n", carData[vehicleid][carFishToona]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}ปลาแซลมอน\t( %d )\n", carData[vehicleid][carFishSalmon]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}ปลากระเบน\t( %d )\n", carData[vehicleid][carFishKraben]);
                    strcat(string2,string100);

                    format(string100, sizeof(string100), "{00FFF7}ปลาฉลาม\t( %d )\n", carData[vehicleid][carFishShark]);
                    strcat(string2,string100);

                    Dialog_Show(playerid, D_TrunkJob, DIALOG_STYLE_TABLIST_HEADERS,"{00FFFB}[ ช่องเก็บงานขาว ]", string2, "Select", "Close");
                }
                else
                {
                    SendClientMessage(playerid, COLOR_RED, "[ ERROR! ] {FFFFFF}รถอยู่ไกลเกินไป....");
                }
            }
        }
    }
    return 1;
}

Dialog:D_TrunkMoney(playerid, response, listitem, inputtext[])
{
	if (response)
	{
	    switch(listitem)
	    {
	        case 0:
	        {
				Dialog_Show(playerid, D_TKmoeny, DIALOG_STYLE_LIST, "{80FF00}[ เงินเขียว ]",
                "[+] ใส่เข้าไป\n\
                 [-] นำออกมา",
                "Select","Close");
	        }
	        case 1:
	        {
				Dialog_Show(playerid, D_TKrmoeny, DIALOG_STYLE_LIST, "{FF0000}[ เงินแดง ]",
                "[+] ใส่เข้าไป\n\
                 [-] นำออกมา",
                "Select","Close");
	        }
		}
	}
	return 1;
}

