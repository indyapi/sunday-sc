                {
                    if (carData[vehicleid][carKnuckles] >= 5)
                        return SendClientMessage(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} ไอเท็มนี้ ท้ายรถเต็ม....(5)");

                    Dialog_Show(playerid, D_TKKnukles1, DIALOG_STYLE_INPUT, "{80FF00}[ สนับมือ ]", "จำนวนที่ต้องการใส่เข้าไป คือ","ใส่เข้าไป","ยกเลิก");
                }
