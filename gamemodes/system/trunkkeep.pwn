			}
		}
	}
	return 1;
}

Dialog:D_TKBasball1(playerid, response, listitem, inputtext[])
{
	new amount = strval(inputtext);
	new vehicleid = GetVehicleModel(GetPlayerVehicleID(playerid));
	new query[300];
	if(vehicleid != INVALID_VEHICLE_ID && IsVehicleOwner(playerid, vehicleid))
	{
        if (response)
        {
            new NameItem[64];
            NameItem = "ไม้เบส";
            if (amount <= 0)
                return SendClientMessage(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} 0 ตัวเดียวไม่มีค่า....");

            if (Inventory_Count(playerid, "ไม้เบส") < amount)
                return SendClientMessageEx(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} %s ไม่พอ....", NameItem);

            if(carData[vehicleid][carTrunkLv] == 1)
            {
                if (amount > 3)
                    return SendClientMessageEx(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} พื้นที่เก็บไอเท็ม....%s(3)", NameItem);
            }
            if(carData[vehicleid][carTrunkLv] == 2)
            {
                if (amount > 5)
                    return SendClientMessageEx(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} พื้นที่เก็บไอเท็ม....%s(5)", NameItem);
            }
            if(carData[vehicleid][carTrunkLv] == 3)
            {
                if (amount > 10)
                    return SendClientMessageEx(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} พื้นที่เก็บไอเท็ม....%s(10)", NameItem);
            }

            new NamePlayer[128];
            NamePlayer = GetPlayerNameEx(playerid);
            carData[vehicleid][carBasball] += amount;
            Inventory_Remove(playerid, "ไม้เบส", amount);

            new gString[256];
		    format(gString, sizeof(gString), "INSERT INTO trunklog (givePlayerID, givePlayerName, giveItem, giveAmount, carID) VALUES('%d', '%s', '[+] ไม้เบส', '%d', '%d')", playerData[playerid][pID], GetPlayerNameEx(playerid), amount, carData[vehicleid][carID]);
		    mysql_tquery(g_SQL, gString);

            mysql_format(g_SQL, query, sizeof(query), "UPDATE vehicles SET carBasball = %d WHERE carID = %d", carData[vehicleid][carBasball], carData[vehicleid][carID]);
            mysql_tquery(g_SQL, query);
    
            SendClientMessageEx(playerid, COLOR_LIGHTBLUE, "[TRUNK] : {FFFFFF}ฝาก %s จำนวน %d", NameItem, amount);
            printf("[TRUNK] : deposit 'Baseball' %d (By : %s)", amount, NamePlayer);
        }
        else
        {
            SendClientMessage(playerid, COLOR_RED, "[ ERROR! ] {FFFFFF}รถอยู่ไกลเกินไป....");
        }
	}
	return 1;
}

Dialog:D_TKBasball2(playerid, response, listitem, inputtext[])
{
	new amount = strval(inputtext);
	new vehicleid = GetVehicleModel(GetPlayerVehicleID(playerid));
	new query[300];
	if(vehicleid != INVALID_VEHICLE_ID && IsVehicleOwner(playerid, vehicleid))
	{
        if (response)
        {
            new NameItem[64];
            NameItem = "ไม้เบส";
            if (amount <= 0)
                return SendClientMessage(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} 0 ตัวเดียวไม่มีค่า....");

            if (carData[vehicleid][carBasball] < amount)
                return SendClientMessageEx(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} %s ในรถไม่พอ....", NameItem);

            new NamePlayer[128];
            NamePlayer = GetPlayerNameEx(playerid);
            carData[vehicleid][carBasball] -= amount;
            Inventory_Add(playerid, "ไม้เบส", amount);

            new gString[256];
		    format(gString, sizeof(gString), "INSERT INTO trunklog (givePlayerID, givePlayerName, giveItem, giveAmount, carID) VALUES('%d', '%s', '[-] ไม้เบส', '%d', '%d')", playerData[playerid][pID], GetPlayerNameEx(playerid), amount, carData[vehicleid][carID]);
		    mysql_tquery(g_SQL, gString);

            mysql_format(g_SQL, query, sizeof(query), "UPDATE vehicles SET carBasball = %d WHERE carID = %d", carData[vehicleid][carBasball], carData[vehicleid][carID]);
            mysql_tquery(g_SQL, query);

            SendClientMessageEx(playerid, COLOR_LIGHTBLUE, "[TRUNK] : {FFFFFF}ถอน %s จำนวน %d", NameItem, amount);
            printf("[TRUNK] : withdraw 'Baseball' %d (By : %s)", amount, NamePlayer);
        }
        else
        {
            SendClientMessage(playerid, COLOR_RED, "[ ERROR! ] {FFFFFF}รถอยู่ไกลเกินไป....");
        }
	}
	return 1;
}

