// ไม้แซ่
Dialog:D_TKWooden(playerid, response, listitem, inputtext[])//เงิน
{
	if (response)
	{
	    switch(listitem)
	    {
	        case 0:
	        {
                
                new vehicleid = GetVehicleModel(GetPlayerVehicleID(playerid));
                new NameItem[64];
                NameItem = "ไม้แซ่";
                    //if (carData[vehicleid][carWooden] >= 3)
                     //   return SendClientMessageEx(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} %s ท้ายรถเต็ม....(3)", NameItem);

				if(carData[vehicleid][carTrunkLv] == 1)
                {
                    if (carData[vehicleid][carWooden] >= 3)
                        return SendClientMessage(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} ไอเท็มนี้ ท้ายรถเต็ม....(3)");

                    Dialog_Show(playerid, D_TKWooden1, DIALOG_STYLE_INPUT, "{80FF00}[ %s ]", "จำนวนที่ต้องการใส่เข้าไป คือ","ใส่เข้าไป","ยกเลิก", NameItem);
                }
                if(carData[vehicleid][carTrunkLv] == 2)
                {
                    if (carData[vehicleid][carWooden] >= 5)
                        return SendClientMessage(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} ไอเท็มนี้ ท้ายรถเต็ม....(5)");

                    Dialog_Show(playerid, D_TKWooden1, DIALOG_STYLE_INPUT, "{80FF00}[ %s ]", "จำนวนที่ต้องการใส่เข้าไป คือ","ใส่เข้าไป","ยกเลิก", NameItem);
                }
                if(carData[vehicleid][carTrunkLv] == 3)
                {
                    if (carData[vehicleid][carWooden] >= 10)
                        return SendClientMessage(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} ไอเท็มนี้ ท้ายรถเต็ม....(10)");

                    Dialog_Show(playerid, D_TKWooden1, DIALOG_STYLE_INPUT, "{80FF00}[ %s ]", "จำนวนที่ต้องการใส่เข้าไป คือ","ใส่เข้าไป","ยกเลิก", NameItem);
                }
			}
			case 1:
			{
				Dialog_Show(playerid, D_TKWooden2, DIALOG_STYLE_INPUT, "{80FF00}[ ไม้แซ่ ]", "จำนวนที่ต้องการนำออกมา คือ","นำออกมา","ยกเลิก");
			}
		}
	}
	return 1;
}

Dialog:D_TKWooden1(playerid, response, listitem, inputtext[])
{
	new amount = strval(inputtext);
	new vehicleid = GetVehicleModel(GetPlayerVehicleID(playerid));
	new query[300];
	if(vehicleid != INVALID_VEHICLE_ID && IsVehicleOwner(playerid, vehicleid))
	{
        if (response)
        {
            new NameItem[64];
            NameItem = "ไม้แซ่";
            if (amount <= 0)
                return SendClientMessage(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} 0 ตัวเดียวไม่มีค่า....");

            if (Inventory_Count(playerid, "ไม้แซ่") < amount)
                return SendClientMessageEx(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} %s ไม่พอ....", NameItem);

            if(carData[vehicleid][carTrunkLv] == 1)
            {
                if (amount > 3)
                    return SendClientMessageEx(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} พื้นที่เก็บไอเท็ม....%s(3)", NameItem);
            }
            if(carData[vehicleid][carTrunkLv] == 2)
            {
                if (amount > 5)
                    return SendClientMessageEx(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} พื้นที่เก็บไอเท็ม....%s(5)", NameItem);
            }
            if(carData[vehicleid][carTrunkLv] == 3)
            {
                if (amount > 10)
                    return SendClientMessageEx(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} พื้นที่เก็บไอเท็ม....%s(10)", NameItem);
            }

            new NamePlayer[128];
            NamePlayer = GetPlayerNameEx(playerid);
            carData[vehicleid][carWooden] += amount;
            Inventory_Remove(playerid, "ไม้แซ่", amount);

            new gString[256];
		    format(gString, sizeof(gString), "INSERT INTO trunklog (givePlayerID, givePlayerName, giveItem, giveAmount, carID) VALUES('%d', '%s', '[+] ไม้แซ่', '%d', '%d')", playerData[playerid][pID], GetPlayerNameEx(playerid), amount, carData[vehicleid][carID]);
		    mysql_tquery(g_SQL, gString);

            mysql_format(g_SQL, query, sizeof(query), "UPDATE vehicles SET carWooden = %d WHERE carID = %d", carData[vehicleid][carWooden], carData[vehicleid][carID]);
            mysql_tquery(g_SQL, query);
    
            SendClientMessageEx(playerid, COLOR_LIGHTBLUE, "[TRUNK] : {FFFFFF}ฝาก %s จำนวน %d", NameItem, amount);
            printf("[TRUNK] : deposit 'Wooden Mai Chair' %d (By : %s)", amount, NamePlayer);
        }
        else
        {
            SendClientMessage(playerid, COLOR_RED, "[ ERROR! ] {FFFFFF}รถอยู่ไกลเกินไป....");
        }
	}
	return 1;
}

