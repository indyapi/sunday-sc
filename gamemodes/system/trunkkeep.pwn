                {
                    if (carData[vehicleid][carBasball] >= 10)
                        return SendClientMessage(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} ไอเท็มนี้ ท้ายรถเต็ม....(10)");

                    Dialog_Show(playerid, D_TKBasball1, DIALOG_STYLE_INPUT, "{80FF00}[ %s ]", "จำนวนที่ต้องการใส่เข้าไป คือ","ใส่เข้าไป","ยกเลิก", NameItem);
                }
