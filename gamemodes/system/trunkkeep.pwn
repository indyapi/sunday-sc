Dialog:D_TKkrapong1(playerid, response, listitem, inputtext[])
{
	new amount = strval(inputtext);
	new vehicleid = GetVehicleModel(GetPlayerVehicleID(playerid));
	new query[300];
	if(vehicleid != INVALID_VEHICLE_ID && IsVehicleOwner(playerid, vehicleid))
	{
        if (response)
        {
            new NameItem[64];
            NameItem = "ปลากระพง";
            if (amount <= 0)
                return SendClientMessage(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} 0 ตัวเดียวไม่มีค่า....");

            if (Inventory_Count(playerid, "ปลากระพง") < amount)
                return SendClientMessageEx(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} %s ไม่พอ....", NameItem);

            if(carData[vehicleid][carTrunkLv] == 1)
            {
                if (amount > 50)
                    return SendClientMessageEx(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} พื้นที่เก็บไอเท็ม....%s(50)", NameItem);
            }
            if(carData[vehicleid][carTrunkLv] == 2)
            {
                if (amount > 100)
                    return SendClientMessageEx(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} พื้นที่เก็บไอเท็ม....%s(100)", NameItem);
            }
            if(carData[vehicleid][carTrunkLv] == 3)
            {
                if (amount > 300)
                    return SendClientMessageEx(playerid, COLOR_LIGHTRED, "[ERROR!]{FFFFFF} พื้นที่เก็บไอเท็ม....%s(300)", NameItem);
            }

            new NamePlayer[128];
            NamePlayer = GetPlayerNameEx(playerid);
            carData[vehicleid][carFishKrapong] += amount;
            Inventory_Remove(playerid, "ปลากระพง", amount);

            new gString[256];
		    format(gString, sizeof(gString), "INSERT INTO trunklog (givePlayerID, givePlayerName, giveItem, giveAmount, carID) VALUES('%d', '%s', '[+] ปลากระพง', '%d', '%d')", playerData[playerid][pID], GetPlayerNameEx(playerid), amount, carData[vehicleid][carID]);
		    mysql_tquery(g_SQL, gString);

            mysql_format(g_SQL, query, sizeof(query), "UPDATE vehicles SET carFishKrapong = %d WHERE carID = %d", carData[vehicleid][carFishKrapong], carData[vehicleid][carID]);
            mysql_tquery(g_SQL, query);
    
            SendClientMessageEx(playerid, COLOR_LIGHTBLUE, "[TRUNK] : {FFFFFF}ฝาก %s จำนวน %d", NameItem, amount);
            printf("[TRUNK] : deposit 'Knife' %d (By : %s)", amount, NamePlayer);
        }
        else
        {
            SendClientMessage(playerid, COLOR_RED, "[ ERROR! ] {FFFFFF}รถอยู่ไกลเกินไป....");
        }
	}
	return 1;
}

